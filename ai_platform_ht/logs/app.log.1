n        "type": "varchar(160)",\n        "remark": "商机名称，一般含客户+项目名"\n      },\n      "customer_id": {\n        "columnComment": "所属客户ID -> crm_customer.id",\n        "type": "bigint(20) unsigned",\n        "remark": "所属客户ID -> crm_customer.id"\n      },\n      "source_lead_id": {\n        "columnComment": "来源线索ID -> crm_lead.id（线索直接转商机时回填）",\n        "type": "bigint(20) unsigned",\n        "remark": "来源线索ID -> crm_lead.id（线索直接转商机时回填）"\n      },\n      "stage": {\n        "columnComment": "商机阶段：1-初步接洽 2-需求确认 3-方案报价 4-商务谈判 5-赢单 6-输单",\n        "type": "tinyint(3) unsigned",\n        "remark": "商机阶段：1-初步接洽 2-需求确认 3-方案报价 4-商务谈判 5-赢单 6-输单"\n      },\n      "win_rate": {\n        "columnComment": "预计赢率（百分比 0-100）",\n        "type": "tinyint(3) unsigned",\n        "remark": "预计赢率（百分比 0-100）"\n      },\n      "expect_amount": {\n        "columnComment": "预计成交金额（元）",\n        "type": "decimal(14,2)",\n        "remark": "预计成交金额（元）"\n      },\n      "currency": {\n        "columnComment": "币种，ISO 4217",\n        "type": "char(3)",\n        "remark": "币种，ISO 4217"\n      },\n      "expect_close_date": {\n        "columnComment": "预计签约日期",\n        "type": "date",\n        "remark": "预计签约日期"\n      },\n      "owner_employee_code": {\n        "columnComment": "商机负责人编码，逻辑外键 -> nova_erp.erp_employee.employee_code",\n        "type": "varchar(32)",\n        "remark": "商机负责人编码，逻辑外键 -> nova_erp.erp_employee.employee_code"\n      },\n      "competitor": {\n        "columnComment": "主要竞争对手",\n        "type": "varchar(64)",\n        "remark": "主要竞争对手"\n      },\n      "lost_reason": {\n        "columnComment": "输单原因（stage=6 时填写）",\n        "type": "varchar(128)",\n        "remark": "输单原因（stage=6 时填写）"\n      },\n      "created_at": {\n        "columnComment": "创建时间",\n        "type": "datetime",\n        "remark": "创建时间"\n      },\n      "updated_at": {\n        "columnComment": "更新时间",\n        "type": "datetime",\n        "remark": "更新时间"\n      },\n      "is_deleted": {\n        "colu