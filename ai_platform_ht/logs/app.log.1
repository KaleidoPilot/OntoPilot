 = so.contract_no AND so.is_deleted = 0\n    WHERE c.status IN (3, 4) \n      AND c.is_deleted = 0\n    """\n    cursor.execute(sql_contracts_orders)\n    rows = cursor.fetchall()\n    cols = [desc[0] for desc in cursor.description]\n    df_base = pd.DataFrame(rows, columns=cols)\n    \n    if df_base.empty:\n        print("No effective contracts found.")\n    else:\n        # Step 2: Calculate Cost for each Sales Order Item based on BOM Standard Cost\n        # We need to join erp_sales_order_item -> erp_product -> erp_material -> erp_bom -> erp_bom_item -> erp_material (component)\n        # The logic: For a sold product (finished good), find its BOM. Sum up the cost of components (qty_per * component_standard_cost).\n        # Note: This is a simplified "theoretical" cost calculation using standard costs from material master.\n        \n        sql_costs = """\n         \n            soi.order_id,\n            soi.product_id,\n            soi.quantity,\n            soi.unit_price,\n            soi.amount AS line_amount,\n            m.standard_cost AS product_std_cost,\n            bom.material_id AS bom_parent_id,\n            SUM(bi.qty_per * cm.standard_cost) AS calculated_bom_unit_cost\n        FROM nova_erp.erp_sales_order_item soi\n        JOIN nova_erp.erp_product p ON soi.product_id = p.id\n        JOIN nova_erp.erp_material m ON p.id = m.product_id AND m.is_deleted = 0\n        LEFT JOIN nova_erp.erp_bom bom ON m.id = bom.material_id AND bom.status = 2 AND bom.bom_type = 1\n        LEFT JOIN nova_erp.erp_bom_item bi ON bom.id = bi.bom_id\n        LEFT JOIN nova_erp.erp_material cm ON bi.component_material_id = cm.id AND cm.is_deleted = 0\n        GROUP BY \n            soi.order_id,\n            soi.product_id,\n            soi.quantity,\n            soi.unit_price,\n            soi.amount,\n            m.standard_cost,\n            bom.material_id,\n            bom.id\n        """\n        cursor.execute(sql_costs)\n        cost_rows = cursor.fetchall()\n        cost_cols = [desc[0] for desc in cursor.description]\n        df_costs = pd.DataFrame(cost_rows, columns=cost_cols)\n        \n        # Merge base data with cost data\n        # df_base has sales_order_id. df_costs has order_id.\n        # We need to aggregate costs by order_id first to get total cost per order? \n        # Actually, gross margin is usually calculated at line level or order level.\n        # Let\'s calculate at Line Level first, then sum up to Order, then Contract.\n        \n        # Re-fetching line items with contract info directly might be cleaner but we already have df_base.\n        # Let\'s create a mapping of sales_order_id to contract/customer info from df_base\n        # But df_base is at Contract-Order level. One order belongs to one contract.\n        \n        # Let\'s build a comprehensive dataframe starting from Sales Order Items linked to Contracts\n        \n        sql_full_analysis = """\n         \n            c.contract_no,\n            c.contract_name,\n            cu.customer_code,\n            cu.customer_name,\n            cu.industry,\n            cu.customer_level,\n            so.order_no,\n            so.id AS sales_order_id,\n            soi.line_no,\n            soi.product_id,\n            p.product_name,\n            soi.quantity,\n            soi.unit_price,\n            soi.amount AS sales_amount_excl_tax,\n            COALESCE(m.standard_cost, 0) AS product_standard_cost,\n            COALESCE(bom_agg.calc_unit_cost, 0) AS bom_calc_unit_cost\n        FROM nova_crm.crm_contract c\n        JOIN nova_crm.crm_customer cu ON c.customer_id = cu.id AND cu.is_deleted = 0\n        JOIN nova_erp.erp_sales_order so ON c.contract_no = so.contract_no AND so.is_deleted = 0\n        JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n        JOIN nova_erp.erp_product p ON soi.product_id = p.id\n        LEFT JOIN nova_erp.erp_material m ON p.id = m.product_id AND m.is_deleted = 0\n        LEFT JOIN (\n             \n                bom.material_id,\n                SUM(bi.qty_per * cm.standard_cost) AS calc_unit_cost\n            FROM nova_erp.erp_bom bom\n            JOIN nova_erp.erp_bom_item bi ON bom.id = bi.bom_id\n            JOIN nova_erp.erp_material cm ON bi.component_material_id = cm.id AND cm.is_deleted = 0\n            WHERE bom.status = 2 \n              AND bom.bom_type = 1 \n            GROUP BY bom.material_id\n        ) bom_agg ON m.id = bom_agg.material_id\n        WHERE c.status IN (3, 4) \n          AND c.is_deleted = 0\n        """\n        cursor.execute(sql_full_analysis)\n        full_rows = cursor.fetchall()\n        full_cols = [desc[0] for desc in cursor.description]\n        df_full = pd.DataFrame(full_rows, columns=full_cols)\n        \n        if df_full.empty:\n            print("No detailed sales order items found for effective contracts.")\n        else:\n            # Determine Unit Cost: Prefer BOM calculated cost if available and > 0, otherwise use Product Standard Cost\n            # If both are 0/None, cost is 0.\n            df_full[\'unit_cost\'] = df_full.apply(\n                lambda row: row[\'bom_calc_unit_cost\'] if row[\'bom_calc_unit_cost\'] and row[\'bom_calc_unit_cost\'] > 0 else row[\'product_standard_cost\'], \n                axis=1\n            )\n            \n            # Fill NaN with 0\n            df_full[\'unit_cost\'] = df_full[\'unit_cost\'].fillna(0)\n            \n            # Calculate Total Cost per Line\n            df_full[\'total_cost\'] = df_full[\'quantity\'] * df_full[\'unit_cost\']\n            \n            # Calculate Gross Profit per Line\n            df_full[\'gross_profit\'] = df_full[\'sales_amount_excl_tax\'] - df_full[\'total_cost\']\n            \n            # Aggregate to Contract Level\n            df_contract = df_full.groupby([\n                \'contract_no\', \n                \'contract_name\', \n                \'customer_code\', \n                \'customer_name\', \n                \'industry\', \n                \'customer_level\'\n            ]).agg(\n                total_sales=(\'sales_amount_excl_tax\', \'sum\'),\n                total_cost=(\'total_cost\', \'sum\'),\n                gross_profit=(\'gross_profit\', \'sum\'),\n                order_count=(\'order_no\', \'nunique\')\n            ).reset_index()\n            \n            # Calculate Margin Rate\n            df_contract[\'margin_rate\'] = df_contract.apply(\n                lambda row: (row[\'gross_profit\'] / row[\'total_sales\'] * 100) if row[\'total_sales\'] != 0 else 0, \n                axis=1\n            )\n            \n            # Aggregate to Customer Level\n            df_customer = df_contract.groupby([\n                \'customer_code\', \n                \'customer_name\', \n                \'industry\', \n                \'customer_level\'\n            ]).agg(\n                contract_count=(\'contract_no\', \'count\'),\n                total_sales=(\'total_sales\', \'sum\'),\n                total_cost=(\'total_cost\', \'sum\'),\n                total_gross_profit=(\'gross_profit\', \'sum\')\n            ).reset_index()\n            \n            df_customer[\'avg_margin_rate\'] = df_customer.apply(\n                lambda row: (row[\'total_gross_profit\'] / row[\'total_sales\'] * 100) if row[\'total_sales\'] != 0 else 0, \n                axis=1\n            )\n            \n            # Output Results\n            print("--- Customer Level Analysis ---")\n            print(df_customer.to_string(index=False))\n            \n            print("\\n--- Contract Level Analysis ---")\n            print(df_contract.to_string(index=False))\n            \nexcept Exception as e:\n    print(f"Error during execution: {str(e)}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\nError during execution: \'NoneType\' object has no attribute \'cursor\'\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
