       req_qty_map = {\n            found_products[0][\'id\']: 10,\n            found_products[1][\'id\']: 10,\n            found_products[2][\'id\']: 10\n        }\n        \n        final_prices = {}\n        for p in found_products:\n            pid = p[\'id\']\n            price = p[\'sale_price\']\n            \n            hist_for_prod = [h for h in historical_orders if h[1] == pid] # h[1] is product_id\n            if hist_for_prod:\n                last_order = hist_for_prod[0]\n                # last_order tuple: (order_no, product_id, quantity, unit_price, amount)\n                price = float(last_order[3]) # unit_price\n                print(f"产品 {p[\'product_name\']} 使用历史订单价格: {price}")\n            else:\n                print(f"产品 {p[\'product_name\']} 无历史订单，使用标准售价: {price}")\n                \n            final_prices[pid] = price\n            \n        for p in found_products:\n            pid = p[\'id\']\n            qty = req_qty_map.get(pid, 0)\n            price = final_prices.get(pid, 0)\n            amount = qty * price\n            total_sales_amount += amount\n            order_details.append({\n                "product_name": p[\'product_name\'],\n                "quantity": qty,\n                "unit_price": price,\n                "total_amount": amount\n            })\n            \n        print("\\n--- 合同销售明细 ---")\n        print(f"{\'产品名称\':<20} {\'数量\':<10} {\'单价\':<15} {\'总金额\':<15}")\n        for d in order_details:\n            print(f"{d[\'product_name\']:<20} {d[\'quantity\']:<10} {d[\'unit_price\']:<15.2f} {d[\'total_amount\']:<15.2f}")\n        print(f"{\'合计\':<20} {\'\':<10} {\'\':<15} {total_sales_amount:<15.2f}")\n        \n        handoff_data = {\n            "customer_id": int(customer_id),\n            "customer_code": str(customer_code),\n            "product_ids": [int(p[\'id\']) for p in found_products],\n            "quantities": [int(req_qty_map[p[\'id\']]) for p in found_products],\n            "sales_total": float(total_sales_amount)\n        }\n        \n        print(\'__HANDOFF__\' + json.dumps(handoff_data))\n        \n        return handoff_data\n\n    except Exception as e:\n        print(f"Error: {e}")\n        import traceback\n        traceback.print_exc()\n        return {}\n    finally:\n        if conn:\n            try:\n                conn.rollback()\n                conn.close()\n            except:\n                pass\n\nget_data()\n```\n**执行结果**:\n```text\n找到客户: 海纳动力系统股份有限公司 (ID: 6, Code: CUS0006)\n匹配到产品: 激光测距仪 激光-598 (Code: SKU0002, Sale Price: 47170.0)\n匹配到产品: PU气动软管 PU-671 (Code: SKU0004, Sale Price: 459.0)\n匹配到产品: 码垛机器人 码垛-418 (Code: SKU0016, Sale Price: 282401.0)\n产品 激光测距仪 激光-598 无历史订单，使用标准售价: 47170.0\n产品 PU气动软管 PU-671 无历史订单，使用标准售价: 459.0\n产品 码垛机器人 码垛-418 无历史订单，使用标准售价: 282401.0\n\n--- 合同销售明细 ---\n产品名称                 数量         单价              总金额            \n激光测距仪 激光-598         10         47170.00        471700.00      \nPU气动软管 PU-671        10         459.00          4590.00        \n码垛机器人 码垛-418         10         282401.00       2824010.00     \n合计                                              3300300.00     \n```\n\n### 步骤 2: 步骤2：根据销售订单中的商品ID关联物料主数据及BOM结构，基于BOM表递归或展开计算各产品的材料标准成本，汇总得出总产品成本\n**执行代码**:\n```python\nimport json\n\nconn = get_connection()\nif conn is None:\n    raise Exception("数据库连接不可用")\n\ntry:\n    cursor = conn.cursor()\n    \n    handoff_data = _HANDOFF_68a56c2189\n    product_ids = handoff_data[\'product_ids\']\n    quantities = handoff_data[\'quantities\']\n    \n    if not product_ids or len(product_ids) != len(quantities):\n        raise ValueError("衔接参数中产品ID或数量列表无效")\n\n    placeholders = \',\'.join([\'%s\'] * len(product_ids))\n    \n    sql_material = f"""\n        SELECT \n            id,\n            material_code,\n            material_name,\n            standard_cost,\n            source_type,\n            product_id\n        FROM nova_erp.erp_material\n        WHERE product_id IN ({placeholders})\n          AND is_deleted = 0\n    """\n    \n    cursor.execute(sql_material, product_ids)\n    materials = cursor.fetchall()\n    \n    material_map = {}\n    for row in materials:\n        pid = row[4]\n        material_map[pid] = {\n            \'material_id\': row[0],\n            \'material_code\': row[1],\n            \'material_name\': row[2],\n            \'standard_cost\': float(row[3]) if row[3] else 0.0,\n            \'source_type\': row[5],\n            \'bom_cost\': 0.0\n        }\n\n    bom_material_ids = [m[\'material_id\'] for m in material_map.values() if m[\'source_type\'] == 1]\n    \n    if bom_material_ids:\n        bom_placeholders = \',\'.join([\'%s\'] * len(bom_material_ids))\n        \n        sql_bom_head = f"""\n            SELECT \n                b.id as bom_id,\n                b.material_id,\n                b.base_qty,\n                b.yield_rate\n            FROM nova_erp.erp_bom b\n            WHERE b.material_id IN ({bom_placeholders})\n              AND b.status = 2\n        """\n        \n        cursor.execute(sql_bom_head, bom_material_ids)\n        bom_heads = cursor.fetchall()\n        \n        bom_head_map = {}\n        for bh in bom_heads:\n            mid = bh[1]\n            if mid not in bom_head_map:\n                bom_head_map[mid] = []\n            bom_head_map[mid].append({\n                \'bom_id\': bh[0],\n                \'base_qty\': float(bh[2]) if bh[2] else 1.0,\n                \'yield_rate\': float(bh[3]) if bh[3] else 100.0\n            })\n        \n        all_bom_ids = [bh[\'bom_id\'] for items in bom_head_map.values() for bh in items]\n        \n        if all_bom_ids:\n            bom_id_placeholders = \',\'.join([\'%s\'] * len(all_bom_ids))\n            \n            sql_bom_items = f"""\n                SELECT \n                    bi.bom_id,\n                    bi.component_material_id,\n                    bi.qty_per,\n                    bi.loss_rate\n                FROM nova_erp.erp_bom_item bi\n                WHERE bi.bom_id IN ({bom_id_placeholders})\n            """\n            \n            cursor.execute(sql_bom_items, all_bom_ids)\n            bom_items_raw = cursor.fetchall()\n            \n            bom_items_map = {}\n            for item in bom_items_raw:\n                bid = item[0]\n                if bid not in bom_items_map:\n                    bom_items_map[bid] = []\n                bom_items_map[bid].append({\n                    \'component_material_id\': item[1],\n                    \'qty_per\': float(item[2]) if item[2] else 0.0,\n                    \'loss_rate\': float(item[3]) if item[3] else 0.0\n                })\n            \n            component_ids = list(set([item[\'component_material_id\'] for items in bom_items_map.values() for item in items]))\n            \n            if component_ids:\n                comp_placeholders = \',\'.join([\'%s\'] * len(component_ids))\n                sql_comp_costs = f"""\n                    SELECT \n                        id,\n                        standard_cost,\n                        source_type\n                    FROM nova_erp.erp_material\n                    WHERE id IN ({comp_placeholders})\n                      AND is_deleted = 0\n                """\n                \n                cursor.execute(sql_comp_costs, component_ids)\n                comp_costs = cursor.fetchall()\n                \n                comp_cost_map = {}\n                for cc in comp_costs:\n                    comp_cost_map[cc[0]] = {\n                        \'standard_cost\': float(cc[1]) if cc[1] else 0.0,\n                        \'source_type\': cc[2]\n                    }\n                \n                def calculate_bom_cost(material_id, visited=None):\n                    if visited is None:\n                        visited = set()\n                    \n                    if material_id in visited:\n                        return 0.0\n                    \n                    visited.add(material_id)\n                    \n                    if material_id not in bom_head_map:\n                        cost_info = comp_cost_map.get(material_id)\n                        if cost_info:\n                            return cost_info[\'standard_cost\']\n                        return 0.0\n                    \n                    total_cost = 0.0\n                    for bom_head in bom_head_map[material_id]:\n                        bom_id = bom_head[\'bom_id\']\n                        base_qty = bom_head[\'base_qty\']\n                        yield_rate = bom_head[\'yield_rate\'] / 100.0\n                        \n                        if base_qty <= 0:\n                            continue\n                            \n                        items = bom_items_map.get(bom_id, [])\n                        for item in items:\n                            comp_mid = item[\'component_material_id\']\n                            qty_per = item[\'qty_per\']\n                            loss_rate = item[\'loss_rate\'] / 100.0\n                            \n                            effective_qty = (qty_per / base_qty) * (1 + loss_rate)\n                            \n                            comp_unit_cost = calculate_bom_cost(comp_mid, visited.copy())\n                            \n                            line_cost = effective_qty * comp_unit_cost\n                            total_cost += line_cost\n                        \n                        if yield_rate > 0 and yield_rate < 1:\n                            total_cost = total_cost / yield_rate\n                    \n                    return total_cost\n                \n                for pid, mat_info in material_map.items():\n                    if mat_info[\'source_type\'] == 1:\n                        mid = mat_info[\'material_id\']\n                        calculated_cost = calculate_bom_cost(mid)\n                        mat_info[\'bom_cost\'] = calculated_cost\n                    else:\n                        mat_info[\'bom_cost\'] = mat_info[\'standard_cost\']\n\n    results = []\n    total_product_cost = 0.0\n    \n    for i, pid in enumerate(product_ids):\n        qty = quantities[i]\n        mat_info = material_map.get(pid)\n        \n        if mat_info:\n            unit_cost = mat_info[\'bom_cost\']\n            line_total_cost = unit_cost * qty\n            total_product_cost += line_total_cost\n            \n            results.append({\n                \'product_id\': pid,\n                \'material_code\': mat_info[\'material_code\'],\n                \'material_name\': mat_info[\'material_name\'],\n                \'quantity\': qty,\n                \'unit_standard_cost\': round(mat_info[\'standard_cost\'], 4),\n                \'unit_bom_cost\': round(unit_cost, 4),\n                \'line_total_cost\': round(line_total_cost, 2)\n            })\n        else:\n            results.append({\n                \'product_id\': pid,\n                \'material_code\': \'N/A\',\n                \'material_name\': \'未找到对应物料\',\n                \'quantity\': qty,\n                \'unit_standard_cost\': 0.0,\n                \'unit_bom_cost\': 0.0,\n                \'line_total_cost\': 0.0\n            })\n\n    print(f"{\'Product ID\':<10} | {\'Material Code\':<15} | {\'Material Name\':<20} | {\'Qty\':<5} | {\'Unit Std Cost\':<15} | {\'Unit BOM Cost\':<15} | {\'Line Total Cost\':<15}")\n    print("-" * 110)\n    for r in results:\n        print(f"{r[\'product_id\']:<10} | {r[\'material_code\']:<15} | {r[\'material_name\']:<20} | {r[\'quantity\']:<5} | {r[\'unit_standard_cost\']:<15.4f} | {r[\'unit_bom_cost\']:<15.4f} | {r[\'line_total_cost\']:<15.2f}")\n    \n    print("-" * 110)\n    print(f"Total Product Cost: {total_product_cost:.2f}")\n\nfinally:\n    if conn:\n        conn.rollback()\n        conn.close()\n```\n**执行结果**:\n```text\nProduct ID | Material Code   | Material Name        | Qty   | Unit Std Cost   | Unit BOM Cost   | Line Total Cost\n--------------------------------------------------------------------------------------------------------------\n2          | FG0004          | PU气动软管 PU-671        | 10    | 244.2600        | 0.0000          | 0.00           \n4          | N/A             | 未找到对应物料              | 10    | 0.0000          | 0.0000          | 0.00           \n16         | N/A             | 未找到对应物料              | 10    | 0.0000          | 0.0000          | 0.00           \n--------------------------------------------------------------------------------------------------------------\nTotal Product Cost: 0.00\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
