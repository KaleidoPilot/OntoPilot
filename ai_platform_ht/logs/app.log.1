          {\'code\': \'激光-215\', \'qty\': 10},\n            {\'code\': \'PU-804\', \'qty\': 10},\n            {\'code\': \'码垛-418\', \'qty\': 10}\n        ]\n        \n        results = []\n        \n        for item in req_items:\n            p_code = item[\'code\']\n            qty = item[\'qty\']\n            \n            # 1. Get Product Info (Sale Price, Tax Rate) and linked Material ID\n            sql_product = """\n                SELECT id, product_name, sale_price, tax_rate \n                FROM nova_erp.erp_product \n                WHERE product_code = %s AND is_deleted = 0\n            """\n            cursor.execute(sql_product, (p_code,))\n            prod_row = cursor.fetchone()\n            \n            if not prod_row:\n                continue\n                \n            prod_id, prod_name, sale_price, tax_rate = prod_row\n            \n            # Convert Decimal to float for calculation\n            sale_price = float(sale_price) if sale_price else 0.0\n            tax_rate = float(tax_rate) if tax_rate else 0.0\n            \n            # 2. Get Material Info (Standard Cost, Source Type)\n            # Link: erp_material.product_id -> erp_product.id\n            sql_material = """\n                SELECT m.id, m.material_name, m.standard_cost, m.source_type\n                FROM nova_erp.erp_material m\n                WHERE m.product_id = %s AND m.is_deleted = 0\n            """\n            cursor.execute(sql_material, (prod_id,))\n            mat_row = cursor.fetchone()\n            \n            unit_cost = 0.0\n            source_type = None\n            \n            if mat_row:\n                mat_id, mat_name, standard_cost, source_type = mat_row\n                standard_cost = float(standard_cost) if standard_cost else 0.0\n                \n                # If self-made (source_type=1), calculate BOM cost recursively\n                if source_type == 1:\n                    total_bom_cost = calculate_bom_cost(cursor, mat_id)\n                    unit_cost = total_bom_cost\n                else:\n                    # Purchase or Outsourced, use standard cost directly\n                    unit_cost = standard_cost\n            else:\n                # Fallback if no material found, though unlikely for finished goods\n                unit_cost = 0.0\n\n            # Calculate Totals\n            # Sales Amount (Excl Tax) = Qty * Sale Price\n            sales_amount_excl_tax = qty * sale_price\n            # Tax Amount = Sales Amount * Tax Rate / 100\n            tax_amount = sales_amount_excl_tax * (tax_rate / 100.0)\n            # Total Sales Price (Incl Tax)\n            total_sales_price_incl_tax = sales_amount_excl_tax + tax_amount\n            \n            # Total Cost\n            total_cost = qty * unit_cost\n            \n            # Gross Profit & Margin\n            gross_profit = sales_amount_excl_tax - total_cost\n            gross_margin_pct = (gross_profit / sales_amount_excl_tax * 100) if sales_amount_excl_tax != 0 else 0\n            \n            results.append({\n                \'Product Code\': p_code,\n                \'Product Name\': prod_name,\n                \'Quantity\': qty,\n                \'Unit Sale Price\': round(sale_price, 2),\n                \'Tax Rate (%)\': round(tax_rate, 2),\n                \'Total Sales (Excl Tax)\': round(sales_amount_excl_tax, 2),\n                \'Total Tax\': round(tax_amount, 2),\n                \'Total Contract Price (Incl Tax)\': round(total_sales_price_incl_tax, 2),\n                \'Unit Cost\': round(unit_cost, 2),\n                \'Total Cost\': round(total_cost, 2),\n                \'Gross Profit\': round(gross_profit, 2),\n                \'Gross Margin (%)\': round(gross_margin_pct, 2)\n            })\n            \n        cursor.close()\n        return results\n\n    finally:\n        if conn:\n            conn.rollback()\n            conn.close()\n\ndef calculate_bom_cost(cursor, parent_material_id):\n    """\n    Recursively calculates the material cost of a BOM.\n    Rule: Cost comes from erp_material.standard_cost for leaf nodes or purchased items.\n    For self-made items, we sum up children costs.\n    """\n    # Find active BOM for this material\n    # Status 2 means Published\n    sql_bom = """\n        SELECT id, base_qty, yield_rate \n        FROM nova_erp.erp_bom \n        WHERE material_id = %s AND status = 2\n        ORDER BY effective_date DESC LIMIT 1\n    """\n    cursor.execute(sql_bom, (parent_material_id,))\n    bom_row = cursor.fetchone()\n    \n    if not bom_row:\n        # No BOM found, fallback to standard cost of the material itself\n        sql_mat = "SELECT standard_cost FROM nova_erp.erp_material WHERE id = %s"\n        cursor.execute(sql_mat, (parent_material_id,))\n        res = cursor.fetchone()\n        return float(res[0]) if res and res[0] else 0.0\n    \n    bom_id, base_qty, yield_rate = bom_row\n    base_qty = float(base_qty) if base_qty else 1.0\n    yield_rate = float(yield_rate) if yield_rate else 100.0\n    \n    # Get BOM Items\n    sql_items = """\n        SELECT component_material_id, qty_per, loss_rate\n        FROM nova_erp.erp_bom_item\n        WHERE bom_id = %s\n    """\n    cursor.execute(sql_items, (bom_id,))\n    items = cursor.fetchall()\n    \n    total_child_cost = 0.0\n    \n    for comp_mat_id, qty_per, loss_rate in items:\n        qty_per = float(qty_per) if qty_per else 0.0\n        loss_rate = float(loss_rate) if loss_rate else 0.0\n        \n        # Effective quantity needed per unit of parent output\n        # Formula: (qty_per / base_qty) * (1 + loss_rate/100) / (yield_rate/100)\n        # Wait, standard BOM logic:\n        # Demand = Plan_Qty * Qty_Per * (1+Loss) / Yield\n        # Here we are calculating cost per 1 unit of Parent.\n        # So Plan_Qty = 1.\n        # Unit_Demand = (qty_per / base_qty) * (1 + loss_rate/100) / (yield_rate/100)\n        \n        if base_qty == 0:\n            continue\n            \n        unit_demand = (qty_per / base_qty) * (1 + loss_rate/100) / (yield_rate/100)\n        \n        # Check child material type\n        sql_child_mat = """\n            SELECT standard_cost, source_type \n            FROM nova_erp.erp_material \n            WHERE id = %s AND is_deleted = 0\n        """\n        cursor.execute(sql_child_mat, (comp_mat_id,))\n        child_res = cursor.fetchone()\n        \n        if not child_res:\n            continue\n            \n        child_std_cost, child_source_type = child_res\n        child_std_cost = float(child_std_cost) if child_std_cost else 0.0\n        \n        if child_source_type == 1: # Self-made\n            # Recursive call\n            child_unit_cost = calculate_bom_cost(cursor, comp_mat_id)\n        else:\n            # Purchased or Outsourced\n            child_unit_cost = child_std_cost\n            \n        total_child_cost += unit_demand * child_unit_cost\n        \n    return total_child_cost\n\n# Execute and Print\ndata = get_data()\n\nif data:\n    print(f"{\'Product Code\':<15} | {\'Product Name\':<20} | {\'Qty\':>5} | {\'Unit Sale\':>10} | {\'Tax%\':>6} | {\'Sales Excl\':>12} | {\'Tax Amt\':>10} | {\'Contract Incl\':>13} | {\'Unit Cost\':>10} | {\'Total Cost\':>10} | {\'Profit\':>10} | {\'Margin%\':>8}")\n    print("-" * 140)\n    for row in data:\n        print(f"{row[\'Product Code\']:<15} | {row[\'Product Name\']:<20} | {row[\'Quantity\']:>5} | {row[\'Unit Sale Price\']:>10.2f} | {row[\'Tax Rate (%)\']:>6.2f} | {row[\'Total Sales (Excl Tax)\']:>12.2f} | {row[\'Total Tax\']:>10.2f} | {row[\'Total Contract Price (Incl Tax)\']:>13.2f} | {row[\'Unit Cost\']:>10.2f} | {row[\'Total Cost\']:>10.2f} | {row[\'Gross Profit\']:>10.2f} | {row[\'Gross Margin (%)\']:>8.2f}")\nelse:\n    print("No matching products found.")\n```\n**执行结果**:\n```text\nNo matching products found.\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行