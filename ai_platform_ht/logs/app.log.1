ursor.description]\n        df_sales = pd.DataFrame(sales_rows, columns=sales_cols)\n        \n        if df_sales.empty:\n            print("未查询到销售明细数据")\n        else:\n            df_merged = pd.merge(\n                df_sales, \n                df_costs[[\'order_id\', \'line_no\', \'total_cost\']], \n                on=[\'order_id\', \'line_no\'], \n                how=\'left\'\n            )\n            \n            df_merged[\'gross_profit\'] = df_merged[\'sale_amount\'] - df_merged[\'total_cost\']\n            df_merged[\'gross_margin_rate\'] = (df_merged[\'gross_profit\'] / df_merged[\'sale_amount\']) * 100\n            \n            contract_agg = df_merged.groupby([\'contract_no\', \'customer_code\', \'customer_name\']).agg(\n                total_sale_amount=(\'sale_amount\', \'sum\'),\n                total_cost=(\'total_cost\', \'sum\'),\n                total_gross_profit=(\'gross_profit\', \'sum\'),\n                avg_gross_margin_rate=(\'gross_margin_rate\', \'mean\')\n            ).reset_index()\n            \n            contract_agg[\'avg_gross_margin_rate\'] = (contract_agg[\'total_gross_profit\'] / contract_agg[\'total_sale_amount\']) * 100\n            \n            customer_agg = df_merged.groupby([\'customer_code\', \'customer_name\']).agg(\n                total_sale_amount=(\'sale_amount\', \'sum\'),\n                total_cost=(\'total_cost\', \'sum\'),\n                total_gross_profit=(\'gross_profit\', \'sum\'),\n                contract_count=(\'contract_no\', \'nunique\')\n            ).reset_index()\n            \n            customer_agg[\'avg_gross_margin_rate\'] = (customer_agg[\'total_gross_profit\'] / customer_agg[\'total_sale_amount\']) * 100\n            \n            print("="*80)\n            print("【客户合同销售毛利率全方位分析报告】")\n            print("="*80)\n            \n            print("\\n>>> 一、按合同维度分析明细 <<<")\n            print("-"*80)\n            print(f"{\'合同编号\':<16} {\'客户编码\':<12} {\'客户名称\':<20} {\'销售额(元)\':>14} {\'成本