mnComment": "逻辑删除：0-正常 1-已删除",\n        "type": "tinyint(3) unsigned",\n        "remark": "逻辑删除：0-正常 1-已删除"\n      }\n    }\n  },\n  {\n    "tableId": 122,\n    "tableName": "nova_crm.crm_opportunity_item",\n    "tableCnName": "商机报价明细，通过 product_code 关联 ERP 商品",\n    "tableComment": "商机报价明细，通过 product_code 关联 ERP 商品",\n    "columns": {\n      "id": {\n        "columnComment": "主键ID",\n        "type": "bigint(20) unsigned",\n        "remark": "主键ID"\n      },\n      "opportunity_id": {\n        "columnComment": "所属商机ID -> crm_opportunity.id",\n        "type": "bigint(20) unsigned",\n        "remark": "所属商机ID -> crm_opportunity.id"\n      },\n      "line_no": {\n        "columnComment": "行号，商机内从 1 递增",\n        "type": "int(10) unsigned",\n        "remark": "行号，商机内从 1 递增"\n      },\n      "product_code": {\n        "columnComment": "商品编码，逻辑外键 -> nova_erp.erp_product.product_code",\n        "type": "varchar(32)",\n        "remark": "商品编码，逻辑外键 -> nova_erp.erp_product.product_code"\n      },\n      "product_name": {\n        "columnComment": "商品名称快照（下单时点的名称，防主数据改名影响历史）",\n        "type": "varchar(128)",\n        "remark": "商品名称快照（下单时点的名称，防主数据改名影响历史）"\n      },\n      "unit": {\n        "columnComment": "计量单位快照",\n        "type": "varchar(16)",\n        "remark": "计量单位快照"\n      },\n      "quantity": {\n        "columnComment": "数量",\n        "type": "decimal(12,2)",\n        "remark": "数量"\n      },\n      "unit_price": {\n        "columnComment": "报价单价（元）",\n        "type": "decimal(14,2)",\n        "remark": "报价单价（元）"\n      },\n      "discount_rate": {\n        "columnComment": "折扣率（百分比，100 表示不打折）",\n        "type": "decimal(5,2)",\n        "remark": "折扣率（百分比，100 表示不打折）"\n      },\n      "amount": {\n        "columnComment": "行金额 = 数量 * 单价 * 折扣率/100",\n        "type": "decimal(14,2)",\n        "remark": "行金额 = 数量 * 单价 * 折扣率/100"\n      },\n      "created_at": {\n        "columnComment": "创建时间",\n        "type": "datetime",\n        "remark": "创建时间"\n      }\n    }\n  