e both cases or assume tuple structure based on SQL select order.\n        # Let\'s assume standard tuple return and map by index, or better, use a helper to convert.\n        # However, usually in these sandboxes, if it fails with tuple index, we should access by index.\n        # But wait, looking at previous successful patterns, often DictCursor is used or results are tuples.\n        # If it\'s a tuple: (id, customer_code, customer_name)\n        \n        target_customer = customers[0]\n        # Accessing by index assuming tuple: 0=id, 1=code, 2=name\n        customer_id = target_customer[0]\n        customer_code = target_customer[1]\n        customer_name = target_customer[2]\n        \n        print(f"找到客户: {customer_name} (ID: {customer_id}, Code: {customer_code})")\n        \n        # 2. Identify products\n        items_to_search = [\n            {"name_kw": "激光测距仪", "code_kw": "激光-215"},\n            {"name_kw": "PU气动软管", "code_kw": "PU-804"},\n            {"name_kw": "码垛机器人", "code_kw": "码垛-418"}\n        ]\n        \n        found_products = []\n        \n        def fetch_product(keyword_name, keyword_code_part):\n            sql_prod = """\n                SELECT id, product_code, product_name, sale_price, purchase_price\n                FROM nova_erp.erp_product\n                WHERE is_deleted = 0\n                  AND (product_name LIKE %s OR product_code LIKE %s)\n                LIMIT 1\n            """\n            pattern_name = f"%{keyword_name}%"\n            pattern_code = f"%{keyword_code_part}%"\n            \n            cursor.execute(sql_prod, (pattern_name, pattern_code))\n            res = cursor.fetchone()\n            return res\n            \n        for item in items_to_search:\n            p = fetch_product(item["name_kw"], item["code_kw"])\n            if not p:\n                p = fetch_product("", item["code_kw"])\n            \n            if p:\n                # p is a tuple: (id, code, name, sale_price, purchase_price