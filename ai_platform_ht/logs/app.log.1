soi.product_code,\n        soi.product_name,\n        soi.quantity,\n        soi.unit_price,\n        soi.amount as line_amount,\n        soi.delivered_qty\n    FROM nova_crm.crm_contract c\n    JOIN nova_crm.crm_customer cust ON c.customer_id = cust.id AND cust.is_deleted = 0\n    LEFT JOIN nova_erp.erp_sales_order so ON c.erp_order_no = so.order_no AND so.is_deleted = 0\n    LEFT JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n    WHERE c.is_deleted = 0\n      AND c.status IN (3, 4)\n    ORDER BY c.contract_no, so.order_no, soi.line_no\n    """\n    \n    cursor.execute(sql)\n    rows = cursor.fetchall()\n    \n    columns = [desc[0] for desc in cursor.description]\n    \n    if not rows:\n        print("未查询到已生效的销售合同数据")\n        print(\'__HANDOFF__\' + json.dumps({\'contract_ids\': [], \'sales_order_ids\': []}))\n    else:\n        dict_rows = []\n        for row in rows:\n            dict_rows.append(dict(zip(columns, row)))\n        \n        contract_data = defaultdict(lambda: {\n            \'contract_info\': None,\n            \'customer_info\': None,\n            \'orders\': defaultdict(lambda: {\'order_info\': None, \'items\': []}),\n            \'total_erp_sales\': Decimal(\'0\')\n        })\n        \n        for row in dict_rows:\n            c_no = row[\'contract_no\']\n            \n            if contract_data[c_no][\'contract_info\'] is None:\n                contract_data[c_no][\'contract_info\'] = {\n                    \'contract_no\': c_no,\n                    \'contract_name\': row[\'contract_name\'],\n                    \'sign_date\': str(row[\'sign_date\']) if row[\'sign_date\'] else None,\n                    \'effective_date\': str(row[\'effective_date\']) if row[\'effective_date\'] else None,\n                    \'expire_date\': str(row[\'expire_date\']) if row[\'expire_date\'] else None,\n                    \'contract_status\': row[\'contract_status\'],\n                    \'contract_total_amount\': float(row[\'contract_total_amount\']) if row[\'contract_total_amount\'] else 0\n                }\n                \n            if contract_data[c_no][\'customer_info\'] is None:\n                contract_data[c_no][\'customer_info\'] = {\n                    \'customer_code\': row[\'customer_code\'],\n                    \'customer_name\': row[\'customer_name\'],\n                    \'short_name\': row[\'short_name\'],\n                    \'industry\': row[\'industry\'],\n                    \'customer_level\': row[\'customer_level\']\n                }\n            \n            o_no = row[\'order_no\']\n            if o_no:\n                if contract_data[c_no][\'orders\'][o_no][\'order_info\'] is None:\n                    contract_data[c_no][\'orders\'][o_no][\'order_info\'] = {\n                        \'order_no\': o_no,\n                        \'sales_order_id\': row[\'sales_order_id\'],\n                        \'erp_order_total_amount\': float(row[\'erp_order_total_amount\']) if row[\'erp_order_total_amount\'] else 0,\n                        \'discount_amount\': float(row[\'discount_amount\']) if row[\'discount_amount\'] else 0,\n                        \'tax_amount\': float(row[\'tax_amount\']) if row[\'tax_amount\'] else 0,\n                        \'payable_amount\': float(row[\'payable_amount\']) if row[\'payable_amount\'] else 0,\n                        \'order_date\': str(row[\'order_date\']) if row[\'order_date\'] else None,\n                        \'delivery_date\': str(row[\'delivery_date\']) if row[\'delivery_date\'] else None,\n                        \'order_status\': row[\'order_status\']\n                    }\n                \n                if row[\'product_id\']:\n                    item = {\n                        \'product_id\': row[\'product_id\'],\n                        \'product_code\': row[\'product_code\'],\n                        \'product_name\': row[\'product_name\'],\n                        \'quantity\': float(row[\'quantity\']) if row[\'quantity\'] else 0,\n                        \'unit_price\': float(row[\'unit_price\']) if row[\'unit_price\'] else 0,\n                        \'line_amount\': float(row[\'line_amount\']) if row[\'line_amount\'] else 0,\n                        \'delivered_qty\': float(row[\'delivered_qty\']) if row[\'delivered_qty\'] else 0\n                    }\n                    contract_data[c_no][\'orders\'][o_no][\'items\'].append(item)\n                    if row[\'line_amount\']:\n                        contract_data[c_no][\'total_erp_sales\'] += Decimal(str(row[\'line_amount\']))\n        \n        print(f"{\'合同编号\':<15} | {\'客户名称\':<20} | {\'合同金额\':>12} | {\'ERP销售总额\':>12} | {\'订单数\':>6}")\n        print("-" * 80)\n        \n        all_contract_nos = []\n        all_sales_order_ids = []\n        \n        for c_no, data in sorted(contract_data.items()):\n            cust_name = data[\'customer_info\'][\'customer_name\'] if data[\'customer_info\'] else \'N/A\'\n            contract_amt = data[\'contract_info\'][\'contract_total_amount\'] if data[\'contract_info\'] else 0\n            erp_sales = float(data[\'total_erp_sales\'])\n            order_count = len(data[\'orders\'])\n            \n            print(f"{c_no:<15} | {cust_name:<20} | {contract_amt:>12.2f} | {erp_sales:>12.2f} | {order_count:>6}")\n            \n            all_contract_nos.append(c_no)\n            for o_no, o_data in data[\'orders\'].items():\n                if o_data[\'order_info\'] and o_data[\'order_info\'][\'sales_order_id\']:\n                    all_sales_order_ids.append(o_data[\'order_info\'][\'sales_order_id\'])\n        \n        print("-" * 80)\n        print(f"总计: {len(all_contract_nos)} 份合同, {len(set(all_sales_order_ids))} 个关联销售订单")\n        \n        unique_so_ids = list(set(all_sales_order_ids))\n        print(\'__HANDOFF__\' + json.dumps({\n            \'contract_nos\': all_contract_nos,\n            \'sales_order_ids\': unique_so_ids\n        }))\n\nfinally:\n    cursor.close()\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n合同编号            | 客户名称                 |         合同金额 |      ERP销售总额 |    订单数\n--------------------------------------------------------------------------------\nCON20260001     | 瀚海车联科技集团有限公司         |    496483.44 |    443908.53 |      1\nCON20260002     | 华信健康科技有限公司           |   1273382.36 |   1126887.04 |      1\nCON20260003     | 中科建设工程有限公司           |    742338.92 |    669623.86 |      1\nCON20260004     | 联创微电子集团有限公司          |    320249.42 |    283406.57 |      1\nCON20260005     | 海纳光伏能源股份有限公司         |    259371.70 |    229564.88 |      1\nCON20260006     | 佳合汽车零部件集团有限公司        |     74564.24 |     66543.75 |      1\nCON20260007     | 锐驰车联科技有限公司           |    761736.39 |    674103.00 |      1\nCON20260008     | 华信化工科技集团有限公司         |    848983.33 |    751312.68 |      1\nCON20260009     | 维创工程集团有限公司           |    719388.42 |    636626.92 |      1\nCON20260010     | 众诚车联科技集团有限公司         |   1203339.62 |   1088483.36 |      1\nCON20260011     | 天成食品工业有限公司           |   1515945.08 |   1341544.32 |      1\nCON20260012     | 天成饮品集团科技有限公司         |     63764.88 |     56799.21 |      1\nCON20260013     | 明德新能源科技集团有限公司        |    263221.97 |    232939.80 |      1\nCON20260014     | 瑞泰饮品集团科技有限公司         |    935452.87 |    838755.87 |      1\nCON20260015     | 宏图化工科技股份有限公司         |    486712.81 |    430719.30 |      1\nCON20260016     | 卓越重工科技有限公司           |   1534322.81 |   1357807.80 |      1\nCON20260017     | 泰和高分子材料有限公司          |    136195.10 |    120526.64 |      1\nCON20260018     | 泰和信息技术股份有限公司         |    197176.60 |    178056.15 |      1\nCON20260019     | 海纳信息技术集团有限公司         |   1226234.19 |   1085163.00 |      1\nCON20260020     | 明德食品工业科技有限公司         |    450093.85 |    398670.66 |      1\nCON20260021     | 佳合重工科技有限公司           |    120713.44 |    107936.83 |      1\nCON20260022     | 锐驰生物科技股份有限公司         |    884178.04 |    783762.00 |      1\nCON20260023     | 恒通化工科技股份有限公司         |    387213.48 |    342666.80 |      1\nCON20260024     | 明德精密机械股份有限公司         |   1112445.47 |   1004665.00 |      1\nCON20260025     | 正泰建设工程有限公司           |   2399627.77 |   2137940.20 |      1\nCON20260026     | 金鼎新能源科技股份有限公司        |    502120.02 |    444354.00 |      1\nCON20260027     | 金鼎高分子材料股份有限公司        |    820917.11 |    726475.32 |      1\nCON20260028     | 正泰信息技术有限公司           |    687936.20 |    618380.52 |      1\n--------------------------------------------------------------------------------\n总计: 28 份合同, 28 个关联销售订单\n```\n\n### 步骤 2: 步骤2：基于销售订单关联的生产工单及BOM结构，递归计算每个订单对应产品的BOM物料标准成本总和作为销售成本\n**执行代码**:\n```python\nimport json\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection failed")\n\ncursor = conn.cursor()\n\n# 读取上一步传递的销售订单ID列表\nsales_order_ids = _HANDOFF_2a1c52d2b7[\'sales_order_ids\']\n\nif not sales_order_ids:\n    print("No sales order IDs provided.")\nelse:\n    # 构建查询参数占位符\n    placeholders = \',\'.join([\'%s\'] * len(sales_order_ids))\n    \n    # 查询逻辑：\n    # 1. 从 erp_sales_order_item 获取每个销售订单行的 product_id 和 quantity (订购数量)\n    # 2. 通过 erp_material.product_id 找到对应的物料ID (material_id)\n    # 3. 通过 erp_bom.material_id 找到该物料的BOM头 (status=2 已发布, bom_type=3 销售BOM 或 1/2 视具体成本定义，通常标准成本基于制造BOM或工程BOM，这里假设使用已发布的BOM计算成本。若需精确匹配销售场景，可能需确认bom_type。根据描述“算出bom物料成本价格”，通常指生产该产品的物料成本。我们取最新已发布的BOM。)\n    #    注意：一个物料可能有多个版本BOM，我们需要取当前有效的（已发布）。为了简化，假设每个物料只有一个主要已发布BOM用于成本核算，或者取最新的。\n    # 4. 关联 erp_bom_item 获取子件物料 component_material_id 和用量 qty_per\n    # 5. 关联 erp_material (子件) 获取 standard_cost\n    # 6. 计算单台设备成本 = SUM(子件标准成本 * 单位用量 / BOM基础数量)\n    # 7. 总成本 = 单台设备成本 * 销售数量\n    \n    sql = f"""\n    SELECT \n        soi.order_id,\n        soi.line_no,\n        p.id as product_id,\n        p.product_name,\n        m_parent.id as parent_material_id,\n        m_parent.material_code as parent_material_code,\n        m_parent.material_name as parent_material_name,\n        soi.quantity as sale_qty,\n        soi.unit_price,\n        soi.amount as sale_amount,\n        bom.id as bom_id,\n        bom.base_qty,\n        SUM(bi.qty_per * m_child.standard_cost) as total_bom_cost_raw\n    FROM nova_erp.erp_sales_order_item soi\n    JOIN nova_erp.erp_product p ON soi.product_id = p.id\n    JOIN nova_erp.erp_material m_parent ON p.id = m_parent.product_id AND m_parent.is_deleted = 0\n    JOIN nova_erp.erp_bom bom ON m_parent.id = bom.material_id AND bom.status = 2\n    JOIN nova_erp.erp_bom_item bi ON bom.id = bi.bom_id\n    JOIN nova_erp.erp_material m_child ON bi.component_material_id = m_child.id AND m_child.is_deleted = 0\n    WHERE soi.order_id IN ({placeholders})\n    GROUP BY \n        soi.order_id,\n        soi.line_no,\n        p.id,\n        p.product_name,\n        m_parent.id,\n        m_parent.material_code,\n        m_parent.material_name,\n        soi.quantity,\n        soi.unit_price,\n        soi.amount,\n        bom.id,\n        bom.base_qty\n    """\n    \n    cursor.execute(sql, sales_order_ids)\n    rows = cursor.fetchall()\n    \n    results = []\n    for row in rows:\n        order_id = row[0]\n        line_no = row[1]\n        product_id = row[2]\n        product_name = row[3]\n        parent_material_id = row[4]\n        parent_material_code = row[5]\n        parent_material_name = row[6]\n        sale_qty = float(row[7]) if row[7] else 0.0\n        unit_price = float(row[8]) if row[8] else 0.0\n        sale_amount = float(row[9]) if row[9] else 0.0\n        bom_id = row[10]\n        base_qty = float(row[11]) if row[11] else 1.0\n        total_bom_cost_raw = float(row[12]) if row[12] else 0.0\n        \n        # 计算单位成本：总BOM成本 / 基础数量\n        unit_cost = total_bom_cost_raw / base_qty if base_qty != 0 else 0.0\n        # 计算总成本：单位成本 * 销售数量\n        total_cost = unit_cost * sale_qty\n        \n        results.append({\n            \'order_id\': order_id,\n            \'line_no\': line_no,\n            \'product_name\': product_name,\n            \'parent_material_code\': parent_material_code,\n            \'sale_qty\': sale_qty,\n            \'unit_price\': unit_price,\n            \'sale_amount\': sale_amount,\n            \'unit_cost\': round(unit_cost, 4),\n            \'total_cost\': round(total_cost, 2)\n        })\n        \n    # 输出表格\n    headers = [\'Order ID\', \'Line No\', \'Product Name\', \'Material Code\', \'Sale Qty\', \'Unit Price\', \'Sale Amount\', \'Unit Cost\', \'Total Cost\']\n    print(\'\\t\'.join(headers))\n    for r in results:\n        print(f"{r[\'order_id\']}\\t{r[\'line_no\']}\\t{r[\'product_name\']}\\t{r[\'parent_material_code\']}\\t{r[\'sale_qty\']:.2f}\\t{r[\'unit_price\']:.2f}\\t{r[\'sale_amount\']:.2f}\\t{r[\'unit_cost\']:.4f}\\t{r[\'total_cost\']:.2f}")\n        \n    # 准备传递给下一步的数据：每个销售订单行的成本信息\n    # 下一步需要计算毛利率，所以需要知道每行的销售收入和销售成本\n    handoff_data = {\n        \'order_line_costs\': [\n            {\n                \'order_id\': r[\'order_id\'],\n                \'line_no\': r[\'line_no\'],\n                \'sale_amount\': r[\'sale_amount\'],\n                \'total_cost\': r[\'total_cost\']\n            } for r in results\n        ]\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\ncursor.close()\nconn.rollback()\nconn.close()\n```\n**执行结果**:\n```text\nOrder ID\tLine No\tProduct Name\tMaterial Code\tSale Qty\tUnit Price\tSale Amount\tUnit Cost\tTotal Cost\n1\t1\t涂装机器人 涂装-285\tFG0029\t2.00\t178684.00\t353794.32\t26611.3244\t53222.65\n1\t2\t协作机器人 协作-417\tFG0021\t1.00\t96897.00\t90114.21\t26611.3244\t26611.32\n2\t1\t六轴工业机器人 六轴-729\tFG0025\t1.00\t217832.00\t206940.40\t26611.3244\t26611.32\n4\t1\t激光测距仪 激光-555\tFG0006\t1.00\t235831.00\t216964.52\t34670.1339\t34670.13\n9\t1\t涂装机器人 涂装-522\tFG0005\t2.00\t314633.00\t629266.00\t26611.3244\t53222.65\n11\t1\t焊接机器人 焊接-381\tFG0009\t3.00\t212444.00\t637332.00\t26611.3244\t79833.97\n11\t2\t六轴工业机器人 六轴-253\tFG0001\t2.00\t359292.00\t704212.32\t26611.3244\t53222.65\n13\t1\t激光测距仪 激光-119\tFG0014\t1.00\t163404.00\t163404.00\t34670.1339\t346