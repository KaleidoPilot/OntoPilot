    sale_price = float(prod_row[3]) if prod_row[3] else 0.0\n            \n            # Find material linked to this product\n            # erp_material.product_id -> erp_product.id\n            sql_material = """\n                SELECT id, material_code, material_name, standard_cost \n                FROM nova_erp.erp_material \n                WHERE product_id = %s AND is_deleted = 0\n                LIMIT 1\n            """\n            cursor.execute(sql_material, (product_id,))\n            mat_row = cursor.fetchone()\n            \n            material_id = None\n            material_code = None\n            standard_cost = 0.0\n            \n            if mat_row:\n                material_id = mat_row[0]\n                material_code = mat_row[1]\n                standard_cost = float(mat_row[3]) if mat_row[3] else 0.0\n            else:\n                # If no direct link, maybe we need to find material by code similarity?\n                # But rule says "product cost based on material cost". \n                # If product doesn\'t have a linked material, we can\'t calculate BOM cost easily without more info.\n                # For now, record what we have.\n                pass\n                \n            results.append({\n                \'input_name\': p_name,\n                \'product_id\': product_id,\n                \'product_code\': product_code,\n                \'product_name\': product_name_db,\n                \'sale_price\': sale_price,\n                \'material_id\': material_id,\n                \'material_code\': material_code,\n                \'standard_cost\': standard_cost\n            })\n            \n        print("\\n--- Product & Material Info ---")\n        for r in results:\n            print(f"Input: {r[\'input_name\']}")\n            print(f"  Product ID: {r[\'product_id\']}, Code: {r[\'product_code\']}, Name: {r[\'product_name\']}")\n            print(f"  Sale Price: {r[\'sale_price\']}")\n            print(f"  Material ID: {r[\'material_id\']}, Code: {r[\'material_code\']}, Std Cost: {r[\'standard_cost\']}")\n            print("-" * 20)\n            \n        # Prepare handoff data for next step\n        # Next step likely needs to calculate total cost using BOM.\n        # We need to pass the list of items with their quantities and material IDs.\n        # Quantities are fixed in prompt: 10 each.\n        \n        handoff_items = []\n        for r in results:\n            if r[\'product_id\']:\n                handoff_items.append({\n                    \'product_id\': r[\'product_id\'],\n                    \'material_id\': r[\'material_id\'],\n                    \'quantity\': 10,\n                    \'sale_price\': r[\'sale_price\'],\n                    \'product_name\': r[\'product_name\']\n                })\n                \n        handoff_data = {\n            \'customer_code\': customer_code,\n            \'items\': handoff_items\n        }\n        \n        print(\'__HANDOFF__\' + json.dumps(handoff_data))\n        \n    except Exception as e:\n        print(f"Error: {e}")\n    finally:\n        if conn:\n            conn.rollback()\n            conn.close()\n\nget_data()\n```\n**执行结果**:\n```text\nFound Customer: CUS0006 (ID: 6)\n\n--- Product & Material Info ---\nInput: 激光测距仪 激光-215\n  Product ID: 22, Code: SKU0022, Name: 激光测距仪 激光-215\n  Sale Price: 191871.0\n  Material ID: 18, Code: FG0018, Std Cost: 35386.2564\n--------------------\nInput: PU气动软管 PU-804\n  Product ID: 24, Code: SKU0024, Name: PU气动软管 PU-804\n  Sale Price: 409.0\n  Material ID: 20, Code: FG0020, Std Cost: 282.48\n--------------------\nInput: 码垛机器人 码垛-418\n  Product ID: 16, Code: SKU0016, Name: 码垛机器人 码垛-418\n  Sale Price: 282401.0\n  Material ID: 13, Code: FG0013, Std Cost: 27172.8374\n--------------------\n```\n\n### 步骤 2: 步骤2：基于步骤1获取的material_id，通过BOM结构递归或工单成本逻辑计算各产品的单位物料成本（若为自制件则关联BOM子件标准成本汇总，若为采购件则取物料标准成本），并结合订单数量计算总销售金额与总成本\n**执行代码**:\n```python\nimport json\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection unavailable")\n\ntry:\n    cursor = conn.cursor()\n    \n    handoff_data = _HANDOFF_eeb7432d0d\n    items = handoff_data[\'items\']\n    \n    results = []\n    \n    for item in items:\n        material_id = item[\'material_id\']\n        quantity = float(item[\'quantity\'])\n        sale_price_per_unit = float(item[\'sale_price\'])\n        product_name = item[\'product_name\']\n        \n        sql_material = """\n            SELECT source_type, standard_cost \n            FROM nova_erp.erp_material \n            WHERE id = %s\n        """\n        cursor.execute(sql_material, (material_id,))\n        mat_row = cursor.fetchone()\n        \n        if not mat_row:\n            continue\n            \n        source_type = int(mat_row[0])\n        std_cost = float(mat_row[1]) if mat_row[1] else 0.0\n        \n        total_cost_per_unit = 0.0\n        \n        if source_type == 1:\n            sql_bom = """\n                SELECT bom.id \n                FROM nova_erp.erp_bom bom\n                JOIN nova_erp.erp_material m ON bom.material_id = m.id\n                WHERE m.id = %s AND bom.status = 2\n                ORDER BY bom.effective_date DESC\n                LIMIT 1\n            """\n            cursor.execute(sql_bom, (material_id,))\n            bom_row = cursor.fetchone()\n            \n            if bom_row:\n                bom_id = int(bom_row[0])\n                \n                sql_bom_items = """\n                    SELECT bi.component_material_id, bi.qty_per, bi.loss_rate, cm.standard_cost\n                    FROM nova_erp.erp_bom_item bi\n                    JOIN nova_erp.erp_material cm ON bi.component_material_id = cm.id\n                    WHERE bi.bom_id = %s\n                """\n                cursor.execute(sql_bom_items, (bom_id,))\n                bom_items = cursor.fetchall()\n                \n                cost_sum = 0.0\n                for comp_mat_id, qty_per, loss_rate, comp_std_cost in bom_items:\n                    q = float(qty_per) if qty_per else 0.0\n                    lr = float(loss_rate) if loss_rate else 0.0\n                    c = float(comp_std_cost) if comp_std_cost else 0.0\n                    \n                    effective_qty = q * (1 + lr / 100.0)\n                    line_cost = effective_qty * c\n                    cost_sum += line_cost\n                \n                total_cost_per_unit = cost_sum\n            else:\n                total_cost_per_unit = std_cost\n        else:\n            total_cost_per_unit = std_cost\n            \n        total_sale_amount = quantity * sale_price_per_unit\n        total_cost_amount = quantity * total_cost_per_unit\n        gross_profit = total_sale_amount - total_cost_amount\n        gross_margin_rate = (gross_profit / total_sale_amount * 100) if total_sale_amount != 0 else 0\n        \n        results.append({\n            \'product_name\': product_name,\n            \'quantity\': quantity,\n            \'unit_sale_price\': sale_price_per_unit,\n            \'total_sale_amount\': total_sale_amount,\n            \'unit_cost\': total_cost_per_unit,\n            \'total_cost\': total_cost_amount,\n            \'gross_profit\': gross_profit,\n            \'gross_margin_rate\': round(gross_margin_rate, 2)\n        })\n    \n    import pandas as pd\n    df = pd.DataFrame(results)\n    \n    if not df.empty:\n        df[\'quantity\'] = df[\'quantity\'].astype(float)\n        df[\'unit_sale_price\'] = df[\'unit_sale_price\'].astype(float)\n        df[\'total_sale_amount\'] = df[\'total_sale_amount\'].astype(float)\n        df[\'unit_cost\'] = df[\'unit_cost\'].astype(float)\n        df[\'total_cost\'] = df[\'total_cost\'].astype(float)\n        df[\'gross_profit\'] = df[\'gross_profit\'].astype(float)\n        df[\'gross_margin_rate\'] = df[\'gross_margin_rate\'].astype(float)\n        \n        print(df.to_string(index=False))\n    else:\n        print("No data