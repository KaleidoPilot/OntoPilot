_id = %s AND is_deleted = 0\n        """\n        cursor.execute(sql_contracts, (customer_id,))\n        contract_rows = cursor.fetchall()\n        \n        if not contract_rows:\n            print(f"客户 {customer_code} 暂无合同记录")\n            return []\n        \n        contract_nos = [row[0] for row in contract_rows]\n        \n        # 3. Find ERP sales orders linked to these contracts\n        # The link is via erp_sales_order.contract_no\n        placeholders = \',\'.join([\'%s\'] * len(contract_nos))\n        sql_orders = f"""\n        SELECT so.id as order_id, so.order_no, so.contract_no\n        FROM nova_erp.erp_sales_order so\n        WHERE so.contract_no IN ({placeholders}) AND so.is_deleted = 0\n        """\n        cursor.execute(sql_orders, tuple(contract_nos))\n        order_rows = cursor.fetchall()\n        \n        if not order_rows:\n            print("未找到关联的ERP销售订单")\n            return []\n        \n        order_ids = [row[0] for row in order_rows]\n        order_map = {row[0]: {\'order_no\': row[1], \'contract_no\': row[2]} for row in order_rows}\n        \n        # 4. Get specific product details from sales order items\n        target_products = [\'钣金电控柜外壳\', \'大理石检测平台\', \'光谱测量模块\']\n        \n        results = []\n        for oid in order_ids:\n            sql_items = """\n            SELECT soi.product_name, soi.unit_price, soi.quantity, soi.amount, soi.product_code\n            FROM nova_erp.erp_sales_order_item soi\n            WHERE soi.order_id = %s\n            """\n            cursor.execute(sql_items, (oid,))\n            items = cursor.fetchall()\n            \n            for item in items:\n                p_name = item[0]\n                # Check if the product name matches any of the targets\n                match_found = False\n                for tp in target_products:\n                    if tp in p_name or p_name in tp:\n                        match_found = True\n                        break\n                \n                if match_found:\n                    unit_price = float(item[1]) if item[1] else 0.0\n                    quantity = float(item[2]) if item[2] else 0.0\n                    amount = float(item[3]) if item[3] else 0.0\n                    \n                    results.append({\n                        \'order_no\': order_map[oid][\'order_no\'],\n                        \'contract_no\': order_map[oid][\'contract_no\'],\n                        \'product_name\': p_name,\n                        \'unit_price\': unit_price,\n                        \'quantity\': quantity,\n                        \'total_amount\': amount,\n                        \'product_code\': item[4]\n                    })\n        \n        if not results:\n            print("在关联的销售订单中未找到指定产品的明细数据")\n            return []\n            \n        # Print table\n        headers = [\'Order No\', \'Contract No\', \'Product Name\', \'Unit Price\', \'Quantity\', \'Total Amount\', \'Product Code\']\n        print(\'\\t\'.join(headers))\n        for r in results:\n            print(f"{r[\'order_no\']}\\t{r[\'contract_no\']}\\t{r[\'product_name\']}\\t{r[\'unit_price\']:.2f}\\t{r[\'quantity\']:.2f}\\t{r[\'total_amount\']:.2f}\\t{r[\'product_code\']}")\n            \n        # Handoff data for next step: list of product codes and quantities needed for cost/inventory check\n        # We need to pass the unique product codes and their total requested quantities to calculate costs and check inventory\n        product_summary = {}\n        for r in results:\n            code = r[\'product_code\']\n            qty = r[\'quantity\']\n            if code not in product_summary:\n                product_summary[code] = 0\n            product_summary[code] += qty\n            \n        handoff_data = {\n            \'product_quantities\': product_summary,\n            \'sales_details\': results\n        }\n        \n        print(\'__HANDOFF__\' + json.dumps(handoff_data))\n        return results\n\n    except Exception as e:\n        print(f"Error: {e}")\n        import traceback\n        traceback.print_exc()\n        return []\n    finally:\n        if conn:\n            try:\n                conn.rollback()\n                conn.close()\n            except:\n                pass\n\nget_data()\n```\n**执行结果**:\n```text\n客户 CUS0006 暂无合同记录\n```\n\n### 步骤 2: 步骤2：根据产品名称在erp_product和erp_material表中匹配对应的物料ID，通过BOM表（erp_bom, erp_bom_item）递归或展开计算单位产品的标准材料成本，结合库存表（erp_inventory）查询当前可用库存（available_qty）是否满足各产品10个的需求\n**执行代码**:\n```python\nimport pandas as pd\nfrom decimal import Decimal\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection failed")\n\ntry:\n    cursor = conn.cursor()\n    \n    product_names = [\n        "钣金电控柜外壳",\n        "大理石检测平台",\n        "光谱测量模块"\n    ]\n    \n    placeholders = ",".join(["%s"] * len(product_names))\n    \n    sql_products = f"""\n    SELECT \n        p.id AS product_id,\n        p.product_code,\n        p.product_name,\n        m.id AS material_id,\n        m.material_code,\n        m.material_name,\n        m.standard_cost,\n        m.source_type\n    FROM nova_erp.erp_product p\n    LEFT JOIN nova_erp.erp_material m ON p.id = m.product_id AND m.is_deleted = 0\n    WHERE p.product_name IN ({placeholders})\n      AND p.is_deleted = 0\n    """\n    \n    cursor.execute(sql_products, tuple(product_names))\n    rows = cursor.fetchall()\n    cols = [desc[0] for desc in cursor.description]\n    df_products = pd.DataFrame(rows, columns=cols)\n    \n    if df_products.empty:\n        print("未找到匹配的产品数据")\n    else:\n        results = []\n        \n        for _, row in df_products.iterrows():\n            product_name = row[\'product_name\']\n            product_id = row[\'product_id\']\n            material_id = row[\'material_id\']\n            \n            unit_cost = Decimal(\'0\')\n            cost_source = ""\n            \n            if material_id is not None and not pd.isna(material_id):\n                std_cost = row[\'standard_cost\']\n                source_type = row[\'source_type\']\n                \n                if std_cost is not None and float(std_cost) > 0:\n                    unit_cost = Decimal(str(std_cost))\n                    cost_source = "标准成本(物料主数据)"\n                elif source_type == 1:\n                    bom_sql = """\n                    SELECT id, base_qty, yield_rate\n                    FROM nova_erp.erp_bom\n                    WHERE material_id = %s AND status = 2\n                    ORDER BY effective_date DESC\n                    LIMIT 1\n                    """\n                    cursor.execute(bom_sql, (int(material_id),))\n                    bom_row = cursor.fetchone()\n                    \n                    if bom_row:\n                        bom_id = bom_row[0]\n                        base_qty = Decimal(str(bom_row[1])) if bom_row[1] else Decimal(\'1\')\n                        yield_rate = Decimal(str(bom_row[2])) if bom_row[2] else Decimal(\'100\')\n                        \n                        item_sql = """\n                        SELECT bi.component_material_id, bi.qty_per, bi.loss_rate, m.standard_cost\n                        FROM nova_erp.erp_bom_item bi\n                        JOIN nova_erp.erp_material m ON bi.component_material_id = m.id AND m.is_deleted = 0\n                        WHERE bi.bom_id = %s\n                        """\n                        cursor.execute(item_sql, (bom_id,))\n                        items = cursor.fetchall()\n                        \n                        total_mat_cost = Decimal(\'0\')\n                        for item in items:\n                            comp_mat_id = item[0]\n                            qty_per = Decimal(str(item[1])) if item[1] else Decimal(\'0\')\n                            loss_rate = Decimal(str(item[2])) if item[2] else Decimal(\'0\')\n                            comp_std_cost = Decimal(str(item[3])) if item[3] else Decimal(\'0\')\n                            \n                            actual_qty = qty_per * (Decimal(\'1\') + loss_rate / Decimal(\'100\'))\n                            line_cost = actual_qty * comp_std_cost\n                            total_mat_cost += line_cost\n                        \n                        if base_qty > 0:\n                            unit_cost = total_mat_cost / base_qty\n                        else:\n                            unit_cost = total_mat_cost\n                            \n                        if yield_rate < 100 and yield_rate > 0:\n                            unit_cost = unit_cost / (yield_rate / Decimal(\'100\'))\n                            \n                        cost_source = "BOM材料成本卷积"\n                    else:\n                        cost_source = "无已发布BOM，使用标准成本或0"\n                        if std_cost is not None:\n                            unit_cost = Decimal(str(std_cost))\n                else:\n                    cost_source = "采购件/委外件，使用标准成本"\n                    if std_cost is not None:\n                        unit_cost = Decimal(str(std_cost))\n            else:\n                cost_source = "无关联物料ID"\n            \n            inv_sql = """\n            SELECT COALESCE(SUM(available_qty), 0) AS total_available\n            FROM nova_erp.erp_inventory\n            WHERE material_id = %s\n            """\n            cursor.execute(inv_sql, (int(material_id),) if material_id else (None,))\n            inv_row = cursor.fetchone()\n            available_qty = Decimal(str(inv_row[0])) if inv_row and inv_row[0] else Decimal(\'0\')\n            \n            demand_qty = Decimal(\'10\')\n            stock_sufficient = "是" if available_qty >= demand_qty else "否"\n            stock_gap = max(Decimal(\'0\'), demand_qty - available_qty)\n            \n            results.append({\n                \'产品名称\': product_name,\n                \'SKU编码\': row[\'product_code\'],\n                \'物料编码\': row[\'material_code\'] if row[\'material_code\'] else \'-\',\n                \'单位成本(元)\': float(unit_cost),\n                \'成本来源\': cost_source,\n                \'可用库存数量\': float(available_qty),\n                \'需求数量\': float(demand_qty),\n                \'库存是否充足\': stock_sufficient,\n                \'缺口数量\': float(stock_gap)\n            })\n        \n        df_result = pd.DataFrame(results)\n        print(df_result.to_string(index=False))\n\nfinally:\n    try:\n        cursor.close()\n    except:\n        pass\n    try:\n        conn.rollback()\n    except:\n        pass\n    try:\n        conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\n未找到匹配的产品数据\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
