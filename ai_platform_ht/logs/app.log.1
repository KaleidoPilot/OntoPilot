va_erp.erp_sales_order so\n        JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n        WHERE so.is_deleted = 0\n          AND (so.customer_name LIKE %s OR so.customer_code IN (\n              SELECT customer_code FROM nova_crm.crm_customer WHERE customer_name LIKE %s AND is_deleted = 0\n          ))\n        """\n        \n        cursor.execute(sql_orders, (\'%华信健康%\', \'%华信健康%\'))\n        orders_df = pd.DataFrame(cursor.fetchall(), columns=[desc[0] for desc in cursor.description])\n        \n        if orders_df.empty:\n            print("未找到客户\'华信健康\'的销售订单数据。")\n            return\n            \n        # Calculate total sales amount from ERP orders\n        total_sales = orders_df[\'line_amount\'].sum()\n        \n        # 2. Get BOM Cost for each product involved\n        # Logic: For each unique product_id in the orders, find its material_id in erp_material.\n        # Then find the active BOM for that material.\n        # Then sum up the cost of components in the BOM.\n        # Note: The prompt asks for "BOM物料成本价格". Usually this means the standard cost of the finished good derived from BOM.\n        # However, erp_material has standard_cost. If we want to calculate based on BOM structure explicitly:\n        # Cost = Sum(Component Qty * Component Standard Cost).\n        # But often, the Finished Good\'s standard_cost IS the rolled-up BOM cost.\n        # Let\'s check if we can get the component costs via BOM.\n        \n        unique_product_ids = orders_df[\'product_id\'].unique().tolist()\n        \n        if not unique_product_ids:\n             print("订单中无有效产品ID，无法计算成本。")\n             return\n\n        # Format IDs for SQL IN clause\n        ids_str = ",".join([str(int(pid)) for pid in unique_product_ids])\n        \n        # Query to get BOM details and calculate material cost per unit for these products\n        # Step A: Map Product ID to Material ID (Finished Good)\n        sql_mat_map = f"""\n        SELECT id as material_id, product_id \n        FROM nova_erp.erp_material \n        WHERE product_id IN ({ids_str}) AND is_deleted = 0\n        """\n        cursor.execute(sql_mat_map)\n        mat_map_df = pd.DataFrame(cursor.fetchall(), columns=[\'material_id\', \'product_id\'])\n        \n        if mat_map_df.empty:\n            print("未找到对应产品的物料主数据。")\n            return\n            \n        fg_material_ids = mat_map_df[\'material_id\'].tolist()\n        fg_ids_str = ",".join([str(int(mid)) for mid in fg_material_ids])\n        \n        # Step B: Get Active BOMs for these Finished Goods\n        # Assuming status=2 (Published) and bom_type=3 (Sales BOM) or just any published BOM? \n        # Prompt says "bom物料成本", usually implies manufacturing/sales BOM. Let\'s take published ones.\n        sql_boms = f"""\n        SELECT id as bom_id, material_id as fg_material_id, base_qty\n        FROM nova_erp.erp_bom\n        WHERE material_id IN ({fg_ids_str})\n          AND status = 2\n          AND is_deleted = 0 -- erp_bom doesn\'t have is_deleted in schema provided, but let\'s check. Schema says no is_deleted for erp_bom.\n        """\n        # Correction: erp_bom table does NOT have is_deleted column in the provided schema.\n        sql_boms = f"""\n        SELECT id as bom_id, material_id as fg_material_id, base_qty\n        FROM nova_erp.erp_bom\n        WHERE material_id IN ({fg_ids_str})\n          AND status = 2\n        """\n        cursor.execute(sql_boms)\n        boms_df = pd.DataFrame(cursor.fetchall(), columns=[\'bom_id\', \'fg_material_id\', \'base_qty\'])\n        \n        if boms_df.empty:\n            print("未找到已发布的BOM结构，尝试使用物料标准成本作为参考...")\n            # Fallback: Use erp_material.standard_cost for the FG itself\n            sql_fg_cost = f"""\n            SELECT m.id as material_id, m.product_id, m.standard_cost\n            FROM nova_erp.erp_material m\n            WHERE m.product_id IN ({ids_str}) AND m.is_deleted = 0\n            """\n            cursor.execute(sql_fg_cost)\n            fg_cost_df = pd.DataFrame(cursor.fetchall(), columns=[\'material_id\', \'product_id\', \'unit_standard_cost\'])\n            \n            # Merge back to orders\n            orders_with_cost = orders_df.merge(mat_map_df, left_on=\'product_id\', right_on=\'product_id\') \\\n                                        .merge(fg_cost_df, left_on=\'material_id\', right_on=\'material_id\')\n            \n            orders_with_cost[\'total_line_cost\'] = orders_with_cost[\'quantity\'] * orders_with_cost[\'unit_standard_cost\']\n            \n        else:\n            # Step C: Get BOM Items and Component Costs\n            bom_ids = boms_df[\'bom_id\'].tolist()\n            bom_ids_str = ",".join([str(int(bid)) for bid in bom_ids])\n            \n            sql_bom_items = f"""\n            SELECT \n                bi.bom_id,\n                bi.component_material_id,\n                bi.qty_per,\n                bi.loss_rate,\n                cm.standard_cost as component_unit_cost\n            FROM nova_erp.erp_bom_item bi\n            JOIN nova_erp.erp_material cm ON bi.component_material_id = cm.id\n            WHERE bi.bom_id IN ({bom_ids_str})\n              AND cm.is_deleted = 0\n            """\n            cursor.execute(sql_bom_items)\n            bom_items_df = pd.DataFrame(cursor.fetchall(), columns=[\'bom_id\', \'component_material_id\', \'qty_per\', \'loss_rate\', \'component_unit_cost\'])\n            \n            if bom_items_df.empty:\n                 print("BOM明细为空，无法计算卷算成本。")\n                 return\n\n            # Calculate Unit Cost per FG based on BOM\n            # Formula: Sum( (Qty_Per * (1 + Loss_Rate/100)) * Component_Unit_Cost ) / Base_Qty\n            # Note: loss_rate is percentage e.g., 5 means 5%. So factor is (1 + loss_rate/100)\n            bom_items_df[\'effective_qty\'] = bom_items_df[\'qty_per\'] * (1 + bom_items_df[\'loss_rate\'] / 100.0)\n            bom_items_df[\'line_cost\'] = bom_items_df[\'effective_qty\'] * bom_items_df[\'component_unit_cost\']\n            \n            # Group by BOM to get total cost for the BOM\'s base quantity\n            bom_costs = bom_items_df.groupby(\'bom_id\')[\'line_cost\'].sum().reset_index()\n            bom_costs.rename(columns={\'line_cost\': \'total_bom_base_cost\'}, inplace=True)\n            \n            # Join with BOM header to get base_qty and map to FG Material ID\n            bom_costs_full = bom_costs.merge(boms_df, on=\'bom_id\')\n            bom_costs_full[\'unit_fg_cost\'] = bom_costs_full[\'total_bom_base_cost\'] / bom_costs_full[\'base_qty\']\n            \n            # Now we have unit_fg_cost per fg_material_id\n            # Map Product ID -> FG Material ID -> Unit Cost\n            # mat_map_df has product_id and material_id (which is fg_material_id)\n            \n            final_cost_map = mat_map_df.merge(bom_costs_full[[\'fg_material_id\', \'unit_fg_cost\']], \n                                              left_on=\'material_id\', right_on=\'fg_material_id\')\n            \n            # Merge with Orders\n            orders_with_cost = orders_df.merge(final_cost_map[[\'product_id\', \'unit_fg_cost\']], on=\'product_id\', how=\'left\')\n            \n            # Fill NaN with 0 or handle missing costs\n            orders_with_cost[\'unit_fg_cost\'] = orders_with_cost[\'unit_fg_cost\'].fillna(0)\n            orders_with_cost[\'total_line_cost\'] = orders_with_cost[\'quantity\'] * orders_with_cost[\'unit_fg_cost\']\n\n        # 3. Calculate Totals and Gross Margin\n        total_cost = orders_with_cost[\'total_line_cost\'].sum()\n        gross_profit = total_sales - total_cost\n        gross_margin_rate = (gross_profit / total_sales * 100) if total_sales != 0 else 0\n        \n        # Summary Output\n        summary_data = {\n            \'Customer\': \'华信健康\',\n            \'Total Sales Amount\': round(total_sales, 2),\n            \'Total Cost (BOM)\': round(total_cost, 2),\n            \'Gross Profit\': round(gross_profit, 2),\n            \'Gross Margin Rate (%)\': round(gross_margin_rate, 2)\n        }\n        \n        print("--- 财务汇总 ---")\n        print(json.dumps(summary_data, indent=4, ensure_ascii=False))\n        \n        # Detail Output\n        detail_cols = [\'order_no\', \'product_name\', \'quantity\', \'unit_price\', \'line_amount\', \'unit_fg_cost\', \'total_line_cost\']\n        # Ensure all cols exist\n        available_cols = [c for c in detail_cols if c in orders_with_cost.columns]\n        \n        print("\\n--- 订单及物料成本明细 ---")\n        if not orders_with_cost.empty:\n            print(orders_with_cost[available_cols].to_string(index=False))\n        else:\n            print("无明细数据")\n\n    except Exception as e:\n        print(f"Error: {e}")\n        import traceback\n        traceback.print_exc()\n    finally:\n        if \'conn\' in locals() and conn:\n            conn.rollback()\n            conn.close()\n\nget_data()\n```\n**执行结果**:\n```text\nError: unsupported operand type(s) for /: \'decimal.Decimal\' and \'float\'\nTraceback (most recent call last):\n  File "/opt/python/versions/cpython-3.14.5-linux-x86_64-gnu/lib/python3.14/site-packages/pandas/core/ops/array_ops.py", line 220, in _na_arithmetic_op\n    result = func(left, right)\n  File "/opt/python/versions/cpython-3.14.5-linux-x86_64-gnu/lib/python3.14/site-packages/pandas/core/computation/expressions.py", line 252, in evaluate\n    return _evaluate(op, op_str, left_op, right_op)  # type: ignore[misc]\n  File "/opt/python/versions/cpython-3.14.5-linux-x86_64-gnu/lib/python3.14/site-packages/pandas/core/computation/expressions.py", line 83, in _evaluate_standard\n    return op(left_op, right_op)\nTypeError: unsupported operand type(s) for /: \'decimal.Decimal\' and \'float\'\n\nDuring handling of the above exception, another exception occurred:\n\nTraceback (most recent call last):\n  File "<string>", line 147, in get_data\n  File "/opt/python/versions/cpython-3.14.5-linux-