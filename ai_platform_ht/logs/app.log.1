\'total_cost\'], errors=\'coerce\').fillna(0.0)\n        \n        valid_order_ids = df_costs[\'order_id\'].dropna().unique().tolist()\n        if not valid_order_ids:\n            print("有效订单ID为空")\n        else:\n            placeholders = \',\'.join([\'%s\'] * len(valid_order_ids))\n            sql_sales = f"""\n            SELECT \n                so.id AS order_id,\n                so.order_no,\n                so.contract_no,\n                so.customer_code,\n                so.customer_name,\n                soi.line_no,\n                soi.product_code,\n                soi.product_name,\n                soi.quantity,\n                soi.unit_price,\n                soi.amount AS sale_amount\n            FROM nova_erp.erp_sales_order so\n            JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n            WHERE so.is_deleted = 0 AND so.id IN ({placeholders})\n            """\n            \n            cursor.execute(sql_sales, valid_order_ids)\n            sales_rows = cursor.fetchall()\n            sales_cols = [desc[0] for desc in cursor.description]\n            df_sales = pd.DataFrame(sales_rows, columns=sales_cols)\n            \n            if df_sales.empty:\n                print("未查询到销售明细数据")\n            else:\n                # 转换 Decimal 为 float\n                df_sales[\'sale_amount\'] = df_sales[\'sale_amount\'].apply(lambda x: float(x) if isinstance(x, Decimal) else (float(x) if x is not None else 0.0))\n                df_sales[\'unit_price\'] = df_sales[\'unit_price\'].apply(lambda x: float(x) if isinstance(x, Decimal) else (float(x) if x is not None else 0.0))\n                df_sales[\'quantity\'] = df_sales[\'quantity\'].apply(lambda x: float(x) if isinstance(x, Decimal) else (float(x) if x is not None else 0.0))\n                \n                df_merged = pd.merge(\n                    df_sales, \n                    df_costs[[\'order_id\', \'line_no\', \'total_cost\']], \n                    on=[\'order_id\', \'line_no\'], \n                    how=\'left\'\n                )\n                \n                df_merged[\'total_cost\'] = df_merged[\'total_cost\'].fillna(0.0)\n                df_merged[\'gross_profit\'] = df_merged[\'sale_amount\'] - df_merged[\'total_cost\']\n                \n                # 避免除以零\n                df_merged[\'gross_margin_rate\'] = df_merged.apply(\n                    lambda row: (row[\'gross_profit\'] / row[\'sale_amount\']) * 100 if row[\'sale_amount\'] != 0 else 0.0, \n                    axis=1\n                )\n                \n                contract_agg = df_merged.groupby([\'contract_no\', \'customer_code\', \'customer_name\']).agg(\n                    total_sale_amount=(\'sale_amount\', \'sum\'),\n                    total_cost=(\'total_cost\', \'sum\'),\n                    total_gross_profit=(\'gross_profit\', \'sum\'),\n                    avg_gross_margin_rate=(\'gross_margin_rate\', \'mean\')\n                ).reset_index()\n                \n                contract_agg[\'avg_gross_margin_rate\'] = contract_agg.apply(\n                    lambda row: (row[\'total_gross_profit\'] / row[\'total_sale_amount\']) * 100 if row[\'total_sale_amount\'] != 0 else 0.0, \n                    axis=1\n                )\n                \n                customer_agg = df_merged.groupby([\'customer_code\', \'customer_name\']).agg(\n                    total_sale_amount=(\'sale_amount\', \'sum\'),\n                    total_cost=(\'total_cost\', \'sum\'),\n                    total_gross_profit=(\'gross_profit\', \'sum\'),\n                    contract_count=(\'contract_no\', \'nunique\')\n                ).reset_index()\n                \n                customer_agg[\'avg_gross_margin_rate\'] = customer_agg.apply(\n                    lambda row: (row[\'total_gross_profit\'] / row[\'total_sale_amount\']) * 100 if row[\'total_sale_amount\'] != 0 else 0.0, \n                    axis=1\n                )\n                \n                print("="*80)\n                print("【客户合同销售毛利率全方位分析报告】")\n                print("="*80)\n                \n                print("\\n>>> 一、按合同维度分析明细 <<<")\n                print("-"*80)\n                print(f"{\'合同编号\':<16} {\'客户编码\':<12} {\'客户名称\':<20} {\'销售额(元)\':>14} {\'成本(元)\':>14} {\'毛利额(元)\':>14} {\'毛利率(%)\':>10}")\n                print("-"*80)\n                for _, row in contract_agg.iterrows():\n                    cno = str(row[\'contract_no\'])[:15] if pd.notna(row[\'contract_no\']) else \'-\'\n                    cc = str(row[\'customer_code\'])[:11] if pd.notna(row[\'customer_code\']) else \'-\'\n                    cn = str(row[\'customer_name\'])[:19] if pd.notna(row[\'customer_name\']) else \'-\'\n                    sa = f"{float(row[\'total_sale_amount\']):,.2f}"\n                    tc = f"{float(row[\'total_cost\']):,.2f}"\n                    gp = f"{float(row[\'total_gross_profit\']):,.2f}"\n                    gm = f"{float(row[\'avg_gross_margin_rate\']):.2f}"\n                    print(f"{cno:<16} {cc:<12} {cn:<20} {sa:>14} {tc:>14} {gp:>14} {gm:>10}")\n                \n                print("\\n>>> 二、按客户维度聚合统计 <<<")\n                print("-"*80)\n                print(f"{\'客户编码\':<12} {\'客户名称\':<20} {\'合同数量\':>8} {\'总销售额(元)\':>16} {\'总成本(元)\':>16} {\'总毛利(元)\':>16} {\'平均毛利率(%)\':>12}")\n                print("-"*80)\n                for _, row in customer_agg.iterrows():\n                    cc = str(row[\'customer_code\'])[:11] if pd.notna(row[\'customer_code\']) else \'-\'\n                    cn = str(row[\'customer_name\'])[:19] if pd.notna(row[\'customer_name\']) else \'-\'\n                    cnt = int(row[\'contract_count\'])\n                    tsa = f"{float(row[\'total_sale_amount\']):,.2f}"\n                    ttc = f"{float(row[\'total_cost\']):,.2f}"\n                    tgp = f"{float(row[\'total_gross_profit\']):,.2f}"\n                    agm = f"{float(row[\'avg_gross_margin_rate\']):.2f}"\n                    print(f"{cc:<12} {cn:<20} {cnt:>8} {tsa:>16} {ttc:>16} {tgp:>16} {agm:>12}")\n                \n                print("\\n>>> 三、整体汇总 <<<")\n                print("-"*80)\n                overall_total_sale = float(df_merged[\'sale_amount\'].sum())\n                overall_total_cost = float(df_merged[\'total_cost\'].sum())\n                overall_total_profit = float(df_merged[\'gross_profit\'].sum())\n                overall_margin = (overall_total_profit / overall_total_sale) * 100 if overall_total_sale != 0 else 0.0\n                unique_contracts = df_merged[\'contract_no\'].nunique()\n                unique_customers = df_merged[\'customer_code\'].nunique()\n                \n                print(f"涉及客户数: {unique_customers}")\n                print(f"涉及合同数: {unique_contracts}")\n                print(f"总销售额:   {overall_total_sale:,.2f} 元")\n                print(f"总成本:     {overall_total_cost:,.2f} 元")\n                print(f"总毛利额:   {overall_total_profit:,.2f} 元")\n                print(f"综合毛利率: {overall_margin:.2f}%")\n                print("="*80)\n\nfinally:\n    try:\n        cursor.close()\n    except:\n        pass\n    try:\n        conn.rollback()\n    except:\n        pass\n    try:\n        conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\n================================================================================\n【客户合同销售毛利率全方位分析报告】\n================================================================================\n\n>>> 一、按合同维度分析明细 <<<\n--------------------------------------------------------------------------------\n合同编号             客户编码         客户名称                         销售额(元)          成本(元)         毛利额(元)     毛利率(%)\n--------------------------------------------------------------------------------\nCON20260001      CUS0003      瀚海车联科技集团有限公司             443,908.53      79,833.97     364,074.56      82.02\nCON20260002      CUS0013      华信健康科技有限公司             1,126,887.04      26,611.32   1,100,275.72      97.64\