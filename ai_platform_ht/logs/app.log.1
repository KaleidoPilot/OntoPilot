p(codes, names))}")\n            handoff_data = {\'customer_code\': codes[0]}\n            print(\'__HANDOFF__\' + json.dumps(handoff_data))\n            \nexcept Exception as e:\n    print(f"查询出错: {e}")\nfinally:\n    try:\n        cursor.close()\n    except:\n        pass\n    try:\n        conn.rollback()\n    except:\n        pass\n    try:\n        conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\n客户编码: CUS0006, 客户名称: 海纳动力系统股份有限公司\n```\n\n### 步骤 2: 步骤2：根据产品名称和规格（激光测距仪 激光-215、PU气动软管 PU-804、码垛机器人 码垛-418）在nova_erp.erp_product表中查询对应的商品ID(product_id)、商品编码(product_code)、标准销售价(sale_price)及税率(tax_rate)\n**执行代码**:\n```python\nimport json\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection failed")\n\ntry:\n    cursor = conn.cursor()\n    \n    # 定义查询条件：产品名称和规格型号的组合\n    # 用户请求：激光测距仪 激光-215, PU气动软管 PU-804, 码垛机器人 码垛-418\n    # 根据规则，需要区分是产品名称还是SKU。这里假设“激光测距仪”等是名称，“激光-215”等是规格或编码的一部分。\n    # 在 erp_product 表中，product_name 对应名称，spec 对应规格。\n    # 为了准确匹配，我们使用 LIKE 或者精确匹配。考虑到数据可能存在的格式差异，先尝试精确匹配 product_name 和 spec。\n    # 如果不确定 spec 是否完全等于 "激光-215"，可能需要更灵活的匹配。但通常 ERP 中 spec 字段存储具体型号。\n    \n    products_query = [\n        ("激光测距仪", "激光-215"),\n        ("PU气动软管", "PU-804"),\n        ("码垛机器人", "码垛-418")\n    ]\n    \n    results = []\n    \n    for name, spec in products_query:\n        sql = """\n            SELECT \n                id as product_id,\n                product_code,\n                product_name,\n                spec,\n                sale_price,\n                tax_rate\n            FROM nova_erp.erp_product\n            WHERE product_name = %s AND spec = %s AND is_deleted = 0\n        """\n        cursor.execute(sql, (name, spec))\n        row = cursor.fetchone()\n        \n        if row:\n            results.append({\n                "input_name": name,\n                "input_spec": spec,\n                "product_id": int(row[0]),\n                "product_code": row[1],\n                "db_product_name": row[2],\n                "db_spec": row[3],\n                "sale_price": float(row[4]) if row[4] is not None else 0.0,\n                "tax_rate": float(row[5]) if row[5] is not None else 0.0\n            })\n        else:\n            # 如果精确匹配失败，尝试只按名称模糊匹配或只按规格匹配，以防数据录入不规范\n            # 但为了保持严谨，先记录未找到\n            results.append({\n                "input_name": name,\n                "input_spec": spec,\n                "product_id": None,\n                "product_code": None,\n                "db_product_name": None,\n                "db_spec": None,\n                "sale_price": None,\n                "tax_rate": None,\n                "status": "Not Found"\n            })\n            \n    cursor.close()\nfinally:\n    conn.rollback()\n    conn.close()\n\n# 打印结果表格\nprint(f"{\'Input Name\':<15} | {\'Input Spec\':<10} | {\'Product ID\':<10} | {\'Product Code\':<15} | {\'Sale Price\':<10} | {\'Tax Rate\':<10}")\nprint("-" * 90)\nfor r in results:\n    pid_str = str(r[\'product_id\']) if r[\'product_id\'] is not None else "N/A"\n    code_str = r[\'product_code\'] if r[\'product_code\'] else "N/A"\n    price_str = f"{r[\'sale_price\']:.2f}" if r[\'sale_price\'] is not None else "N/A"\n    tax_str = f"{r[\'tax_rate\']:.2f}" if r[\'tax_rate\'] is not None else "N/A"\n    print(f"{r[\'input_name\']:<15} | {r[\'input_spec\']:<10} | {pid_str:<10} | {code_str:<15} | {price_str:<10} | {tax_str:<10}")\n\n# 准备 Handoff 数据\n# 后续步骤需要知道哪些产品找到了，以及它们的ID、价格等信息来计算成本和毛利\nvalid_products = [r for r in results if r[\'product_id\'] is not None]\n\nhandoff_data = {\n    "requested_items": results, # 包含所有请求项的状态，包括未找到的\n    "found_product_ids": [r[\'product_id\'] for r in valid_products],\n    "product_details": {str(r[\'product_id\']): {\n        "code": r[\'product_code\'],\n        "name": r[\'db_product_name\'],\n        "spec": r[\'db_spec\'],\n        "sale_price": r[\'sale_price\'],\n        "tax_rate": r[\'tax_rate\']\n    } for r in valid_products}\n}\n\nprint(\'__HANDOFF__\' + json.dumps(handoff_data))\n```\n**执行结果**:\n```text\nInput Name      | Input Spec | Product ID | Product Code    | Sale Price | Tax Rate  \n------------------------------------------------------------------------------------------\n激光测距仪           | 激光-215     | N/A        | N/A             | N/A        | N/A       \nPU气动软管          | PU-804     | N/A        | N/A             | N/A        | N/A       \n码垛机器人           | 码垛-418     | N/A        | N/A             | N/A        | N/A       \n```\n\n### 步骤 3: 步骤3：基于步骤2获取的商品ID，关联nova_erp.erp_material表获取对应的物料ID(material_id)和物料类型，并关联nova_erp.erp_inventory表查询各物料的当前可用库存(available_qty)，判断库存是否满足各10个的需求\n**执行代码**:\n```python\nimport json\n\nconn = get_connection()\nif conn is None:\n    raise RuntimeError("数据库连接不可用")\n\ntry:\n    cursor = conn.cursor()\n    \n    handoff_data = _HANDOFF_f60ab8691c\n    requested_items = handoff_data.get(\'requested_items\', [])\n    \n    results = []\n    product_ids_for_handoff = []\n    \n    for item in requested_items:\n        input_name = item.get(\'input_name\')\n        input_spec = item.get(\'input_spec\')\n        \n        if not input_name or not input_spec:\n            continue\n            \n        sql_material = """\n        SELECT \n            m.id AS material_id,\n            m.material_code,\n            m.material_name,\n            m.material_type,\n            m.standard_cost,\n            p.id AS product_id,\n            p.product_code,\n            p.product_name,\n            p.spec\n        FROM nova_erp.erp_material m\n        JOIN nova_erp.erp_product p ON m.product_id = p.id\n        WHERE p.product_name LIKE %s \n          AND p.spec LIKE %s\n          AND m.is_deleted = 0\n          AND p.is_deleted = 0\n        LIMIT 1\n        """\n        \n        params = (f\'%{input_name}%\', f\'%{input_spec}%\')\n        cursor.execute(sql_material, params)\n        row = cursor.fetchone()\n        \n        if row:\n            columns = [desc[0] for desc in cursor.description]\n            record = dict(zip(columns, row))\n            \n            material_id = record[\'material_id\']\n            standard_cost = float(record[\'standard_cost\']) if record[\'standard_cost\'] else 0.0\n            \n            sql_inventory = """\n            SELECT \n                SUM(available_qty) AS total_available_qty\n            FROM nova_erp.erp_inventory\n            WHERE material_id = %s\n            """\n            cursor.execute(sql_inventory, (material_id,))\n            inv_row = cursor.fetchone()\n            \n            available_qty = 0.0\n            if inv_row and inv_row[0] is not None:\n                available_qty = float(inv_row[0])\n            \n            required_qty = 10.0\n            stock_sufficient = "是" if available_qty >= required_qty else "否"\n            \n            results.append({\n                \'input_name\': input_name,\n                \'input_spec\': input_spec,\n                \'product_id\': int(record[\'product_id\']),\n                \'product_code\': record[\'product_code\'],\n                \'db_product_name\': record[\'product_name\'],\n                \'db_spec\': record[\'spec\'],\n                \'material_id\': int(material_id),\n                \'material_code\': record[\'material_code\'],\n                \'material_name\': record[\'material_name\'],\n                \'material_type\': int(record[\'material_type\']),\n                \'standard_cost\': standard_cost,\n                \'available_qty\': available_qty,\n                \'required_qty\': required_qty,\n                \'stock_sufficient\': stock_sufficient\n            })\n            \n            if record[\'product_id\']:\n                product_ids_for_handoff.append(int(record[\'product_id\']))\n        else:\n            results.append({\n                \'input_name\': input_name,\n                \'input_spec\': input_spec,\n                \'product_id\': None,\n                \'product_code\': None,\n                \'db_product_name\': None,\n                \'db_spec\': None,\n                \'material_id\': None,\n                \'material_code\': None,\n                \'material_name\': None,\n                \'material_type\': None,\n                \'standard_cost\': None,\n                \'available_qty\': None,\n                \'required_qty\': 10.0,\n                \'stock_sufficient\': "未找到物料"\n            })\n\n    print(f"{\'产品名称\':<15} | {\'规格\':<10} | {\'物料编码\':<12} | {\'标准成本\':<10} | {\'可用库存\':<10} | {\'需求数量\':<10} | {\'库存是否足够\'}")\n    print("-" * 100)\n    for r in results:\n        cost_str = f"{r[\'standard_cost\']:.2f}" if r[\'standard_cost\'] is not None else "N/A"\n        qty_str = f"{r[\'available_qty\']:.2f}" if r[\'available_qty\'] is not None else "N/A"\n        req_str = f"{r[\'required_qty\']:.2f}"\n        suff_str = r[\'stock_sufficient\']\n        mat_code = r[\'material_code\'] if r[\'material_code\'] else "N/A"\n        name = r[\'input_name\']\n        spec = r[\'input_spec\']\n        print(f"{name:<15} | {spec:<10} | {mat_code:<12} | {cost_str:<10} | {qty_str:<10} | {req_str:<10} | {suff_str}")\n\n    handoff_output = {\n        \'product_ids\': product_ids_for_handoff,\n        \'item_details\': results\n    }\n    print(\'__HANDOFF__\' + json.dumps(handoff_output))\n\nfinally:\n    if \'cursor\' in locals():\n        cursor.close()\n    if \'conn\' in locals():\n        conn.rollback()\n        conn.close()\n```\n**执行结果**:\n```text\n产品名称            | 规格         | 物料编码         | 标准成本       | 可用库存       | 需求数量       | 库存是否足够\n----------------------------------------------------------------------------------------------------\n激光测距仪           | 激光-215     | N/A          | N/A        | N/A        | 10.00      | 未找到物料\nPU气动软管          | PU-804     | N/A          | N/A        | N/A        | 10.00      | 未找到物料\n码垛机器人           | 码垛-418     | N/A          | N/A        | N/A        | 10.00      | 未找到物料\n```\n\n### 步骤 4: 步骤4：基于步骤3获取的物料ID，若物料为自制件(source_type=1)，则通过nova_erp.erp_bom和nova_erp.erp_bom_item递归或汇总计算BOM材料成本；若为采购件，则取nova_erp.erp_material.standard_cost作为成本。最终输出合同建议销售价格（含税）、预估总成本及库存充足性结论\n**执行代码**:\n```python\nimport json\n\nhandoff = _HANDOFF_f60ab8691c\nitem_details = handoff.get(\'item_details\', [])\n\nconn = get_connection()\nif conn is None:\n    raise Exception("数据库连接不可用")\n\ncursor = conn.cursor()\n\nresults = []\n\nfor item in item_details:\n    input_name = item[\'input_name\']\n    input_spec = item[\'input_spec\']\n    required_qty = float(item[\'required_qty\'])\n    material_id = item.get(\'material_id\')\n    sale_price = item.get(\'sale_price\')\n    tax_rate = item.get(\'tax_rate\')\n    available_qty = item.get(\'available_qty\')\n    \n    if not material_id or sale_price is None:\n        results.append({\n            \'产品名称\': input_name,\n            \'规格型号\': input_spec,\n            \'数量\': required_qty,\n            \'合同单价(不含税)\': 0,\n            \'合同总价(含税)\': 0,\n            \'单位成本\': 0,\n            \'总成本\': 0,\n            \'库存可用量\': 0,\n            \'库存是否充足\': \'数据缺失\'\n        })\n        continue\n    \n    sql_material = """\n    SELECT source_type, standard_cost \n    FROM nova_erp.erp_material \n    WHERE id = %s AND is_deleted = 0\n    """\n    cursor.execute(sql_material, (material_id,))\n    row = cursor.fetchone()\n    \n    if not row:\n        results.append({\n            \'产品名称\': input_name,\n            \'规格型号\': input_spec,\n            \'数量\': required_qty,\n            \'合同单价(不含税)\': float(sale_price),\n            \'合同总价(含税)\': float(sale_price) * required_qty * (1 + float(tax_rate)/100),\n            \'单位成本\': 0,\n            \'总成本\': 0,\n            \'库存可用量\': float(available_qty) if available_qty else 0,\n            \'库存是否充足\': \'物料信息缺失\'\n        })\n        continue\n    \n    source_type = int(row[0])\n    standard_cost_val = row[1]\n    standard_cost = float(standard_cost_val) if standard_cost_val is not None else 0.0\n    unit_cost = 0.0\n    \n    if source_type == 1:\n        sql_bom = """\n        SELECT id, base_qty, yield_rate\n        FROM nova_erp.erp_bom\n        WHERE material_id = %s AND status = 2 AND bom_type IN (1, 2)\n        ORDER BY effective_date DESC LIMIT 1\n        """\n        cursor.execute(sql_bom, (material_id,))\n        bom_row = cursor.fetchone()\n        \n        if bom_row:\n            bom_id = bom_row[0]\n            base_qty_val = bom_row[1]\n            yield_rate_val = bom_row[2]\n            \n            base_qty = float(base_qty_val) if base_qty_val is not None and float(base_qty_val) != 0 else 1.0\n            yield_rate = float(yield_rate_val) if yield_rate_val is not None and float(yield_rate_val) != 0 else 100.0\n            \n            sql_items = """\n            SELECT bi.component_material_id, bi.qty_per, bi.loss_rate, m.standard_cost\n            FROM nova_erp.erp_bom_item bi\n            JOIN nova_erp.erp_material m ON bi.component_material_id = m.id\n            WHERE bi.bom_id = %s AND m.is_deleted = 0\n            """\n            cursor.execute(sql_items, (bom_id,))\n            bom_rows = cursor.fetchall()\n            \n            total_component_cost = 0.0\n            for br in bom_rows:\n                qty_per_val = br[1]\n                loss_rate_val = br[2]\n                comp_std_cost_val = br[3]\n                \n                qty_per = float(qty_per_val) if qty_per_val is not None else 0.0\n                loss_rate = float(loss_rate_val) if loss_rate_val is not None else 0.0\n                comp_std_cost = float(comp_std_cost_val) if comp_std_cost_val is not None else 0.0\n                \n                effective_qty = qty_per * (1 + loss_rate / 100.0)\n                component_cost = effective_qty * comp_std_cost\n                total_component_cost += component_cost\n            \n            if base_qty > 0 and yield_rate > 0:\n                unit_cost = (total_component_cost / base_qty) * (100.0 / yield_rate)\n            else:\n                unit_cost = standard_cost\n        else:\n            unit_cost = standard_cost\n    elif source_type == 2:\n        unit_cost = standard_cost\n    else:\n        unit_cost = standard_cost\n    \n    contract_unit_price_ex_tax = float(sale_price)\n    tax_rate_val = float(tax_rate) if tax_rate is not None else 0.0\n    contract_total_incl_tax = contract_unit_price_ex_tax * required_qty * (1 + tax_rate_val / 100.0)\n    total_cost = unit_cost * required_qty\n    stock_avail = float(available_qty) if available_qty is not None else 0.0\n    is_sufficient = "是" if stock_avail >= required_qty else "否"\n    \n    results.append({\n        \'产品名称\': input_name,\n        \'规格型号\': input_spec,\n        \'数量\': required_qty,\n        \'合同单价(不含税)\': round(contract_unit_price_ex_tax, 2),\n        \'合同总价(含税)\': round(contract_total_incl_tax, 2),\n        \'单位成本\': round(unit_cost, 4),\n        \'总成本\': round(total_cost, 2),\n        \'库存可用量\': stock_avail,\n        \'库存是否充足\': is_sufficient\n    })\n\ncursor.close()\nconn.rollback()\nconn.close()\n\nprint(f"{\'产品名称\':<15} | {\'规格型号\':<12} | {\'数量\':>6} | {\'合同单价(不含税)\':>16} | {\'合同总价(含税)\':>14} | {\'单位成本\':>10} | {\'总成本\':>12} | {\'库存可用量\':>10} | {\'库存是否充足\':>10}")\nprint("-" * 130)\nfor r in results:\n    print(f"{r[\'产品名称\']:<15} | {str(r[\'规格型号\']):<12} | {r[\'数量\']:>6.2f} | {r[\'合同单价(不含税)\']:>16.2f} | {r[\'合同总价(含税)\']:>14.2f} | {r[\'单位成本\']:>10.4f} | {r[\'总成本\']:>12.2f} | {r[\'库存可用量\']:>10.2f} | {r[\'库存是否充足\']:>10}")\n\ntotal_contract_value = sum(float(r[\'合同总价(含税)\']) for r in results)\ntotal_estimated_cost = sum(float(r[\'总成本\']) for r in results)\noverall_stock_status = all(r[\'库存是否充足\'] == \'是\' for r in results)\n\nprint("\\n--- 汇总分析 ---")\nprint(f"合同建议销售总金额（含税）：{total_contract_value:.2f} 元")\nprint(f"预估产品总成本：{total_estimated_cost:.2f} 元")\nprint(f"整体库存充足性结论：{\'全部充足\' if overall_stock_status else \'存在不足\'}")\n```\n**执行结果**:\n```text\n产品名称            | 规格型号         |     数量 |        合同单价(不含税) |       合同总价(含税) |       单位成本 |          总成本 |      库存可用量 |     库存是否充足\n----------------------------------------------------------------------------------------------------------------------------------\n激光测距仪           | 激光-215       |  10.00 |             0.00 |           0.00 |     0.0000 |         0.00 |       0.00 |       数据缺失\nPU气动软管          | PU-804       |  10.00 |             0.00 |           0.00 |     0.0000 |         0.00 |       0.00 |       数据缺失\n码垛机器人           | 码垛-418       |  10.00 |             0.00 |           0.00 |     0.0000 |         0.00 |       0.00 |       数据缺失\n\n--- 汇总分析 ---\n合同建议销售总金额（含税）：0.00 元\n预估产品总成本：0.00 元\n整体库存充足性结论：存在不足\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
