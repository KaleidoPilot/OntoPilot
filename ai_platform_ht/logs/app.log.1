o.id = soi.order_id\n    WHERE c.is_deleted = 0\n      AND c.status IN (3, 4) \n    ORDER BY c.contract_no, so.order_no, soi.line_no;\n    """\n    \n    cursor.execute(sql)\n    rows = cursor.fetchall()\n    columns = [desc[0] for desc in cursor.description]\n    \n    print("Contract | Customer | Order No | Product | Qty | Unit Price | Item Amount")\n    print("-" * 100)\n    \n    contract_ids = []\n    seen_contracts = set()\n    \n    if not rows:\n        print("No active contracts found.")\n    else:\n        for row in rows:\n            data = dict(zip(columns, row))\n            \n            contract_no = data[\'contract_no\']\n            if contract_no and contract_no not in seen_contracts:\n                seen_contracts.add(contract_no)\n                contract_ids.append(contract_no)\n                \n            customer_name = data[\'customer_name\'] or \'N/A\'\n            order_no = data[\'order_no\'] or \'No Order\'\n            product_name = data[\'product_name\'] or \'N/A\'\n            quantity = data[\'quantity\'] if data[\'quantity\'] is not None else 0\n            unit_price = data[\'unit_price\'] if data[\'unit_price\'] is not None else 0\n            item_amount = data[\'item_amount\'] if data[\'item_amount\'] is not None else 0\n            \n            print(f"{contract_no} | {customer_name} | {order_no} | {product_name} | {quantity} | {unit_price} | {item_amount}")\n        \n        print("\\n--- Summary ---")\n        total_contract_value = sum([r[2] for r in rows if r[2] is not None]) / len(set([r[0] for r in rows])) if rows else 0\n        \n        unique_contracts = {}\n        for row in rows:\n            data = dict(zip(columns, row))\n            cn = data[\'contract_no\']\n            if cn:\n                if cn not in unique_contracts:\n                    unique_contracts[cn] = {\n                        \'total_amount\': data[\'contract_total_amount\'],\n                        \'customer\': data[\'customer_name\']\n                    }\n        \n        sum_contract_amounts = sum([v[\'total_amount\'] for v in unique_contracts.values() if v[\'total_amount\'] is not None])\n        print(f"Total Contract Value (Sum of distinct contracts): {sum_contract_amounts}")\n        \n        sum_item_amounts = sum([r[12] for r in rows if r[12] is not None])\n        print(f"Total Sales Order Item Amount (Sum of all items): {sum_item_amounts}")\n\n    print(\'__HANDOFF__\' + json.dumps({\'active_contract_nos\': contract_ids}))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 2: 步骤2：基于销售订单关联的生产工单及BOM结构，递归计算各订单对应产品的BOM物料标准成本总和作为销售成本\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\ndef get_connection():\n    # 假设沙箱环境已提供此函数，若未定义则报错\n    raise NotImplementedError("get_connection must be provided by the sandbox environment")\n\ntry:\n    conn = get_connection()\n    cursor = conn.cursor(dictionary=True)\n\n    # Step 1: Get all sales orders with their items and link to products/materials\n    # We need to calculate BOM cost for each product sold in an order.\n    # The path is: Sales Order -> Sales Order Item -> Product ID -> Material ID (via erp_material.product_id) -> BOM -> BOM Items -> Component Materials -> Standard Cost\n    \n    # First, let\'s identify which materials correspond to the products in sales orders.\n    # Then we need to recursively or iteratively calculate the BOM cost. \n    # Since SQL recursion can be complex and performance-heavy depending on depth, \n    # and Python allows easier logic for "summing up leaf costs" if we fetch the structure,\n    # but fetching full tree per item might be slow.\n    \n    # Alternative approach:\n    # 1. Fetch all active Sales Orders and their items.\n    # 2. For each item, find the corresponding Material ID.\n    # 3. Find the latest published BOM for that Material.\n    # 4. Calculate the total standard cost of the BOM components.\n    \n    # Let\'s start by getting the list of sales orders and their items joined with material info.\n    \n    sql_orders_items = """\n         \n            so.id as order_id,\n            so.order_no,\n            so.customer_code,\n            so.customer_name,\n            so.contract_no,\n            soi.id as item_id,\n            soi.product_id,\n            soi.quantity,\n            soi.unit_price,\n            soi.amount as sales_amount,\n            m.id as material_id,\n            m.material_code,\n            m.material_name,\n            m.standard_cost as parent_standard_cost\n        FROM nova_erp.erp_sales_order so\n        JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n        LEFT JOIN nova_erp.erp_material m ON soi.product_id = m.product_id AND m.is_deleted = 0\n        WHERE so.is_deleted = 0\n          AND m.id IS NOT NULL\n    """\n    \n    cursor.execute(sql_orders_items)\n    rows = cursor.fetchall()\n    \n    if not rows:\n        print("No sales orders found with linked materials.")\n        result_data = []\n    else:\n        # Collect unique material IDs to batch query BOMs\n        material_ids = list(set([r[\'material_id\'] for r in rows if r[\'material_id\']]))\n        \n        # Query BOM headers for these materials (latest published version)\n        # Note: A material might have multiple BOM versions. We usually take the latest effective/published one.\n        # Assuming \'status\' 2 is published.\n        \n        bom_map = {} # material_id -> bom_id\n        \n        if material_ids:\n            placeholders = \',\'.join([\'%s\'] * len(material_ids))\n            sql_boms = f"""\n                 id, material_id, base_qty, yield_rate\n                FROM nova_erp.erp_bom\n                WHERE material_id IN ({placeholders})\n                  AND status = 2\n                  AND (expire_date IS NULL OR expire_date > NOW())\n                ORDER BY effective_date DESC, created_at DESC\n            """\n            cursor.execute(sql_boms, material_ids)\n            boms = cursor.fetchall()\n            \n            # Keep only the first (latest) BOM for each material\n            for b in boms:\n                mid = b[\'material_id\']\n                if mid not in bom_map:\n                    bom_map[mid] = {\n                        \'bom_id\': b[\'id\'],\n                        \'base_qty\': b[\'base_qty\'],\n                        \'yield_rate\': b[\'yield_rate\']\n                    }\n        \n        # Now, for each material with a BOM, we need to calculate the total component cost.\n        # This requires joining BOM Items with Material Standard Costs.\n        \n        bom_ids = [v[\'bom_id\'] for v in bom_map.values()]\n        component_costs_map = {} # bom_id -> total_unit_cost_of_components\n        \n        if bom_ids:\n            placeholders_bom = \',\'.join([\'%s\'] * len(bom_ids))\n            sql_bom_items = f"""\n                 \n                    bi.bom_id,\n                    bi.component_material_id,\n                    bi.qty_per,\n                    bi.loss_rate,\n                    cm.standard_cost\n                FROM nova_erp.erp_bom_item bi\n                JOIN nova_erp.erp_material cm ON bi.component_material_id = cm.id AND cm.is_deleted = 0\n                WHERE bi.bom_id IN ({placeholders_bom})\n            """\n            cursor.execute(sql_bom_items, bom_ids)\n            items = cursor.fetchall()\n            \n            # Aggregate cost per BOM\n            for item in items:\n                bid = item[\'bom_id\']\n                qty = float(item[\'qty_per\'])\n                loss = float(item[\'loss_rate\']) / 100.0 if item[\'loss_rate\'] else 0.0\n                std_cost = float(item[\'standard_cost\']) if item[\'standard_cost\'] else 0.0\n                \n                # Effective quantity considering loss\n                eff_qty = qty * (1 + loss)\n                \n                # Cost contribution\n                cost_contrib = eff_qty * std_cost\n                \n                if bid not in component_costs_map:\n                    component_costs_map[bid] = 0.0\n                component_costs_map[bid] += cost_contrib\n        \n        # Process results\n        final_results = []\n        for row in rows:\n            mat_id = row[\'material_id\']\n            bom_info = bom_map.get(mat_id)\n            \n            unit_cost = 0.0\n            if bom_info:\n                bid = bom_info[\'bom_id\']\n                comp_cost = component_costs_map.get(bid, 0.0)\n                base_qty = float(bom_info[\'base_qty\']) if bom_info[\'base_qty\'] else 1.0\n                yield_rate = float(bom_info[\'yield_rate\']) if bom_info[\'yield_rate\'] else 100.0\n                \n                # Cost per unit produced = (Total Component Cost for Base Qty) / Base Qty / Yield Rate?\n                # Usually BOM cost is calculated for the output. \n                # If base_qty is 1, then comp_cost is cost for 1 unit.\n                # If yield < 100, actual cost per good unit = comp_cost / (yield/100)\n                \n                raw_unit_cost = comp_cost / base_qty if base_qty != 0 else 0\n                if yield_rate > 0:\n                    adjusted_unit_cost = raw_unit_cost / (yield_rate / 100.0)\n                else:\n                    adjusted_unit_cost = raw_unit_cost\n                \n                unit_cost = adjusted_unit_cost\n            else:\n                # No BOM found, fallback to material\'s own standard cost if available\n                unit_cost = float(row[\'parent_standard_cost\']) if row[\'parent_standard_cost\'] else 0.0\n            \n            quantity = float(row[\'quantity\'])\n            sales_amount = float(row[\'sales_amount\'])\n            total_cost = unit_cost * quantity\n            gross_profit = sales_amount - total_cost\n            margin_pct = (gross_profit / sales_amount * 100) if sales_amount != 0 else 0\n            \n            final_results.append({\n                \'order_no\': row[\'order_no\'],\n                \'customer_name\': row[\'customer_name\'],\n                \'contract_no\': row[\'contract_no\'],\n                \'product_name\': row[\'material_name\'],\n                \'quantity\': quantity,\n                \'sales_amount\': round(sales_amount, 2),\n                \'unit_cost\': round(unit_cost, 4),\n                \'total_cost\': round(total_cost, 2),\n                \'gross_profit\': round(gross_profit, 2),\n                \'margin_pct\': round(margin_pct, 2)\n            })\n        \n        # Print table\n        header = f"{\'Order No\':<15} | {\'Customer\':<20} | {\'Contract\':<15} | {\'Product\':<20} | {\'Qty\':>8} | {\'Sales Amt\':>12} | {\'Unit Cost\':>10} | {\'Total Cost\':>12} | {\'Profit\':>12} | {\'Margin %\':>8}"\n        print(header)\n        print("-" * len(header))\n        for r in final_results:\n            line = f"{r[\'order_no\']:<15} | {r[\'customer_name\'][:20]:<20} | {str(r[\'contract_no\'] or \'\')[:15]:<15} | {r[\'product_name\'][:20]:<20} | {r[\'quantity\']:>8.2f} | {r[\'sales_amount\']:>12.2f} | {r[\'unit_cost\']:>10.4f} | {r[\'total_cost\']:>12.2f} | {r[\'gross_profit\']:>12.2f} | {r[\'margin_pct\']:>7.2f}%"\n            print(line)\n            \n        # Prepare handoff data for next step (Analysis of customer profiles/aggregates)\n        # We pass the detailed records so the next step can aggregate them easily without re-querying DB\n        # But the prompt says "simple objects". Passing a large list of dicts might be heavy but acceptable if small.\n        # Alternatively, just pass the summary stats or the list of order_nos to filter later?\n        # The next step is "Analyze customer profile...". It likely needs the profit data per customer.\n        # I will pass the aggregated data by customer to keep it simple and useful.\n        \n        from collections import defaultdict\n        cust_agg = defaultdict(lambda: {\'contracts\': set(), \'orders\': set(), \'sales\': 0.0, \'cost\': 0.0, \'profit\': 0.0})\n        \n        for r in final_results:\n            cname = r[\'customer_name\']\n            cust_agg[cname][\'contracts\'].add(r[\'contract_no\'])\n            cust_agg[cname][\'orders\'].add(r[\'order_no\'])\n            cust_agg[cname][\'sales\'] += r[\'sales_amount\']\n            cust_agg[cname][\'cost\'] += r[\'total_cost\']\n            cust_agg[cname][\'profit\'] += r[\'gross_profit\']\n            \n        summary_list = []\n        for cname, data in cust_agg.items():\n            summary_list.append({\n                \'customer_name\': cname,\n                \'contract_count\': len(data[\'contracts\']),\n                \'order_count\': len(data[\'orders\']),\n                \'total_sales\': round(data[\'sales\'], 2),\n                \'total_cost\': round(data[\'cost\'], 2),\n                \'total_profit\': round(data[\'profit\'], 2),\n                \'avg_margin\': round((data[\'profit\']/data[\'sales\']*100) if data[\'sales\'] else 0, 2)\n            })\n            \n        print(\'__HANDOFF__\' + json.dumps({\'customer_profit_summary\': summary_list}))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    try:\n        if \'cursor\' in locals():\n            cursor.close()\n        if \'conn\' in locals():\n            conn.rollback()\n            conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\nError: get_connection must be provided by the sandbox environment\n```\n\n### 步骤 3: 步骤3：将销售金额与BOM物料成本进行匹配，计算每个合同的毛利润及毛利率，并按客户维度聚合分析合同数量、总销售额、总成本、总毛利及平均毛利率\n**执行代码**:\n```python\nimport pandas as pd\n\ndef get_connection():\n    # 沙箱环境提供，此处仅为占位符，实际执行时由沙箱注入\n    pass\n\nconn = None\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n    \n    # 1. 获取所有有效合同及其关联的销售订单信息\n    sql_contracts = """\n     \n        c.contract_no,\n        c.customer_id,\n        cu.customer_name,\n        cu.short_name,\n        c.total_amount AS contract_total_amount,\n        so.order_no,\n        so.id AS sales_order_id,\n        so.total_amount AS order_total_amount,\n        soi.product_id,\n        soi.quantity,\n        soi.unit_price,\n        soi.amount AS line_amount\n    FROM nova_crm.crm_contract c\n    JOIN nova_crm.crm_customer cu ON c.customer_id = cu.id AND cu.is_deleted = 0\n    LEFT JOIN nova_erp.erp_sales_order so ON c.contract_no = so.contract_no AND so.is_deleted = 0\n    LEFT JOIN nova_erp.erp_sales_order_item soi ON so.id = soi.order_id\n    WHERE c.is_deleted = 0 \n      AND c.status IN (3, 4) -- 已生效或已归档的合同视为有效业务数据\n    """\n    cursor.execute(sql_contracts)\n    columns = [desc[0] for desc in cursor.description]\n    rows = cursor.fetchall()\n    df_contracts = pd.DataFrame(rows, columns=columns)\n    \n    if df_contracts.empty:\n        print("未找到有效的客户合同数据")\n    else:\n        # 2. 计算每个销售订单行对应的BOM成本\n        # 需要关联 erp_material -> erp_bom -> erp_bom_item -> erp_material(子件)\n        # 逻辑：父件物料ID -> BOM头 -> BOM行 -> 子件物料ID -> 子件标准成本\n        \n        # 首先提取所有涉及的产品ID（即父件物料ID）\n        product_ids = df_contracts[\'product_id\'].dropna().unique().tolist()\n        \n        bom_cost_map = {}\n        if product_ids:\n            # 查询这些产品的最新已发布BOM及其子件成本汇总\n            # 注意：一个产品可能有多个版本BOM，通常取最新生效的。这里简化处理，假设取状态为2(已发布)且生效日期最近的，或者简单取平均/第一个。\n            # 为了准确匹配“当前”成本，我们查找该物料ID对应的已发布BOM，并计算其直接子件的总标准成本。\n            # 多层BOM成本卷积比较复杂，根据技能描述“算出bom物料成本价格”，通常指直接材料成本或单层展开。\n            # 这里采用：对于每个父件物料，找到其已发布的BOM，累加所有子件物料的 standard_cost * qty_per\n            \n            placeholders = \',\'.join([\'%s\'] * len(product_ids))\n            sql_bom = f"""\n             \n                m.id AS parent_material_id,\n                b.id AS bom_id,\n                SUM(bi.qty_per * child_m.standard_cost) AS total_direct_material_cost\n            FROM nova_erp.erp_material m\n            JOIN nova_erp.erp_bom b ON m.id = b.material_id AND b.status = 2 -- 已发布\n            JOIN nova_erp.erp_bom_item bi ON b.id = bi.bom_id\n            JOIN nova_erp.erp_material child_m ON bi.component_material_id = child_m.id\n            WHERE m.id IN ({placeholders})\n            GROUP BY m.id, b.id\n            ORDER BY b.effective_date DESC\n            """\n            cursor.execute(sql_bom, tuple(product_ids))\n            bom_rows = cursor.fetchall()\n            \n            # 构建映射：如果同一个物料有多个BOM版本，取第一个（因为ORDER BY effective_date DESC，最新的在前）\n            for row in bom_rows:\n                pid = row[0]\n                cost = float(row[3]) if row[3] is not None else 0.0\n                if pid not in bom_cost_map:\n                    bom_cost_map[pid] = cost\n        \n        # 3. 将成本合并到合同明细中\n        def calculate_line_cost(row):\n            if pd.isna(row[\'product_id\']):\n                return 0.0\n            unit_cost = bom_cost_map.get(row[\'product_id\'], 0.0)\n            return unit_cost * row[\'quantity\']\n        \n        df_contracts[\'line_cost\'] = df_contracts.apply(calculate_line_cost, axis=1)\n        \n        # 4. 按合同维度聚合\n        # 先按合同+订单聚合销售额和成本\n        df_order_agg = df_contracts.groupby([\n            \'contract_no\', \n            \'customer_id\', \n            \'customer_name\', \n            \'short_name\',\n            \'order_no\'\n        ]).agg(\n            order_sales_amount=(\'line_amount\', \'sum\'),\n            order_bom_cost=(\'line_cost\', \'sum\')\n        ).reset_index()\n        \n        # 再按合同聚合（处理一个合同对应多个订单的情况，或者无订单的情况）\n        # 如果合同没有关联订单，则使用合同总金额作为销售额参考？技能要求“计算销售金额”，通常以ERP订单为准。\n        # 但为了全方位分析，若订单为空，可标记为0或特殊处理。这里主要基于有订单的数据进行分析。\n        \n        df_contract_agg = df_order_agg.groupby([\n            \'contract_no\', \n            \'customer_id\', \n            \'customer_name\', \n            \'short_name\'\n        ]).agg(\n            total_sales_amount=(\'order_sales_amount\', \'sum\'),\n            total_bom_cost=(\'order_bom_cost\', \'sum\'),\n            order_count=(\'order_no\', \'nunique\')\n        ).reset_index()\n        \n        # 补充那些没有生成订单的有效合同（可选，视业务需求而定，这里主要关注已产生交易的毛利）\n        # 如果有合同无订单，total_sales_amount 会是 NaN 或 0。\n        \n        # 5. 计算毛利和毛利率\n        df_contract_agg[\'gross_profit\'] = df_contract_agg[\'total_sales_amount\'] - df_contract_agg[\'total_bom_cost\']\n        df_contract_agg[\'gross_margin_rate\'] = df_contract_agg.apply(\n            lambda x: (x[\'gross_profit\'] / x[\'total_sales_amount\'] * 100) if x[\'total_sales_amount\'] > 0 else 0, \n            axis=1\n        )\n        \n        # 6. 按客户维度聚合最终结果\n        df_customer_final = df_contract_agg.groupby([\n            \'customer_id\', \n            \'customer_name\', \n            \'short_name\'\n        ]).agg(\n            contract_count=(\'contract_no\', \'nunique\'),\n            total_sales_amount=(\'total_sales_amount\', \'sum\'),\n            total_bom_cost=(\'total_bom_cost\', \'sum\'),\n            total_gross_profit=(\'gross_profit\', \'sum\'),\n            avg_gross_margin_rate=(\'gross_margin_rate\', \'mean\')\n        ).reset_index()\n        \n        # 格式化输出\n        df_customer_final[\'total_sales_amount\'] = df_customer_final[\'total_sales_amount\'].round(2)\n        df_customer_final[\'total_bom_cost\'] = df_customer_final[\'total_bom_cost\'].round(2)\n        df_customer_final[\'total_gross_profit\'] = df_customer_final[\'total_gross_profit\'].round(2)\n        df_customer_final[\'avg_gross_margin_rate\'] = df_customer_final[\'avg_gross_margin_rate\'].round(2)\n        \n        # 重命名以便阅读\n        df_result = df_customer_final.rename(columns={\n            \'customer_name\': \'客户名称\',\n            \'short_name\': \'客户简称\',\n            \'contract_count\': \'合同数量\',\n            \'total_sales_amount\': \'总销售额(元)\',\n            \'total_bom_cost\': \'总BOM成本(元)\',\n            \'total_gross_profit\': \'总毛利(元)\',\n            \'avg_gross_margin_rate\': \'平均毛利率(%)\'\n        })\n        \n        # 排序：按总毛利降序\n        df_result = df_result.sort_values(by=\'总毛利(元)\', ascending=False)\n        \n        print(df_result.to_string(index=False))\n        \n        # 额外打印整体汇总\n        total_rev = df_result[\'总销售额(元)\'].sum()\n        total_cost = df_result[\'总BOM成本(元)\'].sum()\n        total_profit = df_result[\'总毛利(元)\'].sum()\n        overall_margin = (total_profit / total_rev * 100) if total_rev > 0 else 0\n        \n        print("\\n--- 全局汇总 ---")\n        print(f"总销售额: {total_rev:.2f} 元")\n        print(f"总BOM成本: {total_cost:.2f} 元")\n        print(f"总毛利: {total_profit:.2f} 元")\n        print(f"整体毛利率: {overall_margin:.2f}%")\n\nexcept Exception as e:\n    print(f"执行出错: {str(e)}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\n执行出错: \'NoneType\' object has no attribute \'cursor\'\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
