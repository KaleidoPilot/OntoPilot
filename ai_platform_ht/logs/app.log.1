_name,\n                m.product_id,\n                p.product_code,\n                p.product_name\n            FROM nova_erp.erp_material m\n            JOIN nova_erp.erp_product p ON m.product_id = p.id\n            WHERE m.product_id IN ({\',\'.join([\'%s\'] * len(product_ids))})\n              AND m.is_deleted = 0\n        """\n        cursor.execute(sql_materials, product_ids)\n        materials = cursor.fetchall()\n        \n        if not materials:\n            print("No materials linked to the requested products")\n        else:\n            material_map = {}\n            for mat in materials:\n                material_map[mat[\'material_id\']] = {\n                    \'product_code\': mat[\'product_code\'],\n                    \'product_name\': mat[\'product_name\'],\n                    \'material_code\': mat[\'material_code\'],\n                    \'material_name\': mat[\'material_name\']\n                }\n            \n            top_level_material_ids = list(material_map.keys())\n            \n            all_bom_items = []\n            current_parent_ids = top_level_material_ids\n            \n            while current_parent_ids:\n                placeholders_current = \',\'.join([\'%s\'] * len(current_parent_ids))\n                \n                sql_bom_head = f"""\n                    SELECT \n                        b.id as bom_id,\n                        b.material_id as parent_material_id,\n                        b.base_qty,\n                        b.yield_rate\n                    FROM nova_erp.erp_bom b\n                    WHERE b.material_id IN ({placeholders_current})\n                      AND b.status = 2\n                """\n                cursor.execute(sql_bom_head, current_parent_ids)\n                bom_heads = cursor.fetchall()\n                \n                if not bom_heads:\n                    break\n                \n                bom_ids = [bh[\'bom_id\'] for bh in bom_heads]\n                bom_head_map = {bh[\'bom_id\']: bh for bh in bom_heads}\n                \n                placeholders_boms = \',\'.join([\'%s\'] * len(bom_ids))\n                sql_bom_lines = f"""\n                    SELECT \n                        bi.bom_id,\n                        bi.component_material_id,\n                        bi.qty_per,\n                        bi.loss_rate,\n                        m.standard_cost,\n                        m.material_code,\n                        m.material_name,\n                        m.source_type\n                    FROM nova_erp.erp_bom_item bi\n                    JOIN nova_erp.erp_material m ON bi.component_material_id = m.id\n                    WHERE bi.bom_id IN ({placeholders_boms})\n                      AND m.is_deleted = 0\n                """\n                cursor.execute(sql_bom_lines, bom_ids)\n                bom_lines = cursor.fetchall()\n                \n                next_parent_ids = []\n                for line in bom_lines:\n                    component_mat_id = line[\'component_material_id\']\n                    \n                    base_qty = bom_head_map[line[\'bom_id\']][\'base_qty\']\n                    yield_rate = bom_head_map[line[\'bom_id\']][\'yield_rate\']\n                    \n                    effective_qty_per = line[\'qty_per\'] / (base_qty if base_qty != 0 else 1)\n                    loss_factor = 1 + (line[\'loss_rate\'] / 100.0)\n                    yield_factor = 1 / (yield_rate / 100.0) if yield_rate > 0 else 1\n                    \n                    unit_cost = float(line[\'standard_cost\']) if line[\'standard_cost\'] is not None else 0.0\n                    \n                    cost_contribution = effective_qty_per * loss_factor * yield_factor * unit_cost\n                    \n                    all_bom_items.append({\n                        \'parent_material_id\': bom_head_map[line[\'bom_id\']][\'parent_material_id\'],\n                        \'component_material_id\': component_mat_id,\n                        \'component_material_code\': line[\'material_code\'],\n                        \'component_material_name\': line[\'material_name\'],\n                        \'source_type\': line[\'source_type\'],\n                        \'unit_cost\': unit_cost,\n                        \'cost_contribution\': cost_contribution\n                    })\n                    \n                    if line[\'source_type\'] == 1:\n                        next_parent_ids.append(component_mat_id)\n                \n                current_parent_ids = list(set(next_parent_ids))\n            \n            total_costs_by_product = {}\n            details_by_product = {}\n            \n            for item in all_bom_items:\n                parent_mat_id = item[\'parent_material_id\']\n                if parent_mat_id in material_map:\n                    prod_code = material_map[parent_mat_id][\'product_code\']\n                    if prod_code not in total_costs_by_product:\n                        total_costs_by_product[prod_code] = 0.0\n                        details_by_product[prod_code] = []\n                    \n                    total_costs_by_product[prod_code] += item[\'cost_contribution\']\n                    details_by_product[prod_code].append(item)\n            \n            print(f"{\'Product Code\':<15} | {\'Product Name\':<30} | {\'Unit Material Cost\':<20}")\n            print("-" * 70)\n            for p in products:\n                pc = p[\'product_code\']\n                pn = p[\'product_name\']\n                uc = total_costs_by_product.get(pc, 0.0)\n                print(f"{pc:<15} | {pn:<30} | {uc:.4f}")\n            \n            handoff_result = {\n                \'product_unit_costs\': {k: v for k, v in total_costs_by_product.items()}\n            }\n            print(\'__HANDOFF__\' + json.dumps(handoff_result))\n\ncursor.close()\nconn.rollback()\nconn.close()\n```\n【执行报错】:\nError: TypeError: Connection.cursor() g