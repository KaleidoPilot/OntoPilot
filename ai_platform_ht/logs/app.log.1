({placeholders}) AND is_deleted = 0\n        """\n        cursor.execute(sql_products, tuple(skus))\n        products_rows = cursor.fetchall()\n        \n        product_info_list = []\n        for p in products_rows:\n            product_info_list.append({\n                "product_id": int(p[0]),\n                "product_code": p[1],\n                "product_name": p[2],\n                "sale_price": float(p[3]) if p[3] is not None else 0.0,\n                "unit": p[4]\n            })\n            \n        handoff_data = {\n            "customer_code": customer_code,\n            "product_info": product_info_list\n        }\n        \n        print(f"Customer Code: {customer_code}")\n        print("Products found:")\n        for item in product_info_list:\n            print(item)\n            \nexcept Exception as e:\n    print(f"Error: {e}")\n    handoff_data = {\n        "customer_code": None,\n        "product_info": []\n    }\nfinally:\n    conn.rollback()\n    cursor.close()\n    conn.close()\n\nprint(\'__HANDOFF__\' + json.dumps(handoff_data))\n```\n**执行结果**:\n```text\nCustomer Code: CUS0006\nProducts found:\n```\n\n### 步骤 2: 步骤2：根据商品关联的物料ID，递归查询BOM结构及子件物料的标准成本，计算单个成品的物料总成本（单位用量×子件标准成本，考虑损耗率）\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection is not available")\n\ncursor = conn.cursor()\n\nhandoff_data = _HANDOFF_508aeda04a\nproduct_codes = [p[\'product_code\'] for p in handoff_data.get(\'product_info\', [])]\n\nif not product_codes:\n    print("No products found in handoff data")\nelse:\n    placeholders = \',\'.join([\'%s\'] * len(product_codes))\n    \n    sql_products = f"""\n        SELECT \n            id,\n            product_code,\n            product_name\n        FROM nova_erp.erp_product\n        WHERE product_code IN ({placeholders})\n    """\n    cursor.execute(sql_products, product_codes)\n    products_rows = cursor.fetchall()\n    \n    if not products_rows:\n        print("No matching products found in ERP")\n    else:\n        products = []\n        for row in products_rows:\n            products.append({\n                \'id\': row[0],\n                \'product_code\': row[1],\n                \'product_name\': row[2]\n            })\n        \n        product_ids = [p[\'id\'] for p in products]\n        \n        sql_materials = f"""\n            SELECT \n                m.id,\n                m.material_code,\n                m.material_name,\n                m.product_id,\n                p.product_code,\n                p.product_name\n            FROM nova_erp.erp_material m\n            JOIN nova_erp.erp_product p ON m.product_id = p.id\n            WHERE m.product_id IN ({\',\'.join([\'%s\'] * len(product_ids))})\n              AND m.is_deleted = 0\n        """\n        cursor.execute(sql_materials, product_ids)\n        materials_rows = cursor.fetchall()\n        \n        if not materials_rows:\n            print("No materials linked to the requested products")\n        else:\n            material_map = {}\n            top_level_material_ids = []\n            \n            for row in materials_rows:\n                mat_id = row[0]\n                mat_code = row[1]\n                mat_name = row[2]\n                prod_id = row[3]\n                prod_code = row[4]\n                prod_name = row[5]\n                \n                material_map[mat_id] = {\n                    \'product_code\': prod_code,\n                    \'product_name\': prod_name,\n                    \'material_code\': mat_code,\n                    \'material_name\': mat_name\n                }\n                top_level_material_ids.append(mat_id)\n            \n            all_bom_items = []\n            current_parent_ids = list(set(top_level_material_ids))\n            \n            while current_parent_ids:\n                placeholders_current = \',\'.join([\'%s\'] * len(current_parent_ids))\n                \n                sql_bom_head = f"""\n                    SELECT \n                        b.id,\n                        b.material_id,\n                        b.base_qty,\n                        b.yield_rate\n                    FROM nova_erp.erp_bom b\n                    WHERE b.material_id IN ({placeholders_current})\n                      AND b.status = 2\n                """\n                cursor.execute(sql_bom_head, current_parent_ids)\n                bom_heads_rows = cursor.fetchall()\n                \n                if not bom_heads_rows:\n                    break\n                \n                bom_heads = []\n                for row in bom_heads_rows:\n                    bom_heads.append({\n                        \'bom_id\': row[0],\n                        \'parent_material_id\': row[1],\n                        \'base_qty\': float(row[2]) if row[2] is not None else 1.0,\n                        \'yield_rate\': float(row[3]) if row[3] is not None else 100.0\n                    })\n                \n                bom_ids = [bh[\'bom_id\'] for bh in bom_heads]\n                bom_head_map = {bh[\'bom_id\']: bh for bh in bom_heads}\n                \n                placeholders_boms = \',\'.join([\'%s\'] * len(bom_ids))\n                sql_bom_lines = f"""\n                    SELECT \n                        bi.bom_id,\n                        bi.component_material_id,\n                        bi.qty_per,\n                        bi.loss_rate,\n                        m.standard_cost,\n                        m.material_code,\n                        m.material_name,\n                        m.source_type\n                    FROM nova_erp.erp_bom_item bi\n                    JOIN nova_erp.erp_material m ON bi.component_material_id = m.id\n                    WHERE bi.bom_id IN ({placeholders_boms})\n                      AND m.is_deleted = 0\n                """\n                cursor.execute(sql_bom_lines, bom_ids)\n                bom_lines_rows = cursor.fetchall()\n                \n                next_parent_ids = []\n                for row in bom_lines_rows:\n                    bom_id = row[0]\n                    component_mat_id = row[1]\n                    qty_per = float(row[2]) if row[2] is not None else 0.0\n                    loss_rate = float(row[3]) if row[3] is not None else 0.0\n                    standard_cost = float(row[4]) if row[4] is not None else 0.0\n                    mat_code = row[5]\n                    mat_name = row[6]\n                    source_type = row[7]\n                    \n                    bh = bom_head_map[bom_id]\n                    base_qty = bh[\'base_qty\']\n                    yield_rate = bh[\'yield_rate\']\n                    \n                    effective_qty_per = qty_per / (base_qty if base_qty != 0 else 1.0)\n                    loss_factor = 1 + (loss_rate / 100.0)\n                    yield_factor = 1 / (yield_rate / 100.0) if yield_rate > 0 else 1.0\n                    \n                    cost_contribution = effective_qty_per * loss_factor * yield_factor * standard_cost\n                    \n                    all_bom_items.append({\n                        \'parent_material_id\': bh[\'parent_material_id\'],\n                        \'component_material_id\': component_mat_id,\n                        \'component_material_code\': mat_code,\n                        \'component_material_name\': mat_name,\n                        \'source_type\': source_type,\n                        \'unit_cost\': standard_cost,\n                        \'cost_contribution\': cost_contribution\n                    })\n                    \n                    if source_type == 1:\n                        next_parent_ids.append(component_mat_id)\n                \n                current_parent_ids = list(set(next_parent_ids))\n            \n            total_costs_by_product = {}\n            \n            for item in all_bom_items:\n                parent_mat_id = item[\'parent_material_id\']\n                if parent_mat_id in material_map:\n                    prod_code = material_map[parent_mat_id][\'product_code\']\n                    if prod_code not in total_costs_by_product:\n                        total_costs_by_product[prod_code] = 0.0\n                    \n                    total_costs_by_product[prod_code] += item[\'cost_contribution\']\n            \n            print(f"{\'Product Code\':<15} | {\'Product Name\':<30} | {\'Unit Material Cost\':<20}")\n            print("-" * 70)\n            for p in products:\n                pc = p[\'product_code\']\n                pn = p[\'product_name\']\n                uc = total_costs_by_product.get(pc, 0.0)\n                print(f"{pc:<15} | {pn:<30} | {uc:.4f}")\n            \n            handoff_result = {\n                \'product_unit_costs\': {k: float(v) for k, v in total_costs_by_product.items()}\n            }\n            print(\'__HANDOFF__\' + json.dumps(handoff_result))\n\ncursor.close()\nconn.rollback()\nconn.close()\n```\n**执行结果**:\n```text\nNo products found in handoff data\n```\n\n### 步骤 3: 步骤3：结合订单数量（各10个），计算合同总销售价格（数量×单价）和总物料成本（数量×单位物料成本），输出最终结果\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\nconn = get_connection()\nif conn is None:\n    raise Exception("Database connection failed")\n\ncursor = conn.cursor()\n\ntry:\n    # 读取上一步传递的参数，获取客户编码和产品列表\n    handoff_data = _HANDOFF_508aeda04a\n    customer_code = handoff_data.get(\'customer_code\')\n    product_info = handoff_data.get(\'product_info\', [])\n    \n    if not product_info:\n        print("未找到产品信息，无法计算成本与售价。")\n    else:\n        results = []\n        \n        for item in product_info:\n            product_code = item[\'product_code\']\n            quantity = float(item[\'quantity\'])\n            \n            # 1. 查询销售单价 (从 erp_product 表)\n            sql_price = """\n                SELECT sale_price \n                FROM nova_erp.erp_product \n                WHERE product_code = %s AND is_deleted = 0\n            """\n            cursor.execute(sql_price, (product_code,))\n            row_price = cursor.fetchone()\n            \n            if not row_price or row_price[0] is None:\n                unit_sale_price = 0.0\n            else:\n                unit_sale_price = float(row_price[0])\n            \n            # 2. 查询物料成本 (从 erp_material 表)\n            # 规则：产品成本以物料成本为准。通常成品对应一个物料记录。\n            # 通过 product_id 关联 erp_material 查找对应的物料标准成本\n            sql_cost = """\n                SELECT m.standard_cost \n                FROM nova_erp.erp_material m\n                JOIN nova_erp.erp_product p ON m.product_id = p.id\n                WHERE p.product_code = %s AND m.is_deleted = 0 AND p.is_deleted = 0\n            """\n            cursor.execute(sql_cost, (product_code,))\n            row_cost = cursor.fetchone()\n            \n            if not row_cost or row_cost[0] is None:\n                unit_material_cost = 0.0\n            else:\n                unit_material_cost = float(row_cost[0])\n            \n            # 3. 计算总价和总成本\n            total_sale_amount = quantity * unit_sale_price\n            total_material_cost = quantity * unit_material_cost\n            \n            results.append({\n                \'Product Code\': product_code,\n                \'Quantity\': quantity,\n                \'Unit Sale Price\': round(unit_sale_price, 2),\n                \'Total Sale Amount\': round(total_sale_amount, 2),\n                \'Unit Material Cost\': round(unit_material_cost, 2),\n                \'Total Material Cost\': round(total_material_cost, 2)\n            })\n        \n        # 输出结果表格\n        if results:\n            headers = [\'Product Code\', \'Quantity\', \'Unit Sale Price\', \'Total Sale Amount\', \'Unit Material Cost\', \'Total Material Cost\']\n            print(f"{\' | \'.join(headers)}")\n            print("-" * 100)\n            for r in results:\n                row_str = f"{r[\'Product Code\']} | {r[\'Quantity\']} | {r[\'Unit Sale Price\']} | {r[\'Total Sale Amount\']} | {r[\'Unit Material Cost\']} | {r[\'Total Material Cost\']}"\n                print(row_str)\n            \n            # 汇总\n            sum_sale = sum(r[\'Total Sale Amount\'] for r in results)\n            sum_cost = sum(r[\'Total Material Cost\'] for r in results)\n            print("-" * 100)\n            print(f"TOTAL SALE AMOUNT: {round(sum_sale, 2)}")\n            print(f"TOTAL MATERIAL COST: {round(sum_cost, 2)}")\n            print(f"GROSS PROFIT: {round(sum_sale - sum_cost, 2)}")\n            if sum_sale != 0:\n                gross_margin_rate = (sum_sale - sum_cost) / sum_sale * 100\n                print(f"GROSS MARGIN RATE: {round(gross_margin_rate, 2)}%")\n        else:\n            print("无有效数据输出。")\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n未找到产品信息，无法计算成本与售价。\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
