[\'unit_price\'] = sales_df[\'unit_price\'].astype(float)\n        sales_df[\'amount\'] = sales_df[\'amount\'].astype(float)\n        \n        total_sales_amount = sales_df[\'amount\'].sum()\n        \n        # 2. 计算每个产品的BOM成本\n        # 首先找出所有涉及的产品ID\n        product_ids = sales_df[\'product_id\'].unique().tolist()\n        \n        # 获取产品对应的物料ID (通过 erp_material.product_id 关联)\n        sql_mat_link = f"""\n        SELECT id as material_id, product_id, material_name, standard_cost\n        FROM nova_erp.erp_material\n        WHERE product_id IN ({\',\'.join([\'%s\']*len(product_ids))})\n          AND is_deleted = 0\n        """\n        cursor.execute(sql_mat_link, tuple(product_ids))\n        mat_link_df = pd.DataFrame(cursor.fetchall(), columns=[desc[0] for desc in cursor.description])\n        \n        # 构建 product_id -> material_id 映射，以及默认标准成本（无BOM时使用）\n        prod_to_mat = {}\n        prod_std_cost = {}\n        for _, row in mat_link_df.iterrows():\n            pid = int(row[\'product_id\'])\n            mid = int(row[\'material_id\'])\n            cost = float(row[\'standard_cost\']) if row[\'standard_cost\'] is not None else 0.0\n            prod_to_mat[pid] = mid\n            prod_std_cost[pid] = cost\n            \n        # 获取这些物料的BOM结构\n        material_ids = list(set(prod_to_mat.values()))\n        \n        bom_costs = {} # material_id -> unit_bom_cost\n        \n        if material_ids:\n            placeholders = \',\'.join([\'%s\']*len(material_ids))\n            sql_bom_header = f"""\n            SELECT id, material_id, base_qty, yield_rate\n            FROM nova_erp.erp_bom\n            WHERE material_id IN ({placeholders})\n              AND status = 2 \n              AND bom_type = 1 \n            ORDER BY effective_date DESC\n            """\n            cursor.execute(sql_bom_header, tuple(material_ids))\n            bom_headers = cursor.fetchall()\n            \n            # 为了简化，我们取每个物料最新的一个已发布BOM头\n            latest_boms = {}\n            for row in bom_headers:\n                bid, mid, bqty, yrate = row\n                if mid not in latest_boms:\n                    latest_boms[mid] = {\n                        \'bom_id\': bid,\n                        \'base_qty\': float(bqty),\n                        \'yield_rate\': float(yrate) if yrate else 100.0\n                    }\n            \n            if latest_boms:\n                bom_ids = [v[\'bom_id\'] for v in latest_boms.values()]\n                bom_placeholders = \',\'.join([\'%s\']*len(bom_ids))\n                sql_bom_items = f"""\n                SELECT bi.bom_id, bi.component_material_id, bi.qty_per, bi.loss_rate, m.standard_cost\n                FROM nova_erp.erp_bom_item bi\n                JOIN nova_erp.erp_material m ON bi.component_material_id = m.id\n                WHERE bi.bom_id IN ({bom_placeholders})\n                  AND m.is_deleted = 0\n                """\n                cursor.execute(sql_bom_items, tuple(bom_ids))\n                bom_items = cursor.fetchall()\n                \n                # 计算每个BOM头的单位成本\n                bom_unit_costs = {}\n                for row in bom_items:\n                    bid, comp_mid, qty_per, loss_rate, std_cost = row\n                    qty_per = float(qty_per)\n                    loss_rate = float(loss_rate) if loss_rate else 0.0\n                    std_cost = float(std_cost) if std_cost else 0.0\n                    \n                    # 实际用量 = 单位用量 * (1 + 损耗率/100)\n                    actual_usage = qty_per * (1 + loss_rate / 100.0)\n                    line_cost = actual_usage * std_cost\n                    \n                    if bid not in bom_unit_costs:\n                        bom_unit_costs[bid] = 0.0\n                    bom_unit_costs[bid] += line_cost\n                \n                # 将BOM成本映射回 material_id，并考虑良率\n                for mid, info in latest_boms.items():\n                    bid = info[\'bom_id\']\n                    raw_cost = bom_unit_costs.get(bid, 0.0)\n                    yield_factor = info[\'yield_rate\'] / 100.0\n                    if yield_factor > 0:\n                        final_cost = raw_cost / yield_factor\n                    else:\n                        final_cost = raw_cost\n                    bom_costs[mid] = final_cost\n        \n        # 3. 合并计算订单总成本\n        # 对于没有BOM或BOM成本为0的，使用标准成本；如果都没有则为0\n        def get_unit_cost(pid):\n            mid = prod_to_mat.get(pid)\n            if mid and mid in bom_costs and bom_costs[mid] > 0:\n                return bom_costs[mid]\n            elif pid in prod_std_cost:\n                return prod_std_cost[pid]\n            else:\n                return 0.0\n        \n        sales_df[\'unit_cost\'] = sales_df[\'product_id\'].apply(get_unit_cost)\n        sales_df[\'total_cost\'] = sales_df[\'quantity\'] * sales_df[\'unit_cost\']\n        \n        total_order_cost = sales_df[\'total_cost\'].sum()\n        \n        # 4. 计算毛利率\n        gross_profit = total_sales_amount - total_order_cost\n        gross_margin_rate = (gross_profit / total_sales_amount * 100) if total_sales_amount != 0 else 0.0\n        \n        # 5. 输出汇总结果\n        summary_data = {\n            "指标": ["销售总额", "订单总成本", "毛利额", "毛利率(%)"],\n            "数值": [round(total_sales_amount, 2), round(total_order_cost, 2), round(gross_profit, 2), round(gross_margin_rate, 2)]\n        }\n        summary_df = pd.DataFrame(summary_data)\n        print("--- 华信健康订单财务汇总 ---")\n        print(summary_df.to_string(index=False))\n        \n        # 6. 输出物料详情明细\n        detail_df = sales_df[[\'order_no\', \'product_code\', \'product_name\', \'quantity\', \'unit_price\', \'amount\', \'unit_cost\', \'total_cost\']].copy()\n        detail_df.columns = [\'订单号\', \'商品编码\', \'商品名称\', \'数量\', \'成交单价\', \'行金额\', \'单位成本\', \'行总成本\']\n        \n        # 格式化浮点数显示\n        for col in [\'成交单价\', \'行金额\', \'单位成本\', \'行总成本\']:\n            detail_df[col] = detail_df[col].apply(lambda x: f"{x:.2f}")\n            \n        print("\\n--- 订单物料详情明细 ---")\n        print(detail_df.to_string(index=False))\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n--- 华信健康订单财务汇总 ---\n    指标         数值\n  销售总额 1126887.04\n 订单总成本   27452.97\n   毛利额 1099434.07\n毛利率(%)      97.56\n\n--- 订单物料详情明细 ---\n           订单号    商品编码           商品名称  数量      成交单价       行金额     单位成本     行总成本\nSO202607140001 SKU0031 六轴工业机器人 六轴-729 1.0 217832.00 206940.40 27452.97 27452.97\nSO202607140001 SKU0035  现场实施服务 现场-153 2.0 499971.00 919946.64     0.00     0.00\n```\n\n\n请遵循系统设定的主技能规则口径，依据上述执行结果，用通俗易懂的语言给业务用户一份最终 Markdown 总结：\n1. 屏蔽所有技术细节（SQL、表名、代码、字段名一律不出现）；\n2. 若包含多个执行单元，先分单元给出核心结论，再进行整体综合分析与建议；\n3. 若某单元无有效结果或执行失败，如实简要说明，不要编造数据；\n4. 【数据一律表格化】凡是指标、数值、排行、对比、分类汇总、明细清单这类数据，一律用 Markdown 表格呈现，不要写成大段文字或纯项目符号；表格必须有表头，数值列标注单位与统计口径（时间范围、分组维度、币种等），小数位与执行结果精度保持一致，空值/缺失值明确写“无数据”，不得留空或擅自补 0；\n5. 【分析类必须给出数据依据】先给核心指标的数值与对比基准（同比/环比/占比/目标值），再说明样本量与覆盖范围（时间跨度、记录条数、覆盖客户/合同/产品数量），对异常值、极值、缺失项单独说明可能原因；既不能只给结论不给数据，也不能只堆明细不做归纳；\n6. 明细较多时，先给按关键维度聚合的汇总表，再补 Top N 或代表性明细，并注明筛选、排序与聚合口径，避免把原始明细逐行罗列；\n7. 篇幅不设上限：执行结果里的数据、结论、异常项、原因分析和建议都要完整写出，不得为了控制长度而压缩、省略、只列要点或写“详见上文”；宁可写得长也不遗漏关键信息。\n以上关于完整性与数据呈现的要求优先于其他任何“简洁/精简/控制字数”的设定。'}], 'model': 'qwen3.8-flash', 'stream': True, 'temperature': 0.7}, 'extra_json': {'enable_thinking': False}}
