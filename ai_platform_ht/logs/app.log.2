SELECT
  agent.ID AS id,
  agent.AGENT_NAME AS agentName,
  agent.AGENT_DESCRIPTION AS agentDescription,
  agent.`KEY` AS agentKey
FROM USER_GROUP user_group
INNER JOIN AI_AGENT agent
  ON agent.ORG_ID = user_group.ORG_ID
  AND FIND_IN_SET(CAST(agent.ID AS CHAR), user_group.AGENT_ID) > 0
