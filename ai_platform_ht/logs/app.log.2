: ["S8", "S1", "S2", "S3", "S4"]}, {"id": "智能制造执行系统(MES)开发及实施合同", "label": "智能制造执行系统(MES)开发及实施合同", "type": "content", "description": "本合同中的保理融资业务基于甲方与星海智能装备制造有限公司签订的《智能制造执行系统(MES)开发及实施合同》(C1合同)项下的应收账款。<SEP>合同编号为XH-ZB-2026-RJ-001，由星海智能装备制造有限公司与云启数据服务有限公司于2026年3月16日签订，约定了MES系统的开发、实施、验收及运维事宜。", "sourceIds": ["S5", "S3"]}, {"id": "设备运输及仓储配送服务合同", "label": "设备运输及仓储配送服务合同", "type": "content", "description": "合同编号为YQ-WL-2026-004，由云启数据服务有限公司、联达物流有限公司和中信商业保理有限公司于2026年7月15日在上海市徐汇区签订。该合同约定了乙方为甲方提供运输、仓储、配送等服务，以及丙方基于C1合同应收账款向甲方提供保理融资的安排。", "sourceIds": ["S5"]}, {"id": "星海智能产业园二期B1、B2厂房建设总承包合同", "label": "星海智能产业园二期B1、B2厂房建设总承包合同", "type": "content", "description": "合同编号为XH-JS-2026-SG-002，由星海智能科技集团有限公司与恒通建筑工程有限公司于2026年4月8日在江苏省苏州工业园区签订。<SEP>合同编号XH-JS-2026-SG-002，简称\\"C2合同”，由星海集团与恒通建筑工程有限公司于2026年4月8日签订。", "sourceIds": ["S1", "S2"]}, {"id": "恒通建筑工程有限公司", "label": "恒通建筑工程有限公司", "type": "organization", "description": "本合同的承包人(乙方)，具有房屋建筑工程施工总承包一级资质，统一社会信用代码91330106MA2GH5K3T7，住所地杭州市西湖区文二路391号，法定代表人郑国强。<SEP>本合同的买方(甲方)，法定代表人郑国强，联系人王海涛。作为乙方的关联方，已履行内部审批程序并向C2合同发包方披露关联交易。<SEP>本合同的买方(甲方)，统一社会信用代码91330106MA2GH5K3T7，住所地杭州市西湖区文二路391号。该公司已中标承接星海智能产业园二期建设总承包工程，并作为关联方与乙方签订合同。<SEP>本分包合同的总承包单位(见证方)，统一社会信用代码91330106MA2GH5K3T7，住所地杭州市西湖区文二路391号，负责承建B1、B2厂房及配套工程。<SEP>总承包单位(见证方)，签署日期为2026年6月3日。", "sourceIds": ["S7", "S8", "S1", "S2"]}, {"id": "云启数据服务有限公司", "label": "云启数据服务有限公司", "type": "organization", "description": "本合同中的甲方，托运人，负责支付服务费用、提供货物信息、进行服务考核及披露关联关系。<SEP>本合同的乙方(开发方)，统一社会信用代码91310104MA1FR9W6L8，住所地上海市徐汇区宜山路700号3号楼12层，具备工业软件研发与实施服务能力。<SEP>本合同的乙方，位于上海市徐汇区宜山路700号3号楼12层，联系人林小满，负责系统开发、缺陷修复、运维服务及遵守保密和廉洁承诺。<SEP>C1合同乙方，MES系统实施方，需配合乙方完成数据采集联调。<SEP>MES系统实施方，乙方需配合其完成数据采集联调，时间不少于10个工作日。", "sourceIds": ["S5", "S6", "S3", "S4"]}, {"id": "联达物流有限公司", "label": "联达物流有限公司", "type": "organization", "description": "本合同中的乙方，承运人，负责提供安全及时的服务、保管货物、投保责任险及接受服务考核。", "sourceIds": ["S5", "S6"]}, {"id": "中信商业保理有限公司", "label": "中信商业保理有限公司", "type": "organization", "description": "本合同中的丙方，保理人，负责审批保理业务、按约定放款及履行关联交易审查程序。", "sourceIds": ["S5", "S6"]}, {"id": "中华人民共和国法律", "label": "中华人民共和国法律", "type": "concept", "description": "本合同适用的法律依据，争议解决时优先适用。<SEP>本合同订立、效力、解释、履行及争议解决适用的法律体系。<SEP>本合同适用的法律依据。", "sourceIds": ["S6"]}, {"id": "本合同", "label": "本合同", "type": "UNKNOWN", "description": "保密义务自本合同签订之日起生效，至合同终止或解除后5年止(特定技术秘密除外)。", "sourceIds": []}, {"id": "硬件资源配置清单", "label": "硬件资源配置清单", "type": "content", "description": "合同附件二，列明了现有硬件条件，用于评估系统并发用户数及响应时间等性能指标。<SEP>附件二，列明硬件资源，是合同不可分割组成部分。", "sourceIds": ["S3"]}, {"id": "缺陷分级与响应时限表", "label": "缺陷分级与响应时限表", "type": "content", "description": "合同附件三，定义了致命、严重、一般、轻微四级缺陷的具体分级标准。<SEP>附件三，定义致命、严重、一般、轻微缺陷的响应和修复时限及升级机制。", "sourceIds": ["S3"]}, {"id": "保密期限", "label": "保密期限", "type": "data", "description": "自合同签订起至终止后5年止；涉及生产工艺参数等技术秘密不受此限，直至进入公有领域。", "sourceIds": []}, {"id": "不可抗力", "label": "不可抗力", "type": "concept", "description": "指不能预见、避免且克服的客观情况，包括自然灾害、战争、疫情等，持续超90日任一方可解除合同并互不承担违约责任。<SEP>不能预见、避免且克服的客观情况，导致工期顺延，持续超过60日任何一方可解除合同。", "sourceIds": []}, {"id": "书面变更协议", "label": "书面变更协议", "type": "content", "description": "合同变更必须签署的文件，口头、邮件或会议纪要未经书面确认不构成变更。", "sourceIds": []}, {"id": "合同解除后的处理", "label": "合同解除后的处理", "type": "UNKNOWN", "description": "合同解除后，依据该规则认定已完成工作量，甲方据此支付相应价款。", "sourceIds": []}, {"id": "已完成工作量认定规则", "label": "已完成工作量认定规则", "type": "method", "description": "以已确认里程碑为基础，未到部分按实际比例协商或委托第三方评估，用于合同解除后的结算。", "sourceIds": []}, {"id": "项目开发范围清单", "label": "项目开发范围清单", "type": "content", "description": "附件一，列明功能点清单，是合同不可分割组成部分。", "sourceIds": []}, {"id": "人力单价表", "label": "人力单价表", "type": "content", "description": "附件四，列明人力成本单价，是合同不可分割组成部分。", "sourceIds": []}, {"id": "项目里程碑计划甘特图", "label": "项目里程碑计划甘特图", "type": "content", "description": "附件五，展示项目进度计划，是合同不可分割组成部分。", "sourceIds": []}, {"id": "保密协议", "label": "保密协议", "type": "content", "description": "附件六，规定保密期限(合同终止后5年，技术秘密无限期)、禁止用途及违约金50万元。", "sourceIds": []}, {"id": "李伟东", "label": "李伟东", "type": "person", "description": "乙方的监事，同时担任甲方的法定代表人，其双重身份构成合同项下的关联关系。<SEP>云启数据服务有限公司的法定代表人。", "sourceIds": ["S5", "S6", "S3"]}, {"id": "廉洁承诺书", "label": "廉洁承诺书", "type": "content", "description": "附件七，禁止商业贿赂、串通报价，违者甲方可解约、收20%违约金并列入黑名单三年。", "sourceIds": []}, {"id": "星海智能产业园二期项目", "label": "星海智能产业园二期项目", "type": "event", "description": "位于江苏省苏州工业园区星湖街以东、星海路以南地块的建设工程项目，总建筑面积35,000平方米，包含B1、B2厂房及配套工程。", "sourceIds": ["S1"]}, {"id": "吴倩", "label": "吴倩", "type": "person", "description": "乙方(联达物流有限公司)的联系人，电话021-6725 ****，邮箱wuqian@lianda-logistics.com。", "sourceIds": ["S5", "S6"]}, {"id": "何志远", "label": "何志远", "type": "person", "description": "丙方(中信商业保理有限公司)的联系人，电话0755-8899 ****，邮箱hezy@citic-factoring.com。", "sourceIds": ["S5", "S6"]}, {"id": "林小满", "label": "林小满", "type": "person", "description": "甲方(云启数据服务有限公司)的联系人，电话021-5432 ****，邮箱linxm@yunqi-data.com。<SEP>云启数据服务有限公司的项目经理，负责乙方项目组的管理工作。<SEP>云启数据服务有限公司指定的联系人，电子邮箱为linxm@yunqi-data.com。", "sourceIds": ["S5", "S6", "S3"]}, {"id": "苏州工业园区星湖街218号星海智能产业园二期B1厂房", "label": "苏州工业园区星湖街218号星海智能产业园二期B1厂房", "type": "UNKNOWN", "description": "该地点被定义为“项目实施地”，是货物运输的最终目的地及园区内配送的目标区域。", "sourceIds": ["S5"]}, {"id": "友好协商", "label": "友好协商", "type": "method", "description": "争议解决的首选方式，协商不成可向甲方所在地法院起诉。", "sourceIds": []}, {"id": "C2合同", "label": "C2合同", "type": "content", "description": "涉及星海智能科技集团有限公司的项目合同，本次交易被认定为该项目的关联交易并进行了披露备案。<SEP>指代“星海智能产业园二期B1、B2厂房建设总承包工程”及其相关合同文件，是本次采购货物所服务的具体工程项目依据。", "sourceIds": ["S7", "S8"]}, {"id": "钢结构及新型墙体材料采购合同", "label": "钢结构及新型墙体材料采购合同", "type": "content", "description": "合同编号为HT-CG-2026-017，由恒通建筑工程有限公司与瑞泽新材料有限公司于2026年4月22日在浙江省杭州市签订。该合同总价为人民币12,450,000.00元，约定采购钢结构构件与ALC轻质隔墙板，专用于星海智能产业园二期B1、B2厂房工程。<SEP>合同编号HT-CG-2026-017，简称C3合同，甲方已收到其项下首期货款，作为本合同首期款项资金来源依据。", "sourceIds": ["S7", "S4"]}, {"id": "复合材料自动化生产线采购合同", "label": "复合材料自动化生产线采购合同", "type": "content", "description": "合同编号为RZ-SB-2026-009，由瑞泽新材料有限公司与星海智能装备制造有限公司签订，郑国强提供担保，约定设备总价680万元及分期支付、验收标准等条款。", "sourceIds": ["S4"]}, {"id": "智能制造执行系统建设合同", "label": "智能制造执行系统建设合同", "type": "content", "description": "合同编号XH-ZB-2026-RJ-001，简称C1合同，涉及MES系统建设，要求本合同设备控制系统与其实现数据对接。", "sourc