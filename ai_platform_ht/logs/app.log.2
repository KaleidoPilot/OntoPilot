rder_date) = 2026\n      AND so.status != \'cancelled\'\n    GROUP BY c.id, c.code, c.name\n    ORDER BY total_sales DESC\n    """\n    cursor.execute(sql_customer_stats)\n    customer_stats_rows = cursor.fetchall()\n    \n    df_customer_stats = pd.DataFrame(customer_stats_rows)\n    \n    if not df_customer_stats.empty:\n        # 计算客户集中度：Top N占比\n        total_sales_all = df_customer_stats[\'total_sales\'].sum()\n        df_customer_stats[\'sales_share\'] = (df_customer_stats[\'total_sales\'] / total_sales_all * 100).round(2)\n        \n        # Top 3 客户集中度\n        top3_sales = df_customer_stats.head(3)[\'total_sales\'].sum()\n        top3_concentration = round(top3_sales / total_sales_all * 100, 2) if total_sales_all > 0 else 0\n        \n        print("=== 2026年客户维度分析 ===")\n        print(f"总客户数（有交易）: {len(df_customer_stats)}")\n        print(f"总销售额: {total_sales_all:.2f}")\n        print(f"Top 3 客户集中度: {top3_concentration}%")\n        print("\\n--- 各客户订单统计 ---")\n        print(df_customer_stats[[\'customer_code\', \'customer_name\', \'order_count\', \'total_sales\', \'avg_order_value\', \'sales_share\']].to_string(index=False))\n    else:\n        print("=== 2026年客户维度分析 ===")\n        print("无有效交易数据")\n        df_customer_stats = pd.DataFrame()\n        top3_concentration = 0\n    \n    # 2. 获取客户建档时间与首/末交易时间，分析活跃与沉睡客户分布\n    sql_customer_activity = """\n    SELECT \n        c.id AS customer_id,\n        c.code AS customer_code,\n        c.name AS customer_name,\n        c.created_at AS registration_date,\n        MIN(so.order_date) AS first_order_date,\n        MAX(so.order_date) AS last_order_date,\n        COUNT(so.id) AS order_count,\n        SUM(so.total_amount) AS total_sales\n    FROM virtual_erp.customers c\n    LEFT JOIN virtual_erp.sales_orders so ON c.id = so.customer_id\n        AND YEAR(so.order_date) = 2026\n        AND so.status != \'cancelled\'\n    GROUP BY c.id, c.code, c.name, c.created_at\n    ORDER BY last_order_date DESC NULLS LAST\n    """\n    cursor.execute(sql_customer_activity)\n    activity_rows = cursor.fetchall()\n    \n    df_activity = pd.DataFrame(activity_rows)\n    \n    if not df_activity.empty:\n        # 判断活跃与沉睡客户\n        # 假设：最近90天内有交易为活跃，超过90天无交易或从未交易为沉睡\n        from datetime import datetime, timedelta\n        current_date = datetime(2026, 10, 23)\n        threshold_date = current_date - timedelta(days=90)\n        \n        def classify_customer(row):\n            if row[\'last_order_date\'] is None:\n                return \'沉睡（无交易记录）\'\n            try:\n                last_date = row[\'last_order_date\']\n                if isinstance(last_date, str):\n                    last_date = datetime.strptime(last_date, \'%Y-%m-%d\')\n                elif hasattr(last_date, \'date\'):\n                    last_date = datetime.combine(last_date.date(), datetime.min.time())\n                \n                if last_date >= threshold_date:\n                    return \'活跃\'\n                else:\n                    return \'沉睡（超90天无交易）\'\n            except Exception:\n                return \'未知\'\n        \n        df_activity[\'activity_status\'] = df_activity.apply(classify_customer, axis=1)\n        \n        active_count = len(df_activity[df_activity[\'activity_status\'] == \'活跃\'])\n        dormant_no_trade = len(df_activity[df_activity[\'activity_status\'] == \'沉睡（无交易记录）\'])\n        dormant_overdue = len(df_activity[df_activity[\'activity_status\'] == \'沉睡（超90天无交易）\'])\n        \n        print("\\n--- 客户活跃度分析 ---")\n        print(f"活跃客户数: {active_count}")\n        print(f"沉睡客户数（无交易记录）: {dormant_no_trade}")\n        print(f"沉睡客户数（超90天无交易）: {dormant_overdue}")\n        print(f"总客户数: {len(df_activity)}")\n        print("\\n--- 客户交易时间明细 ---")\n        display_cols = [\'customer_code\', \'customer_name\', \'registration_date\', \'first_order_date\', \'last_order_date\', \'order_count\', \'total_sales\', \'activity_status\']\n        print(df_activity[display_cols].to_string(index=False))\n    else:\n        print("\\n--- 客户活跃度分析 ---")\n        print("无客户数据")\n        df_activity = pd.DataFrame()\n        active_count = 0\n        dormant_no_trade = 0\n        dormant_overdue = 0\n    \n    # 准备传递给后续步骤的数据\n    # 提取活跃客户ID列表和沉睡客户ID列表，供后续步骤使用\n    active_customer_ids = []\n    dormant_customer_ids = []\n    \n    if not df_activity.empty and \'activity_status\' in df_activity.columns:\n        active_mask = df_activity[\'activity_status\'] == \'活跃\'\n        dormant_mask = df_activity[\'activity_status\'].str.contains(\'沉睡\', na=False)\n        active_customer_ids = df_activity.loc[active_mask, \'customer_id\'].tolist()\n        dormant_customer_ids = df_activity.loc[dormant_mask, \'customer_id\'].tolist()\n    \n    # 确保所有值都是JSON可序列化的\n    handoff_result = {\n        \'active_customer_ids\': [int(x) for x in active_customer_ids],\n        \'dormant_customer_ids\': [int(x) for x in dormant_customer_ids],\n        \'top3_concentration\': float(top3_concentration),\n        \'total_active_customers\': int(active_count),\n        \'total_dormant_customers\': int(dormant_no_trade + dormant_overdue)\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_result))\n\nfinally:\n    if \'cursor\' in locals():\n        cursor.close()\n    if \'conn\' in locals():\n        conn.rollback()\n        conn.close()\n```\n【执行报错】:\nError: TypeError: Connection.cursor() got an unexpected keyword argument \'dictionary\'\n\n请仔细分析报错原因并修复代码。注意：\n1. 如果是 SQL 语法或字段找不到错误，请检查 JOIN 条件、表别名或使用的数据表字段名是否正确。\n2. 如果是 Pandas 数据处理报错，请检查 DataFrame 的类型或缺失值。\n3. 如果是 __HANDOFF__ 打印报错（如 json 序列化失败），请只放入可 JSON 序列化的简单参数（int/float/str/列表），并把 DataFrame 等对象排除在外。\n4. 如果报错涉及 decimal.Decimal 与 float 混算（unsupported operand type(s) for /: \'float\' and \'decimal.Decimal\'），说明 MySQL 的 DECIMAL 列或 SUM/AVG 聚合结果返回的是 Decimal，必须在参与除法、百分比等运算前显式 float() 转换；round() 之后也要 float() 才能被 json.dumps 序列化。\n5. 如果提示“无输出”，说明代码执行完没有 print 任何内容。请补上 print(...)，把本步结果（如 df.to_string(index=False) 或关键数值）以纯文本打印出来，否