n            SUM(p.stock_qty) AS total_stock_qty,\n            SUM(p.stock_qty * p.cost_price) AS total_cost_amount,\n            SUM(p.safety_stock) AS total_safety_stock,\n            AVG(p.cost_price) AS avg_cost_price\n        FROM virtual_erp.products p\n        WHERE p.status = 1\n        GROUP BY p.category\n        ORDER BY total_cost_amount DESC\n    """\n    cursor.execute(sql_inventory_by_category)\n    rows_inv_cat = cursor.fetchall()\n    cols_inv_cat = [desc[0] for desc in cursor.description]\n    df_inv_cat = pd.DataFrame(rows_inv_cat, columns=cols_inv_cat)\n\n    # 2. 获取所有在售商品的详细信息，用于计算动销率\n    sql_products_detail = """\n        SELECT \n            p.id,\n            p.sku,\n            p.name,\n            p.category,\n            p.unit,\n            p.cost_price,\n            p.sale_price,\n            p.stock_qty,\n            p.safety_stock,\n            p.status\n        FROM virtual_erp.products p\n        WHERE p.status = 1\n    """\n    cursor.execute(sql_products_detail)\n    rows_prod = cursor.fetchall()\n    cols_prod = [desc[0] for desc in cursor.description]\n    df_products = pd.DataFrame(rows_prod, columns=cols_prod)\n\n    # 3. 获取2026年各商品的销售数量（从销售订单明细中汇总）\n    # 注意：需要关联sales_orders确保是2026年的订单，且排除已取消的订单\n    cancelled_order_nos = handoff.get(\'cancelled_order_nos_2026\', [])\n    \n    if cancelled_order_nos:\n        placeholders_cancelled = \',\'.join([\'%s\'] * len(cancelled_order_nos))\n        sql_sales_2026 = f"""\n            SELECT \n                soi.product_id,\n                SUM(soi.qty) AS sales_qty_2026\n            FROM virtual_erp.sales_order_items soi\n            INNER JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n            WHERE YEAR(so.order_date) = %s\n              AND so.order_no NOT IN ({placeholders_cancelled})\n              AND so.status != \'cancelled\'\n            GROUP BY soi.product_id\n        """\n        params_sales = [2026] + cancelled_order_nos\n    else:\n        sql_sales_2026 = """\n            SELECT \n                soi.product_id,\n                SUM(soi.qty) AS sales_qty_2026\n            FROM virtual_erp.sales_order_items soi\n            INNER JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n            WHERE YEAR(so.order_date) = %s\n              AND so.status != \'cancelled\'\n            GROUP BY soi.product_id\n        """\n        params_sales = [2026]\n\n    cursor.execute(sql_sales_2026, params_sales)\n    rows_sales = cursor.fetchall()\n    cols_sales = [desc[0] for desc in cursor.description]\n    df_sales = pd.DataFrame(rows_sales, columns=cols_sales)\n\n    # 合并商品信息与销量数据\n    df_merged = df_products.merge(df_sales, on=\'id\', how=\'left\')\n    df_merged[\'sales_qty_2026\'] = df_merged[\'sales_qty_2026\'].fillna(0).astype(int)\n\n    # 计算动销率：销量 / (销量 + 库存)\n    # 避免除以零的情况\n    df_merged[\'turnover_rate\'] = df_merged.apply(\n        lambda row: row[\'sales_qty_2026\'] / (row[\'sales_qty_2026\'] + row[\'stock_qty\']) \n        if (row[\'sales_qty_2026\'] + row[\'stock_qty\']) > 0 else 0.0, axis=1\n    )\n\n    # 计算库销比：库存 / 销量（如果销量为0则设为inf或特殊标记）\n    df_merged[\'stock_to_sales_ratio\'] = df_merged.apply(\n        lambda row: row[\'stock_qty\'] / row[\'sales_qty_2026\'] \n        if row[\'sales_qty_2026\'] > 0 else float(\'inf\'), axis=1\n    )\n\n    # 识别低效库存：动销率低于某个阈值（例如0.2）或者库存远高于安全库存且无销量\n    df_merged[\'is_low_efficiency\'] = df_merged.apply(\n        lambda row: (row[\'turnover_rate\'] < 0.2 and row[\'stock_qty\'] > row[\'safety_stock\']) or \n                    (row[\'sales_qty_2026\'] == 0 and row[\'stock_qty\'] > 0), axis=1\n    )\n\n    # 按品类汇总动销指标\n    df_category_metrics = df_merged.groupby(\'category\').agg(\n        total_sales_qty=(\'sales_qty_2026\', \'sum\'),\n        total_stock_qty=(\'stock_qty\', \'sum\'),\n        avg_turnover_rate=(\'turnover_rate\', \'mean\'),\n        low_efficiency_count=(\'is_low_efficiency\', \'sum\'),\n        total_products=(\'id\', \'count\')\n    ).reset_index()\n\n    # 整体动销率\n    total_sales = df_merged[\'sales_qty_2026\'].sum()\n    total_stock = df_merged[\'stock_qty\'].sum()\n    overall_turnover_rate = total_sales / (total_sales + total_stock) if (total_sales + total_stock) > 0 else 0.0\n\n    # 输出结果\n    print("=" * 80)\n    print("【步骤6】库存结构与动销效率分析报告")\n    print("=" * 80)\n\n    print("\\n--- 1. 按品类库存结构统计 ---")\n    if not df_inv_cat.empty:\n        print(df_inv_cat.to_string(index=False))\n    else:\n        print("无数据")\n\n    print("\\n--- 2. 各商品动销效率详情 ---")\n    # 选择关键列展示\n    display_cols = [\'sku\', \'name\', \'category\', \'stock_qty\', \'sales_qty_2026\', \'turnover_rate\', \'stock_to_sales_ratio\', \'is_low_efficiency\']\n    df_display = df_merged[display_cols].copy()\n    df_display[\'turnover_rate\'] = df_display[\'turnover_rate\'].apply(lambda x: f"{x:.2%}" if x != float(\'inf\') else "N/A")\n    df_display[\'stock_to_sales_ratio\'] = df_display[\'stock_to_sales_ratio\'].apply(lambda x: f"{x:.2f}" if x != float(\'inf\') else "∞ (无销量)")\n    df_display[\'is_low_efficiency\'] = df_display[\'is_low_efficiency\'].map({True: \'是\', False: \'否\'})\n    \n    if not df_display.empty:\n        print(df_display.to_string(index=False))\n    else:\n        print("无数据")\n\n    print("\\n--- 3. 按品类动销指标汇总 ---")\n    if not df_category_metrics.empty:\n        df_cat_disp = df_category_metrics.copy()\n        df_cat_disp[\'avg_turnover_rate\'] = df_cat_disp[\'avg_turnover_rate\'].apply(lambda x: f"{x:.2%}")\n        print(df_cat_disp.to_string(index=False))\n    else:\n        print("无数据")\n\n    print("\\n--- 4. 整体经营效率指标 ---")\n    print(f"2026年总销量: {total_sales}")\n    print(f"当前总库存量: {total_stock}")\n    print(f"整体动销率: {overall_turnover_rate:.2%}")\n    print(f"低效库存商品数量: {df_merged[\'is_low_efficiency\'].sum()}")\n    \n    # 特别关注上一步识别出的滞销品和主力品\n    print("\\n--- 5. 重点商品状态复核 ---")\n    key_ids = list(set(main_product_ids + stagnant_in_stock_product_ids))\n    df_key = df_merged[df_merged[\'id\'].isin(key_ids)][[\'sku\', \'name\', \'category\', \'stock_qty\', \'sales_qty_2026\', \'turnover_rate\', \'is_low_efficiency\']]\n    if not df_key.empty:\n        df_key_disp = df_key.copy()\n        df_key_disp[\'turnover_rate\'] = df_key_disp[\'turnover_rate\'].apply(lambda x: f"{x:.2%}")\n        df_key_disp[\'is_low_efficiency\'] = df_key_disp[\'is_low_efficiency\'].map({True: \'是\', False: \'否\'})\n        print(df_key_disp.to_string(index=False))\n    else:\n        print("无匹配的重点商品数据")\n\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n        except Exception:\n            pass\n        finally:\n            conn.close()\n```\n【执行报错】:\nError: KeyError: \'id\'\n\n请仔细分析报错原因并修复代码。注意：\n1. 如果是 SQL 语法或字段找不到错误，请检查 JOIN 条件、表别名或使用的数据表字段名是否正确。\n2. 如果是 Pandas 数据处理报错，请检查 DataFrame 的类型或缺失值。\n3. 如果是 __HANDOFF__ 打印报错（如 json 序列化失败），请只放入可 JSON 序列化的简单参数（int/float/str/列表），并把 DataFrame 等对象排除在外。\n4. 如果报错涉及 decimal.Decimal 与 float 混算（unsupported operand type(s) for /: \'float\' and \'decimal.Decimal\'），说明 MySQL 的 DECIMAL 列或 SUM/AVG 聚合结果返回的是 Decimal，必须在参与除法、百分比等运算前显式 float() 转换；round() 之后也要 float() 才能被 json.dumps 序列化。\n5. 如果提示“无输出”，说明代码执行完没有 print 任何内容。请补上 print(...)，把本步结果（如 df.to_string(index=False) 或关键数值）以纯文本打印出来，否则后续步骤和最终总结拿不到数据。\n请输出修复后的纯 Python 代码内容，不要包含任何 Markdown 标记（如 ```python 等）。'}], 'model': 'qwen3.8-flash', 'temperature': 0.3}, 'extra_json': {'enable_thinking': False}}
