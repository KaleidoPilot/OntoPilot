名空间执行，前序结果只能从任务指定的衔接字典按键获取，或重新查询。需要向后续步骤传参时，按任务要求 print(\'__HANDOFF__\'+json.dumps({...}))，仅放JSON可序列化对象。数据结果必须 print 为纯文本表格，不能只用 display 或图表；空结果如实说明。\n\n你是一个精通Python和数据处理的AI修复助手。请只输出纯Python代码。'}, {'role': 'user', 'content': '你生成的 Python 代码在沙箱中执行时发生了报错。\n【原始任务】: 步骤1：查询基础经营汇总指标，包括有效订单数、销售额、毛利额、毛利率、客单价、成交件数、库存资金占用（按成本价和销售价）、整体动销率，以及统计周期内的客户总数和有成交客户数\n【你的代码】:\n```python\nimport json\nfrom datetime import datetime\n\ndef get_erp_summary_metrics():\n    conn = None\n    cursor = None\n    try:\n        conn = get_connection()\n        cursor = conn.cursor()\n\n        # 1. 获取统计周期：取系统中最新的订单日期或库存流水日期作为截止参考，这里以销售订单最大日期为准\n        sql_max_date = "SELECT MAX(order_date) as max_order_date FROM virtual_erp.sales_orders"\n        cursor.execute(sql_max_date)\n        max_date_row = cursor.fetchone()\n        end_date = max_date_row[0] if max_date_row and max_date_row[0] else datetime.now().date()\n        \n        # 定义统计周期开始时间（今年年初）\n        start_date = datetime(end_date.year, 1, 1).date()\n\n        # 2. 核心经营指标查询\n        # 有效订单：状态不为\'取消\'的订单\n        # 销售额：有效订单的total_amount之和\n        # 订单数：有效订单数量\n        # 客户数：有有效订单的去重客户数\n        \n        sql_sales_stats = """\n        SELECT \n            COUNT(DISTINCT so.id) as valid_order_count,\n            SUM(so.total_amount) as total_sales_amount,\n            COUNT(DISTINCT so.customer_id) as active_customer_count\n        FROM virtual_erp.sales_orders so\n        WHERE so.order_date >= %s AND so.order_date <= %s\n          AND so.status != \'取消\'\n        """\n        cursor.execute(sql_sales_stats, (start_date, end_date))\n        sales_stats = cursor.fetchone()\n        \n        valid_order_count = sales_stats[0] or 0\n        total_sales_amount = float(sales_stats[1]) if sales_stats[1] else 0.0\n        active_customer_count = sales_stats[2] or 0\n\n        # 3. 计算毛利额和毛利率\n        # 毛利 = SUM( (销售单价 - 成本价) * 数量 )\n        # 需要关联 sales_order_items 和 products\n        sql_gross_profit = """\n        SELECT \n            SUM((soi.unit_price - p.cost_price) * soi.qty) as total_gross_profit\n        FROM virtual_erp.sales_order_items soi\n        JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n        JOIN virtual_erp.products p ON soi.product_id = p.id\n        WHERE so.order_date >= %s AND so.order_date <= %s\n          AND so.status != \'取消\'\n        """\n        cursor.execute(sql_gross_profit, (start_date, end_date))\n        gp_row = cursor.fetchone()\n        total_gross_profit = float(gp_row[0]) if gp_row[0] else 0.0\n        \n        gross_margin_rate = (total_gross_profit / total_sales_amount * 100) if total_sales_amount > 0 else 0.0\n        avg_order_value = (total_sales_amount / valid_order_count) if valid_order_count > 0 else 0.0\n\n        # 4. 成交件数\n        sql_total_qty = """\n        SELECT SUM(soi.qty) as total_qty\n        FROM virtual_erp.sales_order_items soi\n        JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n        WHERE so.order_date >= %s AND so.order_date <= %s\n          AND so.status != \'取消\'\n        """\n        cursor.execute(sql_total_qty, (start_date, end_date))\n        qty_row = cursor.fetchone()\n        total_qty = qty_row[0] or 0\n        avg_price_per_item = (total_sales_amount / total_qty) if total_qty > 0 else 0.0\n\n        # 5. 库存资金占用\n        # 按成本价：SUM(stock_qty * cost_price)\n        # 按销售价：SUM(stock_qty * sale_price)\n        sql_inventory_value = """\n        SELECT \n            SUM(p.stock_qty * p.cost_price) as inventory_cost_value,\n            SUM(p.stock_qty * p.sale_price) as inventory_sale_value\n        FROM virtual_erp.products p\n        """\n        cursor.execute(sql_inventory_value)\n        inv_row = cursor.fetchone()\n        inventory_cost_value = float(inv_row[0]) if inv_row[0] else 0.0\n        inventory_sale_value = float(inv_row[1]) if inv_row[1] else 0.0\n\n        # 6. 整体动销率\n        # 动销率 = 销量 / (销量 + 当前库存) \n        # 注意：模板中定义为 "销量占销量与库存之和的比重"\n        sql_movement_rate = """\n        SELECT \n            COALESCE(SUM(sold.sold_qty), 0) as total_sold_qty,\n            COALESCE(SUM(curr.curr_stock_qty), 0) as total_current_stock_qty\n        FROM \n            (SELECT SUM(soi.qty) as sold_qty FROM virtual_erp.sales_order_items soi \n             JOIN virtual_erp.sales_orders so ON soi.order_id = so.id \n             WHERE so.order_date >= %s AND so.order_date <= %s AND so.status != \'取消\') sold,\n            (SELECT SUM(stock_qty) as curr_stock_qty FROM virtual_erp.products) curr\n        """\n        cursor.execute(sql_movement_rate, (start_date, end_date))\n        move_row = cursor.fetchone()\n        total_sold_qty = move_row[0] or 0\n        total_current_stock_qty = move_row[1] or 0\n        \n        denominator = total_sold_qty + total_current_stock_qty\n        movement_rate = (total_sold_qty / denominator * 100) if denominator > 0 else 0.0\n\n        # 7. 客户总数\n        sql_total_customers = "SELECT COUNT(*) FROM virtual_erp.customers"\n        cursor.execute(sql_total_customers)\n        total_customers = cursor.fetchone()[0]\n\n        # 8. 平均每单件数 & 平均每单品项\n        # 平均每单件数 = 总件数 / 有效订单数\n        avg_items_per_order = (total_qty / valid_order_count) if valid_order_count > 0 else 0.0\n        \n        # 平均每单品项 = 有效订单中涉及的SKU种类总数 / 有效订单数 ? \n        # 或者理解为：每个订单平均包含多少个不同的商品行？\n        # 模板中：平均每单品项 1.67 项。 \n        # 计算逻辑：SUM(每个订单的行数) / 订单数\n        sql_avg_skus_per_order = """\n        SELECT AVG(item_count) as avg_skus\n        FROM (\n            SELECT soi.order_id, COUNT(DISTINCT soi.product_id) as item_count\n            FROM virtual_erp.sales_order_items soi\n            JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n            WHERE so.order_date >= %s AND so.order_date <= %s AND so.status != \'取消\'\n            GROUP BY soi.order_id\n        ) t\n        """\n        cursor.execute(sql_avg_skus_per_order, (start_date, end_date))\n        avg_skus_row = cursor.fetchone()\n        avg_skus_per_order = float(avg_skus_row[0]) if avg_skus_row[0] else 0.0\n\n        # 构建结果字典\n        result = {\n            "report_period": f"{start_date} 至 {end_date}",\n            "valid_order_count": int(valid_order_count),\n            "total_sales_amount": round(total_sales_amount, 2),\n            "total_gross_profit": round(total_gross_profit, 2),\n            "gross_margin_rate": round(gross_margin_rate, 2),\n            "avg_order_value": round(avg_order_value, 2),\n            "total_qty": int(total_qty),\n            "avg_price_per_item": round(avg_price_per_item, 2),\n            "avg_items_per_order": round(avg_items_per_order, 2),\n            "avg_skus_per_order": round(avg_skus_per_order, 2),\n            "inventory_cost_value": round(inventory_cost_value, 2),\n            "inventory_sale_value": round(inventory_sale_value, 2),\n            "movement_rate": round(movement_rate, 2),\n            "total_customers": int(total_customers),\n            "active_customer_count": int(active_customer_count)\n        }\n\n        # 打印表格形式的基础汇总\n        print("="*60)\n        print("基础经营汇总指标")\n        print("="*60)\n        print(f"统计周期: {result[\'report_period\']}")\n        print(f"有效订单数: {result[\'valid_order_count\']} 笔")\n        print(f"销售额: {result[\'total_sales_amount\']} 元")\n        print(f"毛利额: {result[\'total_gross_profit\']} 元")\n        print(f"毛利率: {result[\'gross_margin_rate\']} %")\n        print(f"客单价: {result[\'avg_order_value\']} 元")\n        print(f"成交件数: {result[\'total_qty\']} 件")\n        print(f"件均价: {result[\'avg_price_per_item\']} 元")\n        print(f"平均每单件数: {result[\'avg_items_per_order\']} 件")\n        print(f"平均每单品项: {result[\'avg_skus_per_order\']} 项")\n        print(f"库存资金占用(成本): {result[\'inventory_cost_value\']} 元")\n        print(f"库存货值(销售价): {result[\'inventory_sale_value\']} 元")\n        print(f"整体动销率: {result[\'movement_rate\']} %")\n        print(f"客户总数: {result[\'total_customers\']} 家")\n        print(f"有成交客户数: {result[\'active_customer_count\']} 家")\n        print("="*60)\n\n        # Handoff 关键数据供后续步骤使用\n        handoff_data = {\n            "start_date": str(start_date),\n            "end_date": str(end_date),\n            "valid_order_count": result[\'valid_order_count\'],\n            "total_sales_amount": result[\'total_sales_amount\'],\n            "total_gross_profit": result[\'total_gross_profit\'],\n            "gross_margin_rate": result[\'gross_margin_rate\'],\n            "avg_order_value": result[\'avg_order_value\'],\n            "total_qty": result[\'total_qty\'],\n            "inventory_cost_value": result[\'inventory_cost_value\'],\n            "inventory_sale_value": result[\'inventory_sale_value\'],\n            "movement_rate": result[\'movement_rate\'],\n            "total_customers": result[\'total_customers\'],\n            "active_customer_count": result[\'active_customer_count\']\n        }\n        print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\n    except Exception as e:\n        print(f"Error occurred: {str(e)}")\n        raise e\n    finally:\n        if cursor:\n            cursor.close()\n        if conn:\n            conn.rollback()\n            conn.close()\n\nget_erp_summary_metrics()\n```\n【执行报错】:\nError: TypeError: unsupported operand type(s) for /: \'float\' and \'decimal.Decimal\'\n\n请仔细分析报错原因并修复代码。注意：\n1. 如果是 SQL 语法或字段找不到错误，请检查 JOIN 条件、表别名或使用的数据表字段名是否正确。\n2. 如果是 Pandas 数据处理报错，请检查 DataFrame 的类型或缺失值。\n3. 如果是 __HANDOFF__ 打印报错（如 json 序列化失败），请只放入可 JSON 序列化的简单参数（int/str/列表），并把 DataFrame 等对象排除在外。\n请输出修复后的纯 Python 代码内容，不要包含任何 Markdown 标记（如 ```python 等）。'}], 'model': 'qwen3.7-plus', 'temperature': 0.3}, 'extra_json': {'enable_thinking': False}}
