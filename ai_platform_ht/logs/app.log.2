\n    inv_row = cursor.fetchone()\n    inventory_total_value = float(inv_row[0]) if inv_row and inv_row[0] is not None else 0.0\n\n    # 4. 计算毛利额\n    # 需要关联订单明细和商品表来计算每笔有效订单的毛利\n    # 毛利 = (成交单价 - 成本价) * 数量\n    sql_gross_profit = """\n        SELECT COALESCE(SUM((soi.unit_price - p.cost_price) * soi.qty), 0)\n        FROM virtual_erp.sales_order_items soi\n        JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n        JOIN virtual_erp.products p ON soi.product_id = p.id\n        WHERE so.status != \'cancelled\'\n          AND YEAR(so.order_date) = YEAR(CURDATE())\n    """\n    cursor.execute(sql_gross_profit)\n    gp_row = cursor.fetchone()\n    gross_profit = float(gp_row[0]) if gp_row and gp_row[0] is not None else 0.0\n\n    # 输出结果表格\n    print("经营总览数据:")\n    print(f"{\'指标\':<20} | {\'数值\':<15}")\n    print("-" * 36)\n    print(f"{\'本期销售总额\':<20} | {total_sales:<15.2f}")\n    print(f"{\'本期毛利额\':<20} | {gross_profit:<15.2f}")\n    print(f"{\'有效订单总数\':<20} | {order_count:<15}")\n    print(f"{\'有成交客户数\':<20} | {active_customers:<15}")\n    print(f"{\'库存总金额\':<20} | {inventory_total_value:<15.2f}")\n\n    # 准备传递给后续步骤的数据\n    handoff_data = {\n        "total_sales": total_sales,\n        "gross_profit": gross_profit,\n        "order_count": order_count,\n        "active_customers": active_customers,\n        "inventory_total_value": inventory_total_value\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"Error: {str(e)}")\nfinally:\n    if cursor is not None:\n        try:\n            cursor.close()\n        except Exception:\n            pass\n    if conn is not None:\n        try:\n            conn.rollback()\n        except Exception:\n            pass\n        try:\n            conn.close()\n        except Exception:\n            pass\n```\n**执行结果**:\n```text\nError: get_connection() returned None\n```\n\n### 步骤 2: 步骤2：查询销售订单详细分析数据，包括每笔订单的金额、客户信息、商品明细、件数、状态变更记录及取消订单详情\n**执行代码**:\n```python\nimport json\nfrom datetime import datetime\n\ndef get_connection():\n    # 沙箱环境提供的连接函数，此处仅为占位，实际执行时由沙箱注入\n    raise NotImplementedError("get_connection must be provided by sandbox")\n\ntry:\n    conn = get_connection()\n    cursor = conn.cursor(dictionary=True)\n    \n    # 定义统计周期：今年 (2024年或根据当前时间动态获取，这里假设“今年”为当前年份)\n    current_year = datetime.now().year\n    start_date = f"{current_year}-01-01"\n    end_date = f"{current_year}-12-31"\n    \n    # 查询销售订单详细分析数据\n    # 关联表：sales_orders, customers, sales_order_items, products\n    sql = """\n    SELECT \n        so.order_no,\n        so.order_date,\n        so.status AS order_status,\n        so.total_amount,\n        c.name AS customer_name,\n        p.name AS product_name,\n        p.sku AS product_sku,\n        soi.qty,\n        soi.unit_price,\n        soi.amount AS item_amount,\n        so.remark AS order_remark,\n        so.created_at,\n        so.updated_at\n    FROM virtual_erp.sales_orders so\n    JOIN virtual_erp.customers c ON so.customer_id = c.id\n    JOIN virtual_erp.sales_order_items soi ON so.id = soi.order_id\n    JOIN virtual_erp.products p ON soi.product_id = p.id\n    WHERE so.order_date BETWEEN %s AND %s\n    ORDER BY so.order_date DESC, so.order_no ASC;\n    """\n    \n    cursor.execute(sql, (start_date, end_date))\n    rows = cursor.fetchall()\n    \n    # 格式化输出表格\n    if not rows:\n        print(f"在 {start_date} 至 {end_date} 期间未查询到销售订单明细数据。")\n    else:\n        headers = ["订单号", "下单日期", "订单状态", "订单总额", "客户名称", "商品名称", "SKU", "数量", "成交单价", "行金额", "备注", "创建时间", "更新时间"]\n        keys = ["order_no", "order_date", "order_status", "total_amount", "customer_name", "product_name", "product_sku", "qty", "unit_price", "item_amount", "order_remark", "created_at", "updated_at"]\n        \n        # 打印表头\n        header_line = "\\t".join(headers)\n        print(header_line)\n        print("-" * len(header_line))\n        \n        for row in rows:\n            line_data = []\n            for k in keys:\n                val = row.get(k)\n                if isinstance(val, datetime):\n                    val = val.strftime("%Y-%m-%d %H:%M:%S")\n                elif val is None:\n                    val = ""\n                line_data.append(str(val))\n            print("\\t".join(line_data))\n            \n    # 提取关键信息用于后续步骤（例如取消订单的ID列表，或者所有涉及的订单号）\n    # 这里我们提取所有有效订单和取消订单的信息，以便后续分析\n    cancelled_orders = [row[\'order_no\'] for row in rows if row[\'order_status\'] == \'cancelled\' or row[\'order_status\'] == \'canceled\']\n    all_order_nos = list(set([row[\'order_no\'] for row in rows]))\n    \n    handoff_data = {\n        "all_order_nos": all_order_nos,\n        "cancelled_order_nos": cancelled_orders,\n        "stat_period_start": start_date,\n        "stat_period_end": end_date\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"查询出错: {str(e)}")\nfinally:\n    try:\n        if \'cursor\' in locals():\n            cursor.close()\n        if \'conn\' in locals():\n            conn.rollback()\n            conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\n查询出错: get_connection must be provided by sandbox\n```\n\n### 步骤 3: 步骤3：查询商品维度分析数据，包括各商品的销量、销售额、成本、毛利、当前库存数量与金额及分类信息\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\ndef get_connection():\n    # 沙箱环境提供的连接获取函数，此处仅为占位说明，实际执行时由沙箱注入\n    pass\n\nconn = None\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n    \n    # 1. 查询商品基础信息及当前库存金额\n    sql_products = """\n    SELECT \n        p.id,\n        p.sku,\n        p.name,\n        p.category,\n        p.cost_price,\n        p.sale_price,\n        p.stock_qty,\n        (p.stock_qty * p.cost_price) as stock_amount\n    FROM virtual_erp.products p\n    WHERE p.status = 1\n    """\n    cursor.execute(sql_products)\n    products_data = cursor.fetchall()\n    product_columns = [desc[0] for desc in cursor.description]\n    \n    # 2. 查询各商品的销量、销售额（基于有效订单）\n    # 假设有效订单状态为 \'completed\' 或类似，根据常见ERP逻辑，这里先查所有非取消状态的订单明细汇总\n    # 由于表结构未明确枚举 status 值，通常 \'cancelled\' 是取消。为了安全，我们排除明显的取消状态，或者如果数据量小直接全量分析后在Python过滤。\n    # 但更严谨的做法是先看有哪些状态。不过为了生成报告，通常“销售”指已完成的交易。\n    # 这里采用通用策略：关联 sales_orders 和 sales_order_items，按 product_id 分组统计。\n    # 注意：需要确定哪些订单算作“销售”。通常 status != \'cancelled\' 且 status != \'draft\' 等。\n    # 鉴于模板提到“有效订单”，我们将尝试查询所有订单明细并关联订单状态，然后在代码中处理或SQL中过滤。\n    # 由于不知道具体状态字符串，我们先查出所有明细的聚合，以及对应的订单状态分布，以便后续判断。\n    # 但为了简化步骤3的输出，我们主要关注有销量的商品。\n    \n    sql_sales_agg = """\n    SELECT \n        soi.product_id,\n        SUM(soi.qty) as total_qty,\n        SUM(soi.amount) as total_sales_amount\n    FROM virtual_erp.sales_order_items soi\n    JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n    GROUP BY soi.product_id\n    """\n    cursor.execute(sql_sales_agg)\n    sales_agg_data = cursor.fetchall()\n    sales_agg_columns = [desc[0] for desc in cursor.description]\n    \n    # 将结果转换为字典列表方便处理\n    products_list = []\n    for row in products_data:\n        item = dict(zip(product_columns, row))\n        # 转换 Decimal 为 float 以便 JSON 序列化\n        if isinstance(item[\'cost_price\'], Decimal): item[\'cost_price\'] = float(item[\'cost_price\'])\n        if isinstance(item[\'sale_price\'], Decimal): item[\'sale_price\'] = float(item[\'sale_price\'])\n        if isinstance(item[\'stock_amount\'], Decimal): item[\'stock_amount\'] = float(item[\'stock_amount\'])\n        products_list.append(item)\n        \n    sales_map = {}\n    for row in sales_agg_data:\n        item = dict(zip(sales_agg_columns, row))\n        pid = item[\'product_id\']\n        qty = item[\'total_qty\'] or 0\n        amt = float(item[\'total_sales_amount\']) if item[\'total_sales_amount\'] else 0.0\n        sales_map[pid] = {\'qty\': int(qty), \'amount\': amt}\n        \n    # 合并数据并计算毛利\n    final_product_analysis = []\n    for p in products_list:\n        pid = p[\'id\']\n        sales_info = sales_map.get(pid, {\'qty\': 0, \'amount\': 0.0})\n        \n        qty_sold = sales_info[\'qty\']\n        sales_revenue = sales_info[\'amount\']\n        \n        # 成本总额 = 销量 * 成本价\n        cost_total = qty_sold * p[\'cost_price\']\n        # 毛利额 = 销售额 - 成本总额\n        gross_profit = sales_revenue - cost_total\n        \n        analysis_item = {\n            \'product_id\': pid,\n            \'sku\': p[\'sku\'],\n            \'name\': p[\'name\'],\n            \'category\': p[\'category\'],\n            \'sales_qty\': qty_sold,\n            \'sales_amount\': round(sales_revenue, 2),\n            \'cost_price\': p[\'cost_price\'],\n            \'cost_total\': round(cost_total, 2),\n            \'gross_profit\': round(gross_profit, 2),\n            \'current_stock_qty\': p[\'stock_qty\'],\n            \'current_stock_amount\': round(p[\'stock_amount\'], 2)\n        }\n        final_product_analysis.append(analysis_item)\n        \n    # 打印表格\n    print("=== 商品维度分析数据 ===")\n    headers = [\'SKU\', \'商品名称\', \'分类\', \'销量\', \'销售额\', \'成本总额\', \'毛利额\', \'当前库存数量\', \'当前库存金额\']\n    print("\\t".join(headers))\n    for item in final_product_analysis:\n        row_vals = [\n            str(item[\'sku\']),\n            str(item[\'name\']),\n            str(item[\'category\']),\n            str(item[\'sales_qty\']),\n            f"{item[\'sales_amount\']:.2f}",\n            f"{item[\'cost_total\']:.2f}",\n            f"{item[\'gross_profit\']:.2f}",\n            str(item[\'current_stock_qty\']),\n            f"{item[\'current_stock_amount\']:.2f}"\n        ]\n        print("\\t".join(row_vals))\n        \n    # 传递关键数据给后续步骤（如果需要的话，比如经营诊断需要用到滞销品ID等）\n    # 这里传递完整的分析列表可能太大，仅传递必要的标识或摘要？\n    # 协议要求：若产生了后续步骤需要复用的关键结果...例如从明细中筛选出的记录 ID 列表。\n    # 后续步骤可能是“客户分析”、“供应商分析”、“库存分析”、“经营诊断”。\n    # 经营诊断可能需要知道哪些是滞销品（销量为0）。\n    zero_sales_ids = [item[\'product_id\'] for item in final_product_analysis if item[\'sales_qty\'] == 0]\n    \n    handoff_data = {\n        \'zero_sales_product_ids\': zero_sales_ids,\n        \'product_analysis_summary_count\': len(final_product_analysis)\n    }\n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 4: 步骤4：查询客户维度分析数据，包括各客户的订单记录、销售额、建档时间、首次下单时间及客户总数与有成交客户数\n**执行代码**:\n```python\nimport json\nfrom datetime import datetime\n\ndef get_connection():\n    # 沙箱环境提供，此处仅为占位符，实际执行时由沙箱注入\n    pass\n\ntry:\n    conn = get_connection()\n    cursor = conn.cursor(dictionary=True)\n    \n    # 1. 获取客户基础信息及建档时间\n    sql_customers = """\n    SELECT \n        id, \n        code, \n        name, \n        contact, \n        phone, \n        email, \n        address, \n        status, \n        created_at \n    FROM virtual_erp.customers\n    """\n    cursor.execute(sql_customers)\n    customers = cursor.fetchall()\n    \n    # 2. 获取所有销售订单数据（用于计算销售额、首次下单时间等）\n    # 注意：这里假设“今年”指的是当前年份。如果需要根据具体业务定义调整日期范围，需修改 WHERE 条件。\n    # 由于用户请求是“今年的经营分析报告”，我们筛选 order_date 在当前年份的数据。\n    current_year = datetime.now().year\n    \n    sql_orders = """\n    SELECT \n        so.id as order_id,\n        so.customer_id,\n        so.order_no,\n        so.order_date,\n        so.status,\n        so.total_amount,\n        c.name as customer_name\n    FROM virtual_erp.sales_orders so\n    JOIN virtual_erp.customers c ON so.customer_id = c.id\n    WHERE YEAR(so.order_date) = %s\n    ORDER BY so.order_date ASC\n    """\n    cursor.execute(sql_orders, (current_year,))\n    orders = cursor.fetchall()\n    \n    # 3. 数据处理与交叉分析\n    # 初始化统计字典\n    customer_stats = {}\n    \n    # 遍历客户列表，初始化每个客户的统计数据\n    for cust in customers:\n        cid = cust[\'id\']\n        customer_stats[cid] = {\n            \'customer_code\': cust[\'code\'],\n            \'customer_name\': cust[\'name\'],\n            \'contact\': cust[\'contact\'],\n            \'phone\': cust[\'phone\'],\n            \'email\': cust[\'email\'],\n            \'address\': cust[\'address\'],\n            \'status\': cust[\'status\'],\n            \'created_at\': str(cust[\'created_at\']),\n            \'total_sales_amount\': 0.0,\n            \'order_count\': 0,\n            \'first_order_date\': None,\n            \'last_order_date\': None,\n            \'orders_detail\': []\n        }\n        \n    # 遍历订单，累加到对应客户\n    for order in orders:\n        cid = order[\'customer_id\']\n        if cid not in customer_stats:\n            continue\n            \n        amount = float(order[\'total_amount\']) if order[\'total_amount\'] else 0.0\n        date_str = str(order[\'order_date\'])\n        \n        stats = customer_stats[cid]\n        stats[\'total_sales_amount\'] += amount\n        stats[\'order_count\'] += 1\n        \n        # 更新首次和最后下单时间\n        if stats[\'first_order_date\'] is None or date_str < stats[\'first_order_date\']:\n            stats[\'first_order_date\'] = date_str\n        if stats[\'last_order_date\'] is None or date_str > stats[\'last_order_date\']:\n            stats[\'last_order_date\'] = date_str\n            \n        # 记录订单明细\n        stats[\'orders_detail\'].append({\n            \'order_no\': order[\'order_no\'],\n            \'date\': date_str,\n            \'amount\': amount,\n            \'status\': order[\'status\']\n        })\n        \n    # 4. 汇总指标\n    total_customers = len(customers)\n    active_customers_with_sales = sum(1 for s in customer_stats.values() if s[\'order_count\'] > 0)\n    \n    # 5. 输出结果表格\n    print("=== 客户维度分析数据 ===")\n    print(f"统计周期: {current_year}年")\n    print(f"客户总数: {total_customers}")\n    print(f"有成交客户数: {active_customers_with_sales}")\n    print("-" * 100)\n    header = f"{\'客户编码\':<10} | {\'客户名称\':<20} | {\'建档时间\':<20} | {\'首次下单\':<12} | {\'订单数\':<6} | {\'总销售额\':<12}"\n    print(header)\n    print("-" * 100)\n    \n    # 按销售额降序排列以便查看重点客户\n    sorted_customers = sorted(customer_stats.values(), key=lambda x: x[\'total_sales_amount\'], reverse=True)\n    \n    for cust in sorted_customers:\n        first_date = cust[\'first_order_date\'] if cust[\'first_order_date\'] else "无"\n        sales_amt = f"{cust[\'total_sales_amount\']:.2f}"\n        print(f"{cust[\'customer_code\']:<10} | {cust[\'customer_name\']:<20} | {cust[\'created_at\'][:19]:<20} | {first_date:<12} | {cust[\'order_count\']:<6} | {sales_amt:<12}")\n        \n    print("-" * 100)\n    \n    # 打印详细订单记录供后续步骤或报告使用\n    print("\\n=== 各客户订单明细 ===")\n    for cust in sorted_customers:\n        if cust[\'order_count\'] > 0:\n            print(f"\\n客户: {cust[\'customer_name\']} ({cust[\'customer_code\']})")\n            for od in cust[\'orders_detail\']:\n                print(f"  - 订单号: {od[\'order_no\']}, 日期: {od[\'date\']}, 金额: {od[\'amount\']:.2f}, 状态: {od[\'status\']}")\n                \n    # 准备 Handoff 数据\n    # 后续步骤可能需要知道哪些客户是有成交的，或者具体的客户ID列表用于进一步查询商品关联等\n    handoff_data = {\n        \'current_year\': current_year,\n        \'total_customers\': total_customers,\n        \'active_customer_ids\': [cid for cid, stats in customer_stats.items() if stats[\'order_count\'] > 0],\n        \'customer_summary\': [\n            {\n                \'id\': next((c[\'id\'] for c in customers if c[\'code\'] == cs[\'customer_code\']), None),\n                \'name\': cs[\'customer_name\'],\n                \'total_sales\': cs[\'total_sales_amount\'],\n                \'order_count\': cs[\'order_count\']\n            } for cs in sorted_customers if cs[\'order_count\'] > 0\n        ]\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    try:\n        if \'cursor\' in locals():\n            cursor.close()\n        if \'conn\' in locals():\n            conn.rollback()\n            conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 5: 步骤5：查询供应商维度分析数据，包括供应商基础档案、采购入库记录及商品与供应商的关联数据\n**执行代码**:\n```python\nimport json\n\ndef get_data():\n    conn = None\n    try:\n        conn = get_connection()\n        cursor = conn.cursor()\n        \n        results = {}\n        \n        # 1. 供应商基础档案信息\n        sql_suppliers = """\n            SELECT id, code, name, contact, phone, address, status, created_at \n            FROM virtual_erp.suppliers\n        """\n        cursor.execute(sql_suppliers)\n        columns = [desc[0] for desc in cursor.description]\n        rows = cursor.fetchall()\n        suppliers = []\n        for row in rows:\n            supplier_dict = dict(zip(columns, row))\n            if isinstance(supplier_dict.get(\'created_at\'), str):\n                pass \n            elif hasattr(supplier_dict.get(\'created_at\'), \'isoformat\'):\n                supplier_dict[\'created_at\'] = supplier_dict[\'created_at\'].isoformat()\n            else:\n                supplier_dict[\'created_at\'] = str(supplier_dict.get(\'created_at\'))\n            suppliers.append(supplier_dict)\n        results[\'suppliers\'] = suppliers\n        \n        # 2. 采购入库记录及对应的供应商字段\n        # 注意：表结构中 stock_logs 没有直接的 supplier_id。\n        # products 表也没有 supplier_id。\n        # 缺失了采购订单表和商品-供应商关联表。\n        # 因此，无法直接通过 SQL JOIN 获取“采购入库记录及对应的供应商”以及“商品与供应商的关联数据”。\n        # 只能查询现有的供应商列表，并尝试从库存流水中找出类型为“入库”(IN/PURCHASE等)的记录，\n        # 但由于缺乏关联键，无法将这些入库记录具体归属到某个供应商。\n        \n        # 查询所有库存流水，以便后续如果有逻辑可以推断，或者至少展示库存变动情况。\n        sql_stock_logs = """\n            SELECT sl.id, sl.product_id, p.name as product_name, sl.change_qty, sl.change_type, sl.ref_no, sl.remark, sl.created_at\n            FROM virtual_erp.stock_logs sl\n            LEFT JOIN virtual_erp.products p ON sl.product_id = p.id\n            ORDER BY sl.created_at DESC\n        """\n        cursor.execute(sql_stock_logs)\n        columns_logs = [desc[0] for desc in cursor.description]\n        rows_logs = cursor.fetchall()\n        stock_logs = []\n        for row in rows_logs:\n            log_dict = dict(zip(columns_logs, row))\n            if hasattr(log_dict.get(\'created_at\'), \'isoformat\'):\n                log_dict[\'created_at\'] = log_dict[\'created_at\'].isoformat()\n            else:\n                log_dict[\'created_at\'] = str(log_dict.get(\'created_at\'))\n            stock_logs.append(log_dict)\n        results[\'stock_logs\'] = stock_logs\n        \n        # 3. 商品与供应商的关联数据\n        # 由于数据库中不存在 product_supplier 关联表，此部分数据为空或不可用。\n        results[\'product_supplier_relations\'] = []\n        \n        return results\n        \n    finally:\n        if conn:\n            conn.rollback()\n            conn.close()\n\ndata = get_data()\n\n# 打印结果用于调试和展示\nprint("=== Supplier Analysis Data ===")\nprint(f"Suppliers Count: {len(data[\'suppliers\'])}")\nfor s in data[\'suppliers\']:\n    print(s)\n\nprint(f"\\nStock Logs Count: {len(data[\'stock_logs\'])}")\n# 仅打印前几条示例，避免刷屏\nfor log in data[\'stock_logs\'][:5]:\n    print(log)\n\nprint("\\nNote: Direct linkage between Suppliers and Stock Inflows is missing in the provided schema (no Purchase Order tables or Product-Supplier mapping).")\n\n# 准备 Handoff 数据\nhandoff_data = {\n    "supplier_ids": [s[\'id\'] for s in data[\'suppliers\']],\n    "supplier_names_map": {str(s[\'id\']): s[\'name\'] for s in data[\'suppliers\']}\n}\n\nprint(\'__HANDOFF__\' + json.dumps(handoff_data))\n```\n**执行结果**:\n```text\n=== Supplier Analysis Data ===\nSuppliers Count: 2\n{\'id\': 1, \'code\': \'S20240001\', \'name\': \'东莞精工电子厂\', \'contact\': \'陈明\', \'phone\': \'13900139001\', \'address\': \'东莞市长安镇工业区\', \'status\': 1, \'created_at\': \'2026-10-21T15:30:08\'}\n{\'id\': 2, \'code\': \'S20240002\', \'name\': \'杭州润泽包装材料有限公司\', \'contact\': \'刘芳\', \'phone\': \'13900139002\', \'address\': \'杭州市余杭区仁和街道\', \'status\': 1, \'created_at\': \'2026-10-21T15:30:08\'}\n\nStock Logs Count: 12\n{\'id\': 12, \'product_id\': 6, \'product_name\': \'折叠办公桌 120cm\', \'change_qty\': 1, \'change_type\': \'in\', \'ref_no\': \'SO202610210004\', \'remark\': \'订单取消回补\', \'created_at\': \'2026-10-21T15:57:08\'}\n{\'id\': 11, \'product_id\': 6, \'product_name\': \'折叠办公桌 120cm\', \'change_qty\': -1, \'change_type\': \'out\', \'ref_no\': \'SO202610210004\', \'remark\': \'销售出库\', \'created_at\': \'2026-10-21T15:56:51\'}\n{\'id\': 7, \'product_id\': 1, \'product_name\': \'无线蓝牙耳机 Air Pro\', \'change_qty\': 3, \'change_type\': \'in\', \'ref_no\': \'SO202610210003\', \'remark\': \'订单取消回补\', \'created_at\': \'2026-10-21T15:49:56\'}\n{\'id\': 8, \'product_id\': 4, \'product_name\': \'牛皮纸包装盒(中号)\', \'change_qty\': 20, \'change_type\': \'in\', \'ref_no\': \'SO202610210003\', \'remark\': \'订单取消回补\', \'created_at\': \'2026-10-21T15:49:56\'}\n{\'id\': 9, \'product_id\': 1, \'product_name\': \'无线蓝牙耳机 Air Pro\', \'change_qty\': -3, \'change_type\': \'out\', \'ref_no\': \'SO202610210003\', \'remark\': \'订单恢复重新出库\', \'created_at\': \'2026-10-21T15:49:56\'}\n\nNote: Direct linkage between Suppliers and Stock Inflows is missing in the provided schema (no Purchase Order tables or Product-Supplier mapping).\n```\n\n### 步骤 6: 步骤6：查询库存维度分析数据，包括各商品当前库存数量、成本价、销售价、安全库存设定值及本期出入库明细\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\nconn = get_connection()\ntry:\n    cursor = conn.cursor()\n    \n    # 1. 查询各商品当前库存数量、成本价、销售价、安全库存设定值\n    sql_products_stock = """\n    SELECT \n        id,\n        name,\n        stock_qty,\n        cost_price,\n        sale_price,\n        safety_stock\n    FROM virtual_erp.products\n    """\n    cursor.execute(sql_products_stock)\n    products_stock_data = cursor.fetchall()\n    \n    print("=== 商品库存基础信息 ===")\n    header = f"{\'ID\':<5} {\'名称\':<20} {\'库存数量\':<10} {\'成本价\':<10} {\'销售价\':<10} {\'安全库存\':<10}"\n    print(header)\n    for row in products_stock_data:\n        pid, pname, qty, cost, price, safety = row\n        # 处理 None 值，确保格式化不报错\n        p_name_str = str(pname) if pname is not None else "N/A"\n        p_qty_str = str(qty) if qty is not None else "0"\n        p_cost_str = str(cost) if cost is not None else "0.00"\n        p_price_str = str(price) if price is not None else "0.00"\n        p_safety_str = str(safety) if safety is not None else "0"\n        \n        print(f"{pid:<5} {p_name_str:<20} {p_qty_str:<10} {p_cost_str:<10} {p_price_str:<10} {p_safety_str:<10}")\n        \n    # 2. 查询本期（今年）出入库明细记录\n    sql_stock_logs = """\n    SELECT \n        sl.id,\n        sl.product_id,\n        p.name as product_name,\n        sl.change_qty,\n        sl.change_type,\n        sl.ref_no,\n        sl.remark,\n        sl.created_at\n    FROM virtual_erp.stock_logs sl\n    JOIN virtual_erp.products p ON sl.product_id = p.id\n    WHERE YEAR(sl.created_at) = YEAR(CURDATE())\n    ORDER BY sl.created_at DESC\n    """\n    cursor.execute(sql_stock_logs)\n    stock_logs_data = cursor.fetchall()\n    \n    print("\\n=== 本期出入库明细 (最近50条) ===")\n    log_header = f"{\'ID\':<5} {\'商品ID\':<8} {\'商品名称\':<20} {\'变动数量\':<10} {\'类型\':<10} {\'关联单号\':<20} {\'时间\':<20}"\n    print(log_header)\n    \n    display_limit = 50\n    for i, row in enumerate(stock_logs_data):\n        if i >= display_limit:\n            break\n        lid, pid, pname, cqty, ctype, refno, remark, created_at = row\n        \n        l_pid_str = str(pid) if pid is not None else ""\n        l_pname_str = str(pname) if pname is not None else "N/A"\n        l_cqty_str = str(cqty) if cqty is not None else "0"\n        l_ctype_str = str(ctype) if ctype is not None else "N/A"\n        l_refno_str = str(refno) if refno is not None else "N/A"\n        l_time_str = str(created_at) if created_at is not None else "N/A"\n        \n        print(f"{lid:<5} {l_pid_str:<8} {l_pname_str:<20} {l_cqty_str:<10} {l_ctype_str:<10} {l_refno_str:<20} {l_time_str:<20}")\n        \n    if len(stock_logs_data) > display_limit:\n        print(f"... 还有 {len(stock_logs_data) - display_limit} 条记录未显示 ...")\n\n    # 3. 计算库存资金占用情况用于后续分析\n    product_stock_map = {}\n    total_stock_value = 0.0\n    \n    for row in products_stock_data:\n        pid, pname, qty, cost, price, safety = row\n        \n        # 转换为数值类型，处理 None\n        int_qty = int(qty) if qty is not None else 0\n        float_cost = float(cost) if cost is not None else 0.0\n        float_price = float(price) if price is not None else 0.0\n        int_safety = int(safety) if safety is not None else 0\n        \n        stock_value = int_qty * float_cost\n        total_stock_value += stock_value\n        \n        product_stock_map[str(pid)] = {\n            "name": str(pname) if pname is not None else "Unknown",\n            "stock_qty": int_qty,\n            "cost_price": float_cost,\n            "sale_price": float_price,\n            "safety_stock": int_safety,\n            "stock_value": round(stock_value, 2)\n        }\n        \n    # 准备传递给下一步的数据：主要是库存相关的汇总指标和异常项\n    high_risk_items = []\n    for pid_str, info in product_stock_map.items():\n        safety = info[\'safety_stock\']\n        current_qty = info[\'stock_qty\']\n        \n        # 简单判断：库存超过安全库存2倍视为潜在积压风险\n        if safety > 0 and current_qty > safety * 2:\n             high_risk_items.append({\n                 "product_id": int(pid_str),\n                 "name": info[\'name\'],\n                 "stock_qty": current_qty,\n                 "safety_stock": safety,\n                 "stock_value": info[\'stock_value\']\n             })\n             \n    handoff_data = {\n        "total_stock_value": round(float(total_stock_value), 2),\n        "high_risk_inventory_items": high_risk_items,\n        "product_stock_summary": product_stock_map \n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n=== 商品库存基础信息 ===\nID    名称                   库存数量       成本价        销售价        安全库存      \n1     无线蓝牙耳机 Air Pro       115        98.00      199.00     20        \n2     65W 氮化镓快充充电器         190        45.00      89.00      30        \n3     Type-C 数据线 1.5m      495        6.50       19.90      100       \n4     牛皮纸包装盒(中号)           780        1.80       3.50       200       \n5     气泡袋 20x30cm          250        0.35       1.00       100       \n6     折叠办公桌 120cm          35         210.00     399.00     5         \n\n=== 本期出入库明细 (最近50条) ===\nID    商品ID     商品名称                 变动数量       类型         关联单号                 时间                  \n12    6        折叠办公桌 120cm          1          in         SO202610210004       2026-10-21 15:57:08 \n11    6        折叠办公桌 120cm          -1         out        SO202610210004       2026-10-21 15:56:51 \n7     1        无线蓝牙耳机 Air Pro       3          in         SO202610210003       2026-10-21 15:49:56 \n8     4        牛皮纸包装盒(中号)           20         in         SO202610210003       2026-10-21 15:49:56 \n9     1        无线蓝牙耳机 Air Pro       -3         out        SO202610210003       2026-10-21 15:49:56 \n10    4        牛皮纸包装盒(中号)           -20        out        SO202610210003       2026-10-21 15:49:56 \n6     5        气泡袋 20x30cm          200        in         N/A                  2026-10-21 15:31:47 \n4     1        无线蓝牙耳机 Air Pro       -3         out        SO202610210003       2026-10-21 15:30:22 \n5     4        牛皮纸包装盒(中号)           -20        out        SO202610210003       2026-10-21 15:30:22 \n1     1        无线蓝牙耳机 Air Pro       -2         out        SO202610210001       2026-10-21 15:30:08 \n2     3        Type-C 数据线 1.5m      -5         out        SO202610210001       2026-10-21 15:30:08 \n3     2        65W 氮化镓快充充电器         -10        out        SO202610210002       2026-10-21 15:30:08 \n```\n\n### 步骤 7: 步骤7：基于上述查询结果进行交叉分析，生成经营诊断结论与改进建议，汇总形成完整的经营分析报告\n**执行代码**:\n```python\nimport json\n\n# 读取上一步落盘的衔接参数\nhandoff_data = _HANDOFF_98852b84eb\n\n# 初始化报告内容列表\nreport_lines = []\n\ndef add_line(text=""):\n    report_lines.append(text)\n\nadd_line("=" * 60)\nadd_line("ERP 年度经营分析报告")\nadd_line("=" * 60)\nadd_line("")\n\n# --- 一、报告概要 ---\nadd_line("一、报告概要")\nadd_line("-" * 30)\nadd_line("统计周期：本年度（基于数据库当前数据）")\nadd_line("数据来源：虚拟ERP系统运行记录")\nadd_line("关键指标定义：")\nadd_line("  - 销售总额：有效订单的总金额之和")\nadd_line("  - 毛利额：(成交单价 - 成本价) * 数量")\nadd_line("  - 库存资金占用：商品库存数量 * 成本价")\nadd_line("本期核心摘要：")\nadd_line("  本报告基于ERP系统内的销售、采购、库存及客户数据进行交叉分析，")\nadd_line("  旨在揭示经营现状、识别潜在风险并提出改进建议。")\nadd_line("")\n\n# --- 二、经营总览 (需要重新查询基础汇总数据，因为Handoff主要包含库存和供应商信息) ---\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n    \n    # 1. 获取销售基础数据\n    sql_sales_summary = """\n    SELECT \n        COUNT(DISTINCT so.id) as order_count,\n        SUM(so.total_amount) as total_sales,\n        COUNT(DISTINCT so.customer_id) as active_customers\n    FROM virtual_erp.sales_orders so\n    WHERE so.status != \'cancelled\' AND YEAR(so.order_date) = YEAR(CURDATE())\n    """\n    cursor.execute(sql_sales_summary)\n    sales_row = cursor.fetchone()\n    order_count = sales_row[0] if sales_row else 0\n    total_sales = float(sales_row[1]) if sales_row and sales_row[1] else 0.0\n    active_customers = sales_row[2] if sales_row else 0\n    \n    # 2. 获取毛利数据 (通过明细表计算)\n    sql_profit = """\n    SELECT \n        SUM((soi.unit_price - p.cost_price) * soi.qty) as gross_profit\n    FROM virtual_erp.sales_order_items soi\n    JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n    JOIN virtual_erp.products p ON soi.product_id = p.id\n    WHERE so.status != \'cancelled\' AND YEAR(so.order_date) = YEAR(CURDATE())\n    """\n    cursor.execute(sql_profit)\n    profit_row = cursor.fetchone()\n    gross_profit = float(profit_row[0]) if profit_row and profit_row[0] else 0.0\n    \n    # 3. 获取库存总金额 (从Handoff中已有，但为了严谨可再次确认或直接用Handoff)\n    total_stock_value = handoff_data.get(\'total_stock_value\', 0.0)\n    \n    # 4. 获取客户总数\n    sql_customers_total = "SELECT COUNT(*) FROM virtual_erp.customers"\n    cursor.execute(sql_customers_total)\n    total_customers = cursor.fetchone()[0]\n    \n    # 5. 获取单笔订单金额分布 (简单统计最大/最小/平均)\n    sql_order_dist = """\n    SELECT MIN(total_amount), MAX(total_amount), AVG(total_amount)\n    FROM virtual_erp.sales_orders\n    WHERE status != \'cancelled\' AND YEAR(order_date) = YEAR(CURDATE())\n    """\n    cursor.execute(sql_order_dist)\n    dist_row = cursor.fetchone()\n    min_order_amt = float(dist_row[0]) if dist_row and dist_row[0] else 0.0\n    max_order_amt = float(dist_row[1]) if dist_row and dist_row[1] else 0.0\n    avg_order_amt = float(dist_row[2]) if dist_row and dist_row[2] else 0.0\n\n    add_line("二、经营总览")\n    add_line("-" * 30)\n    add_line(f"本期销售总额：{total_sales:.2f} 元")\n    add_line(f"本期毛利额：{gross_profit:.2f} 元")\n    add_line(f"毛利率：{(gross_profit / total_sales * 100) if total_sales > 0 else 0:.2f}%")\n    add_line(f"有效订单数：{order_count}")\n    add_line(f"有成交客户数：{active_customers}")\n    add_line(f"客户总数：{total_customers}")\n    add_line(f"库存总金额：{total_stock_value:.2f} 元")\n    add_line(f"单笔订单金额范围：{min_order_amt:.2f} - {max_order_amt:.2f} 元")\n    add_line(f"平均单笔订单金额：{avg_order_amt:.2f} 元")\n    add_line("")\n\n    # --- 三、销售订单分析 ---\n    sql_order_details = """\n    SELECT \n        so.order_no,\n        c.name as customer_name,\n        so.order_date,\n        so.status,\n        so.total_amount,\n        GROUP_CONCAT(CONCAT(p.name, \' x \', soi.qty) SEPARATOR \'; \') as product_details\n    FROM virtual_erp.sales_orders so\n    JOIN virtual_erp.customers c ON so.customer_id = c.id\n    LEFT JOIN virtual_erp.sales_order_items soi ON so.id = soi.order_id\n    LEFT JOIN virtual_erp.products p ON soi.product_id = p.id\n    WHERE YEAR(so.order_date) = YEAR(CURDATE())\n    GROUP BY so.id\n    ORDER BY so.order_date DESC\n    LIMIT 10\n    """\n    cursor.execute(sql_order_details)\n    orders = cursor.fetchall()\n    \n    add_line("三、销售订单分析 (最近10笔)")\n    add_line("-" * 30)\n    add_line(f"{\'订单号\':<15} {\'客户\':<10} {\'日期\':<12} {\'状态\':<8} {\'金额\':>10} {\'商品明细\'}")\n    for o in orders:\n        add_line(f"{o[0]:<15} {(o[1] or \'\'):<10} {str(o[2]):<12} {(o[3] or \'\'):<8} {float(o[4] or 0):>10.2f} {o[5] or \'\'}")\n    \n    # 取消订单分析\n    sql_cancelled = """\n    SELECT COUNT(*), SUM(total_amount) \n    FROM virtual_erp.sales_orders \n    WHERE status = \'cancelled\' AND YEAR(order_date) = YEAR(CURDATE())\n    """\n    cursor.execute(sql_cancelled)\n    cancel_row = cursor.fetchone()\n    cancel_count = cancel_row[0] if cancel_row else 0\n    cancel_amount = float(cancel_row[1]) if cancel_row and cancel_row[1] else 0.0\n    \n    add_line(f"\\n取消订单统计：共 {cancel_count} 笔，涉及金额 {cancel_amount:.2f} 元")\n    add_line("")\n\n    # --- 四、商品分析 ---\n    sql_product_analysis = """\n    SELECT \n        p.name,\n        p.category,\n        COALESCE(SUM(soi.qty), 0) as total_qty_sold,\n        COALESCE(SUM(soi.amount), 0) as total_sales,\n        COALESCE(SUM((soi.unit_price - p.cost_price) * soi.qty), 0) as total_profit,\n        p.stock_qty,\n        p.safety_stock\n    FROM virtual_erp.products p\n    LEFT JOIN virtual_erp.sales_order_items soi ON p.id = soi.product_id\n    LEFT JOIN virtual_erp.sales_orders so ON soi.order_id = so.id AND so.status != \'cancelled\' AND YEAR(so.order_date) = YEAR(CURDATE())\n    GROUP BY p.id\n    ORDER BY total_sales DESC\n    """\n    cursor.execute(sql_product_analysis)\n    products = cursor.fetchall()\n    \n    add_line("四、商品分析")\n    add_line("-" * 30)\n    add_line(f"{\'商品名称\':<20} {\'分类\':<10} {\'销量\':>6} {\'销售额\':>10} {\'毛利\':>10} {\'库存\':>6} {\'安全库存\':>8}")\n    for p in products:\n        name = p[0] or \'\'\n        cat = p[1] or \'\'\n        qty = int(p[2] or 0)\n        sales = float(p[3] or 0)\n        profit = float(p[4] or 0)\n        stock = int(p[5] or 0)\n        safety = int(p[6] or 0)\n        add_line(f"{name:<20} {cat:<10} {qty:>6} {sales:>10.2f} {profit:>10.2f} {stock:>6} {safety:>8}")\n    \n    # 滞销品识别 (销量为0且库存>0)\n    slow_moving = [p for p in products if int(p[2] or 0) == 0 and int(p[5] or 0) > 0]\n    if slow_moving:\n        add_line("\\n【预警】滞销商品 (本期无销售且有库存):")\n        for sm in slow_moving:\n            add_line(f"  - {sm[0]}: 库存 {sm[5]}, 占用资金约 {float(sm[5]) * float(sm[7] if len(sm)>7 else 0):.2f} (需结合成本价精确计算)")\n            # 使用Handoff中的高价值库存项进行更准确的描述\n            high_risk_map = {item[\'name\']: item for item in handoff_data.get(\'high_risk_inventory_items\', [])}\n            if sm[0] in high_risk_map:\n                hr_item = high_risk_map[sm[0]]\n                add_line(f"    库存资金占用: {hr_item[\'stock_value\']:.2f} 元")\n    add_line("")\n\n    # --- 五、客户分析 ---\n    sql_customer_analysis = """\n    SELECT \n        c.name,\n        c.created_at,\n        COUNT(so.id) as order_count,\n        SUM(so.total_amount) as total_spent,\n        MIN(so.order_date) as first_order_date\n    FROM virtual_erp.customers c\n    LEFT JOIN virtual_erp.sales_orders so ON c.id = so.customer_id AND so.status != \'cancelled\' AND YEAR(so.order_date) = YEAR(CURDATE())\n    GROUP BY c.id\n    ORDER BY total_spent DESC\n    """\n    cursor.execute(sql_customer_analysis)\n    customers = cursor.fetchall()\n    \n    add_line("五、客户分析")\n    add_line("-" * 30)\n    add_line(f"{\'客户名称\':<15} {\'建档时间\':<12} {\'首单时间\':<12} {\'订单数\':>6} {\'消费总额\':>12}")\n    for c in customers:\n        name = c[0] or \'\'\n        created = str(c[1]).split(\' \')[0] if c[1] else \'\'\n        first_ord = str(c[4]).split(\' \')[0] if c[4] else \'无\'\n        count = int(c[2] or 0)\n        spent = float(c[3] or 0)\n        add_line(f"{name:<15} {created:<12} {first_ord:<12} {count:>6} {spent:>12.2f}")\n    \n    # 客户集中度\n    if customers and len(customers) > 0:\n        top_customer = customers[0]\n        top_spent = float(top_customer[3] or 0)\n        concentration = (top_spent / total_sales * 100) if total_sales > 0 else 0\n        add_line(f"\\n第一大客户 [{top_customer[0]}] 贡献了 {concentration:.2f}% 的销售额。")\n        \n        # 检查是否有2家客户贡献大部分销售额\n        if len(customers) >= 2:\n            second_spent = float(customers[1][3] or 0)\n            top2_concentration = ((top_spent + second_spent) / total_sales * 100) if total_sales > 0 else 0\n            add_line(f"前两大客户合计贡献了 {top2_concentration:.2f}% 的销售额。")\n    add_line("")\n\n    # --- 六、供应商分析 ---\n    supplier_ids = handoff_data.get(\'supplier_ids\', [])\n    supplier_names_map = handoff_data.get(\'supplier_names_map\', {})\n    \n    add_line("六、供应商分析")\n    add_line("-" * 30)\n    if supplier_ids:\n        id_list_str = ",".join(map(str, supplier_ids))\n        sql_suppliers = f"""\n        SELECT code, name, contact, phone, address, status, created_at\n        FROM virtual_erp.suppliers\n        WHERE id IN ({id_list_str})\n        """\n        cursor.execute(sql_suppliers)\n        suppliers = cursor.fetchall()\n        \n        add_line(f"{\'编码\':<10} {\'名称\':<20} {\'联系人\':<10} {\'电话\':<15} {\'状态\':<6}")\n        for s in suppliers:\n            status_txt = "正常" if s[5] == 1 else "停用"\n            add_line(f"{s[0]:<10} {s[1]:<20} {s[2] or \'\':<10} {s[3] or \'\':<15} {status_txt:<6}")\n        \n        # 关联采购入库 (假设stock_logs中有ref_no关联到采购单，但这里没有直接的purchase_orders表，通常stock_logs的change_type=\'in\'且ref_no可能指向采购单)\n        # 由于表结构中没有明确的采购订单表，我们仅展示供应商基本信息。\n        # 如果有stock_logs可以反查，但缺乏直接外键。此处仅列出档案。\n    else:\n        add_line("未检测到相关供应商数据或ID列表为空。")\n    add_line("")\n\n    # --- 七、库存分析 ---\n    add_line("七、库存分析")\n    add_line("-" * 30)\n    add_line("各商品当前库存与资金占用详情:")\n    add_line(f"{\'商品名称\':<20} {\'库存量\':>6} {\'安全库存\':>8} {\'成本价\':>8} {\'库存金额\':>10} {\'库存/安全比\':>10}")\n    \n    product_stock_summary = handoff_data.get(\'product_stock_summary\', {})\n    for pid, pdata in product_stock_summary.items():\n        ratio = pdata[\'stock_qty\'] / pdata[\'safety_stock\'] if pdata[\'safety_stock\'] > 0 else 0\n        add_line(f"{pdata[\'name\']:<20} {pdata[\'stock_qty\']:>6} {pdata[\'safety_stock\']:>8} {pdata[\'cost_price\']:>8.2f} {pdata[\'stock_value\']:>10.2f} {ratio:>10.2f}")\n    \n    # 库存流水近期变动\n    sql_stock_logs_recent = """\n    SELECT sl.created_at, p.name, sl.change_type, sl.change_qty, sl.ref_no\n    FROM virtual_erp.stock_logs sl\n    JOIN virtual_erp.products p ON sl.product_id = p.id\n    ORDER BY sl.created_at DESC\n    LIMIT 10\n    """\n    cursor.execute(sql_stock_logs_recent)\n    logs = cursor.fetchall()\n    \n    add_line("\\n近期库存变动流水 (Top 10):")\n    add_line(f"{\'时间\':<20} {\'商品\':<20} {\'类型\':<8} {\'数量\':>6} {\'关联单号\':<15}")\n    for l in logs:\n        time_str = str(l[0])[:19]\n        add_line(f"{time_str:<20} {l[1]:<20} {l[2]:<8} {int(l[3]):>6} {l[4] or \'\':<15}")\n    add_line("")\n\n    # --- 八、经营诊断 ---\n    add_line("八、经营诊断")\n    add_line("-" * 30)\n    issues = []\n    \n    # 1. 库存积压风险\n    high_risk_items = handoff_data.get(\'high_risk_inventory_items\', [])\n    if high_risk_items:\n        # 找出库存远高于安全库存的商品\n        overstocked = [item for item in high_risk_items if item[\'stock_qty\'] > item[\'safety_stock\'] * 3]\n        if overstocked:\n            names = ", ".join([f"{i[\'name\']}({i[\'stock_qty\']}/{i[\'safety_stock\']})" for i in overstocked])\n            issues.append(f"库存积压风险：以下商品库存显著高于安全库存标准：{names}。这导致了大量资金沉淀。")\n            \n    # 2. 滞销商品\n    if slow_moving:\n        names = ", ".join([sm[0] for sm in slow_moving])\n        issues.append(f"滞销商品问题：{names} 在本期无任何销售记录，但仍占用库存资金。特别是折叠办公桌等高价商品，严重影响资金周转。")\n        \n    # 3. 客户集中度过高\n    if customers and len(customers) > 0:\n        top_spent = float(customers[0][3] or 0)\n        if total_sales > 0 and (top_spent / total_sales) > 0.5:\n            issues.append(f"客户依赖风险：第一大客户 \'{customers[0][0]}\' 贡献了超过50%的销售额 ({top_spent/total_sales*100:.2f}%)。若该客户流失，将对营收造成巨大冲击。")\n            \n    # 4. 毛利率波动或偏低 (简单判断)\n    margin_rate = (gross_profit / total_sales * 100) if total_sales > 0 else 0\n    if margin_rate < 20:\n        issues.append(f"盈利能力警示：整体毛利率仅为 {margin_rate:.2f}%，低于一般零售行业健康水平，需检查定价策略或成本控制。")\n    elif margin_rate > 0:\n        issues.append(f"盈利状况良好：整体毛利率为 {margin_rate:.2f}%。")\n\n    # 5. 订单取消率\n    if order_count > 0:\n        cancel_rate = (cancel_count / (order_count + cancel_count)) * 100\n        if cancel_rate > 10:\n             issues.append(f"运营效率问题：订单取消率达到 {cancel_rate:.2f}%，可能存在履约能力不足或需求预测偏差。")\n\n    for idx, issue in enumerate(issues, 1):\n        add_line(f"{idx}. {issue}")\n        \n    if not issues:\n        add_line("未发现显著经营异常。")\n    add_line("")\n\n    # --- 九、结论与建议 ---\n    add_line("九、结论与改进建议")\n    add_line("-" * 30)\n    add_line("核心财务指标汇总：")\n    add_line(f"  - 年销售额：{total_sales:.2f} 元")\n    add_line(f"  - 年毛利额：{gross_profit:.2f} 元")\n    add_line(f"  - 库存资金占用：{total_stock_value:.2f} 元")\n    add_line("")\n    add_line("主要问题摘要：")\n    for idx, issue in enumerate(issues, 1):\n        add_line(f"  {idx}. {issue.split(\'：\')[0] if \'：\' in issue else issue[:20]}...")\n    add_line("")\n    add_line("优先级最高的改进事项：")\n    recommendations = []\n    \n    if any("库存积压" in i or "滞销" in i for i in issues):\n        recommendations.append("1. 【紧急】清理滞销库存：针对折叠办公桌等零销售高库存商品，立即启动促销、折价处理或退货流程，释放被占用的资金。")\n        \n    if any("客户依赖" in i for i in issues):\n        recommendations.append("2. 【重要】拓展新客户：降低对单一客户的依赖度，制定营销计划吸引至少3-5家新的活跃客户，分散经营风险。")\n        \n    if any("毛利率" in i and "低" in i for i in issues):\n        recommendations.append("3. 【优化】审查成本与定价：重新评估低毛利商品的供应链成本，或与供应商谈判降价；同时考虑调整部分商品售价以提升整体利润率。")\n        \n    if not recommendations:\n        recommendations.append("1. 保持现有运营节奏，持续监控库存与销售数据的平衡。")\n        \n    for rec in recommendations:\n        add_line(rec)\n        \n    add_line("")\n    add_line("=" * 60)\n    add_line("报告结束")\n    add_line("=" * 60)\n\nexcept Exception as e:\n    add_line(f"生成报告过程中发生错误: {str(e)}")\nfinally:\n    if \'conn\' in locals() and conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n\n# 输出纯文本报告\nprint("\\n".join(report_lines))\n```\n**执行结果**:\n```text\n============================================================\nERP 年度经营分析报告\n============================================================\n\n一、报告概要\n------------------------------\n统计周期