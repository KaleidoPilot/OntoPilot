 cursor.fetchone()\n    gross_profit = float(gp_row[0]) if gp_row and gp_row[0] is not None else 0.0\n    \n    # 3. 查询库存总金额\n    # 库存金额 = 库存数量 * 成本价\n    sql_inventory_value = """\n        SELECT \n            SUM(stock_qty * cost_price) as inventory_total_value\n        FROM virtual_erp.products\n        WHERE status = 1\n    """\n    cursor.execute(sql_inventory_value)\n    inv_row = cursor.fetchone()\n    inventory_total_value = float(inv_row[0]) if inv_row and inv_row[0] is not None else 0.0\n    \n    # 输出结果表格\n    print("=== 经营总览数据 ===")\n    print(f"{\'指标\':<20} | {\'数值\':<20}")\n    print("-" * 45)\n    print(f"{\'本期销售总额\':<20} | {total_sales:<20.2f}")\n    print(f"{\'本期毛利额\':<20} | {gross_profit:<20.2f}")\n    print(f"{\'本期订单总数\':<20} | {total_orders:<20}")\n    print(f"{\'有成交客户数\':<20} | {active_customers:<20}")\n    print(f"{\'库存总金额\':<20} | {inventory_total_value:<20.2f}")\n    \n    # 传递关键汇总数据给后续步骤（虽然后续步骤可能重新查，但这里提供概览值供参考或校验）\n    handoff_data = {\n        "total_sales": total_sales,\n        "gross_profit": gross_profit,\n        "total_orders": total_orders,\n        "active_customers": active_customers,\n        "inventory_total_value": inventory_total_value\n    }\n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 2: 步骤2：查询销售订单详细分析数据，包括每笔订单的金额分布、状态变更情况及取消订单明细\n**执行代码**:\n```python\nimport json\nfrom datetime import datetime\n\ndef get_connection():\n    # 沙箱环境提供，此处仅为占位符，实际执行时由沙箱注入\n    pass\n\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n    \n    # 1. 查询每笔订单的金额分布、状态及关联客户信息\n    # 为了分析金额分布和状态变更，我们需要获取所有订单的基础数据\n    sql_orders = """\n    SELECT \n        so.id,\n        so.order_no,\n        so.customer_id,\n        c.name as customer_name,\n        so.order_date,\n        so.status,\n        so.total_amount,\n        so.created_at,\n        so.updated_at\n    FROM virtual_erp.sales_orders so\n    LEFT JOIN virtual_erp.customers c ON so.customer_id = c.id\n    ORDER BY so.order_date DESC;\n    """\n    cursor.execute(sql_orders)\n    orders_data = cursor.fetchall()\n    order_columns = [desc[0] for desc in cursor.description]\n    \n    print("=== 销售订单基础明细 ===")\n    if not orders_data:\n        print("无订单数据")\n    else:\n        header = "\\t".join(order_columns)\n        print(header)\n        for row in orders_data:\n            # 处理 Decimal 类型以便打印或后续转换，这里直接打印原始值\n            print("\\t".join([str(x) for x in row]))\n            \n    # 2. 查询取消订单的详细信息（包括商品明细）\n    # 假设 status 为 \'cancelled\' 或类似表示取消的状态。根据模板提示“取消订单”，我们筛选非正常完成或明确标记取消的。\n    # 由于不知道具体状态枚举值，先查出所有不同状态以辅助判断，但任务要求直接生成代码。\n    # 通常 ERP 中取消状态可能是 \'cancelled\', \'canceled\', \'voided\' 等。\n    # 为了稳妥，我们先查询所有订单明细，然后在 Python 层或 SQL 层通过状态过滤。\n    # 这里再次查询包含明细的订单，重点在于“取消订单”的分析。\n    \n    sql_cancelled_details = """\n    SELECT \n        so.order_no,\n        so.status,\n        so.total_amount,\n        p.name as product_name,\n        soi.qty,\n        soi.unit_price,\n        soi.amount as line_amount\n    FROM virtual_erp.sales_orders so\n    JOIN virtual_erp.sales_order_items soi ON so.id = soi.order_id\n    JOIN virtual_erp.products p ON soi.product_id = p.id\n    WHERE so.status IN (\'cancelled\', \'canceled\', \'voided\', \'已取消\') \n       OR so.status LIKE \'%cancel%\'\n       OR so.status LIKE \'%取消%\'\n    ORDER BY so.order_date DESC;\n    """\n    \n    cursor.execute(sql_cancelled_details)\n    cancelled_data = cursor.fetchall()\n    cancelled_columns = [desc[0] for desc in cursor.description]\n    \n    print("\\n=== 取消/异常订单明细 ===")\n    if not cancelled_data:\n        print("未发现明确标记为取消状态的订单明细，或状态字段取值不在预设列表中。")\n        # 如果没查到，可能需要检查所有状态分布\n        sql_status_dist = "SELECT status, COUNT(*) as count FROM virtual_erp.sales_orders GROUP BY status;"\n        cursor.execute(sql_status_dist)\n        status_dist = cursor.fetchall()\n        print("当前订单状态分布:")\n        for s in status_dist:\n            print(f"状态: {s[0]}, 数量: {s[1]}")\n    else:\n        header = "\\t".join(cancelled_columns)\n        print(header)\n        for row in cancelled_data:\n            print("\\t".join([str(x) for x in row]))\n\n    # 3. 计算关键指标用于 Handoff\n    # 提取所有订单ID列表，供后续步骤使用\n    all_order_ids = [row[0] for row in orders_data]\n    \n    # 提取取消订单的ID列表（如果上面查到了）\n    # 注意：上面的 cancelled_data 没有返回 so.id，需要重新查询或从 orders_data 中筛选\n    # 让我们从 orders_data 中提取取消订单的 ID\n    cancelled_order_ids = []\n    for row in orders_data:\n        # row structure: id, order_no, customer_id, customer_name, order_date, status, total_amount, created_at, updated_at\n        status = str(row[5]).lower()\n        if \'cancel\' in status or \'取消\' in status or \'void\' in status:\n            cancelled_order_ids.append(row[0])\n            \n    # 如果没有匹配到，尝试更宽松的匹配或者留空\n    if not cancelled_order_ids and cancelled_data:\n         # 如果之前的查询有结果但这里没匹配上，说明状态值可能特殊，这里仅作为示例逻辑\n         pass\n\n    handoff_data = {\n        "all_order_ids": all_order_ids,\n        "cancelled_order_ids": cancelled_order_ids\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    try:\n        if \'cursor\' in locals():\n            cursor.close()\n        if \'conn\' in locals():\n            conn.rollback()\n            conn.close()\n    except:\n        pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 3: 步骤3：查询商品维度分析数据，包括各商品的销量、销售额、成本、毛利、当前库存及安全库存设定\n**执行代码**:\n```python\nimport json\nfrom decimal import Decimal\n\ndef get_connection():\n    # 沙箱环境提供，此处仅为占位，实际执行时由沙箱注入\n    pass\n\nconn = None\ntry:\n    conn = get_connection()\n    cursor = conn.cursor(dictionary=True)\n    \n    # 查询商品维度分析数据：销量、销售额、成本、毛利、当前库存、安全库存\n    # 关联 sales_order_items (明细), products (商品), sales_orders (订单状态过滤有效订单)\n    sql = """\n    SELECT \n        p.id AS product_id,\n        p.sku,\n        p.name AS product_name,\n        p.category,\n        p.cost_price,\n        p.sale_price,\n        p.stock_qty,\n        p.safety_stock,\n        COALESCE(SUM(soi.qty), 0) AS total_sales_qty,\n        COALESCE(SUM(soi.amount), 0) AS total_sales_amount,\n        COALESCE(SUM(soi.qty * p.cost_price), 0) AS total_cost,\n        COALESCE(SUM(soi.amount - soi.qty * p.cost_price), 0) AS total_gross_profit\n    FROM virtual_erp.products p\n    LEFT JOIN virtual_erp.sales_order_items soi ON p.id = soi.product_id\n    LEFT JOIN virtual_erp.sales_orders so ON soi.order_id = so.id AND so.status != \'cancelled\'\n    GROUP BY \n        p.id, p.sku, p.name, p.category, p.cost_price, p.sale_price, p.stock_qty, p.safety_stock\n    ORDER BY total_sales_amount DESC\n    """\n    \n    cursor.execute(sql)\n    results = cursor.fetchall()\n    \n    # 打印表格\n    headers = ["Product ID", "SKU", "Name", "Category", "Cost Price", "Sale Price", "Stock Qty", "Safety Stock", "Total Sales Qty", "Total Sales Amount", "Total Cost", "Total Gross Profit"]\n    print("\\t".join(headers))\n    \n    handoff_data = []\n    for row in results:\n        # 处理 Decimal 类型以便 JSON 序列化\n        clean_row = {}\n        for k, v in row.items():\n            if isinstance(v, Decimal):\n                clean_row[k] = float(v)\n            else:\n                clean_row[k] = v\n        \n        # 构建输出行\n        line = [\n            str(clean_row.get(\'product_id\', \'\')),\n            str(clean_row.get(\'sku\', \'\')),\n            str(clean_row.get(\'product_name\', \'\')),\n            str(clean_row.get(\'category\', \'\')),\n            str(clean_row.get(\'cost_price\', \'\')),\n            str(clean_row.get(\'sale_price\', \'\')),\n            str(clean_row.get(\'stock_qty\', \'\')),\n            str(clean_row.get(\'safety_stock\', \'\')),\n            str(clean_row.get(\'total_sales_qty\', \'\')),\n            str(clean_row.get(\'total_sales_amount\', \'\')),\n            str(clean_row.get(\'total_cost\', \'\')),\n            str(clean_row.get(\'total_gross_profit\', \'\'))\n        ]\n        print("\\t".join(line))\n        \n        # 收集关键信息用于后续步骤（如经营诊断需要滞销品或高库存占用资金的商品）\n        handoff_data.append({\n            "product_id": clean_row.get(\'product_id\'),\n            "name": clean_row.get(\'product_name\'),\n            "stock_qty": clean_row.get(\'stock_qty\'),\n            "safety_stock": clean_row.get(\'safety_stock\'),\n            "cost_price": clean_row.get(\'cost_price\'),\n            "total_sales_qty": clean_row.get(\'total_sales_qty\'),\n            "total_sales_amount": clean_row.get(\'total_sales_amount\')\n        })\n\n    # 传递商品分析结果给后续步骤\n    print(\'__HANDOFF__\' + json.dumps({\'product_analysis\': handoff_data}))\n\nexcept Exception as e:\n    print(f"Error: {e}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n            conn.close()\n        except:\n            pass\n```\n**执行结果**:\n```text\nError: \'NoneType\' object has no attribute \'cursor\'\n```\n\n### 步骤 4: 步骤4：查询客户维度分析数据，包括各客户的订单记录、销售额贡献、建档时间及首次下单时间\n**执行代码**:\n```python\nimport json\nfrom datetime import datetime\n\nconn = get_connection()\ncursor = conn.cursor()\n\ntry:\n    # 1. 查询所有客户的基础信息（建档时间）\n    sql_customers = """\n        SELECT id, code, name, created_at \n        FROM virtual_erp.customers\n    """\n    cursor.execute(sql_customers)\n    customers_raw = cursor.fetchall()\n    \n    # 2. 查询每个客户的订单记录、销售额贡献、首次下单时间\n    # 关联销售订单表，按客户分组统计\n    sql_customer_stats = """\n        SELECT \n            c.id as customer_id,\n            c.name as customer_name,\n            COUNT(so.id) as order_count,\n            SUM(so.total_amount) as total_sales,\n            MIN(so.order_date) as first_order_date,\n            MAX(so.order_date) as last_order_date\n        FROM virtual_erp.customers c\n        LEFT JOIN virtual_erp.sales_orders so ON c.id = so.customer_id\n        GROUP BY c.id, c.name\n    """\n    cursor.execute(sql_customer_stats)\n    stats_raw = cursor.fetchall()\n    \n    # 3. 查询有成交的客户列表及其详细订单分布（用于分析集中度）\n    # 获取所有有效订单（非取消状态，假设 status != \'cancelled\' 或类似，这里先查全部再过滤或根据模板逻辑）\n    # 模板提到“4家客户中有2家贡献了全部销售额”，我们需要看具体数据\n    sql_all_orders_detail = """\n        SELECT \n            c.name as customer_name,\n            so.order_no,\n            so.order_date,\n            so.status,\n            so.total_amount\n        FROM virtual_erp.sales_orders so\n        JOIN virtual_erp.customers c ON so.customer_id = c.id\n        ORDER BY so.total_amount DESC\n    """\n    cursor.execute(sql_all_orders_detail)\n    orders_detail_raw = cursor.fetchall()\n\n    # 处理数据并打印报告所需内容\n    \n    # 构建客户基础信息字典\n    customer_info = {}\n    for row in customers_raw:\n        cid, code, name, created_at = row\n        customer_info[cid] = {\n            "code": code,\n            "name": name,\n            "created_at": str(created_at) if created_at else None\n        }\n        \n    # 构建客户统计字典\n    customer_stats = {}\n    for row in stats_raw:\n        cid, cname, o_count, t_sales, f_date, l_date = row\n        customer_stats[cid] = {\n            "name": cname,\n            "order_count": int(o_count) if o_count is not None else 0,\n            "total_sales": float(t_sales) if t_sales is not None else 0.0,\n            "first_order_date": str(f_date) if f_date else None,\n            "last_order_date": str(l_date) if l_date else None\n        }\n        \n    # 计算总销售额用于占比分析\n    total_system_sales = sum(s["total_sales"] for s in customer_stats.values())\n    \n    print("=== 五、客户分析 ===")\n    print("\\n1. 客户基础档案与交易概况:")\n    print(f"{\'客户名称\':<20} {\'客户编码\':<15} {\'建档时间\':<20} {\'订单数\':<8} {\'销售额(元)\':<15} {\'首次下单日期\':<15} {\'销售额占比\':<10}")\n    print("-" * 110)\n    \n    active_customers = []\n    for cid, stats in customer_stats.items():\n        info = customer_info.get(cid, {})\n        name = stats[\'name\']\n        code = info.get(\'code\', \'\')\n        created = info.get(\'created_at\', \'\')[:10] if info.get(\'created_at\') else \'\'\n        count = stats[\'order_count\']\n        sales = stats[\'total_sales\']\n        first_date = stats[\'first_order_date\'] if stats[\'first_order_date\'] else \'无\'\n        \n        ratio = (sales / total_system_sales * 100) if total_system_sales > 0 else 0\n        \n        print(f"{name:<20} {code:<15} {created:<20} {count:<8} {sales:<15.2f} {first_date:<15} {ratio:<9.2f}%")\n        \n        if count > 0:\n            active_customers.append({\n                "id": cid,\n                "name": name,\n                "sales": sales,\n                "orders": count\n            })\n            \n    print("\\n2. 关键指标汇总:")\n    total_customers = len(customers_raw)\n    active_customer_count = len(active_customers)\n    print(f"- 客户总数: {total_customers}")\n    print(f"- 有成交客户数: {active_customer_count}")\n    print(f"- 本期系统总销售额: {total_system_sales:.2f}")\n    \n    # 找出第一大客户\n    if active_customers:\n        top_customer = max(active_customers, key=lambda x: x[\'sales\'])\n        top_ratio = (top_customer[\'sales\'] / total_system_sales * 100) if total_system_sales > 0 else 0\n        print(f"- 第一大客户: {top_customer[\'name\']} (销售额: {top_customer[\'sales\']:.2f}, 占比: {top_ratio:.2f}%)")\n        \n        # 检查是否有客户销售额为0但有订单的情况（如取消订单），或者完全无订单\n        zero_sales_active = [c for c in active_customers if c[\'sales\'] == 0 and c[\'orders\'] > 0]\n        if zero_sales_active:\n            print(f"- 注意: 以下客户有订单记录但销售额为0 (可能均为取消/无效订单): {[c[\'name\'] for c in zero_sales_active]}")\n\n    print("\\n3. 重点客户订单明细 (Top 5 金额订单):")\n    print(f"{\'客户名称\':<20} {\'订单号\':<20} {\'下单日期\':<12} {\'状态\':<10} {\'金额(元)\':<15}")\n    print("-" * 80)\n    for row in orders_detail_raw[:5]:\n        cname, ono, odate, status, amount = row\n        print(f"{cname:<20} {ono:<20} {str(odate):<12} {status:<10} {float(amount):<15.2f}")\n\n    # 准备 Handoff 数据：后续步骤可能需要知道哪些客户是活跃的，或者具体的客户ID列表用于交叉验证\n    # 这里传递活跃客户ID和名称，以及总销售额供后续诊断使用\n    handoff_data = {\n        "active_customer_ids": [c[\'id\'] for c in active_customers],\n        "total_system_sales": round(total_system_sales, 2),\n        "customer_count_total": total_customers,\n        "customer_count_active": active_customer_count\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nfinally:\n    conn.rollback()\n    cursor.close()\n    conn.close()\n```\n**执行结果**:\n```text\n=== 五、客户分析 ===\n\n1. 客户基础档案与交易概况:\n客户名称                 客户编码            建档时间                 订单数      销售额(元)          首次下单日期          销售额占比     \n--------------------------------------------------------------------------------------------------------------\n上海星辰贸易有限公司           C20240001       2026-10-21           2        1164.50         2026-10-21      47.46    %\n深圳蓝海科技有限公司           C20240002       2026-10-21           1        890.00          2026-10-21      36.27    %\n北京华远商贸中心             C20240003       2026-10-21           0        0.00            无               0.00     %\n广州云帆电子有限公司           C2026102107302024 2026-10-21           1        399.00          2026-10-21      16.26    %\n\n2. 关键指标汇总:\n- 客户总数: 4\n- 有成交客户数: 3\n- 本期系统总销售额: 2453.50\n- 第一大客户: 上海星辰贸易有限公司 (销售额: 1164.50, 占比: 47.46%)\n\n3. 重点客户订单明细 (Top 5 金额订单):\n客户名称                 订单号                  下单日期         状态         金额(元)          \n--------------------------------------------------------------------------------\n深圳蓝海科技有限公司           SO202610210002       2026-10-21   pending    890.00         \n上海星辰贸易有限公司           SO202610210003       2026-10-21   paid       667.00         \n上海星辰贸易有限公司           SO202610210001       2026-10-21   pending    497.50         \n广州云帆电子有限公司           SO202610210004       2026-10-21   cancelled  399.00         \n```\n\n### 步骤 5: 步骤5：查询供应商及采购关联数据，包括供应商基础档案及对应的采购入库记录\n**执行代码**:\n```python\nimport json\n\ndef get_data():\n    conn = None\n    try:\n        conn = get_connection()\n        cursor = conn.cursor()\n        \n        results = {}\n        \n        # 1. 查询供应商基础档案信息\n        sql_suppliers = """\n        SELECT \n            id, \n            code, \n            name, \n            contact, \n            phone, \n            address, \n            status, \n            created_at, \n            updated_at \n        FROM virtual_erp.suppliers\n        """\n        cursor.execute(sql_suppliers)\n        supplier_cols = [desc[0] for desc in cursor.description]\n        supplier_rows = cursor.fetchall()\n        \n        print("=== 供应商基础档案 ===")\n        if not supplier_rows:\n            print("无数据")\n        else:\n            header = "\\t".join(supplier_cols)\n            print(header)\n            for row in supplier_rows:\n                print("\\t".join([str(c) if c is not None else \'\' for c in row]))\n        \n        results[\'suppliers\'] = [dict(zip(supplier_cols, row)) for row in supplier_rows]\n        \n        # 2. 查询采购入库记录及对应的供应商字段\n        # 注意：库存流水表 stock_logs 中 change_type 可能包含 \'purchase_in\' 或类似表示采购入库的类型。\n        # 由于表结构中没有直接的“采购单”表，通常通过 stock_logs 的变动类型和关联单号来推断。\n        # 这里假设 change_type 为 \'in\' 或 \'purchase\' 等代表入库，且需要关联到供应商。\n        # 但是 stock_logs 表中没有 supplier_id 字段。\n        # 检查表结构：stock_logs 只有 product_id, change_qty, change_type, ref_no, remark, created_at。\n        # suppliers 表是独立的。\n        # 题目要求：“采购入库记录及对应的供应商字段”。\n        # 如果 stock_logs 里没有 supplier_id，我们无法直接通过 SQL JOIN 得到每条入库记录对应的供应商，除非 ref_no 或 remark 中有线索，或者存在其他未提供的表。\n        # 根据给定的表结构，无法直接将 stock_logs 与 suppliers 进行逻辑上的强关联（如外键）。\n        # 但我们可以查询所有标记为入库类型的库存流水，并展示其详细信息。\n        # 为了尽可能满足“交叉分析”和“模板需求”，我们先查出所有可能的入库流水。\n        # 常见的入库类型可能是 \'in\', \'purchase\', \'init\' 等。这里我们列出所有 change_type 为 \'in\' 或包含 \'purchase\' 的记录，或者简单地列出所有正向变动的记录作为参考，并在代码注释说明限制。\n        # 更严谨的做法：查询 stock_logs 中 change_qty > 0 的记录，这通常代表入库。\n        \n        sql_stock_in = """\n        SELECT \n            sl.id,\n            sl.product_id,\n            p.name as product_name,\n            sl.change_qty,\n            sl.change_type,\n            sl.ref_no,\n            sl.remark,\n            sl.created_at\n        FROM virtual_erp.stock_logs sl\n        LEFT JOIN virtual_erp.products p ON sl.product_id = p.id\n        WHERE sl.change_qty > 0\n        ORDER BY sl.created_at DESC\n        """\n        cursor.execute(sql_stock_in)\n        stock_in_cols = [desc[0] for desc in cursor.description]\n        stock_in_rows = cursor.fetchall()\n        \n        print("\\n=== 采购/入库相关库存流水 (change_qty > 0) ===")\n        if not stock_in_rows:\n            print("无数据")\n        else:\n            header = "\\t".join(stock_in_cols)\n            print(header)\n            for row in stock_in_rows:\n                print("\\t".join([str(c) if c is not None else \'\' for c in row]))\n        \n        results[\'stock_in_records\'] = [dict(zip(stock_in_cols, row)) for row in stock_in_rows]\n        \n        # 3. 商品与供应商的关联数据\n        # 同样，基于现有表结构，products 表和 suppliers 表之间没有直接的外键关联。\n        # 通常 ERP 系统中会有 purchase_order_items 或 supplier_products 映射表，但此处未提供。\n        # 因此，无法生成精确的“商品-供应商”多对多关联列表。\n        # 我们将输出一个说明，指出当前数据结构下无法直接获取该关联，仅能分别查看商品和供应商列表。\n        print("\\n=== 商品与供应商关联说明 ===")\n        print("注意：当前数据库表结构中，products 表与 suppliers 表之间缺乏直接关联字段（如 supplier_id）或中间映射表（如 purchase_order_items）。")\n        print("因此，无法自动生成精确的商品-供应商对应关系。以下分别列出商品清单和供应商清单供人工比对或通过业务规则推断。")\n        \n        # 重新打印商品简要列表以便对照\n        sql_products_simple = """\n        SELECT id, sku, name, category, cost_price, sale_price, stock_qty \n        FROM virtual_erp.products\n        """\n        cursor.execute(sql_products_simple)\n        prod_cols = [desc[0] for desc in cursor.description]\n        prod_rows = cursor.fetchall()\n        \n        print("\\n--- 商品清单 ---")\n        header_p = "\\t".join(prod_cols)\n        print(header_p)\n        for row in prod_rows:\n            print("\\t".join([str(c) if c is not None else \'\' for c in row]))\n            \n        results[\'products_list\'] = [dict(zip(prod_cols, row)) for row in prod_rows]\n\n        return results\n\n    except Exception as e:\n        print(f"Error: {e}")\n        raise\n    finally:\n        if conn:\n            conn.rollback()\n            conn.close()\n\ndata = get_data()\n\n# 准备 Handoff 参数\n# 后续步骤可能需要供应商ID列表用于进一步筛选或统计\nsupplier_ids = [s[\'id\'] for s in data.get(\'suppliers\', [])]\nprint(\'__HANDOFF__\' + json.dumps({\'supplier_ids\': supplier_ids}))\n```\n**执行结果**:\n```text\n=== 供应商基础档案 ===\nid\tcode\tname\tcontact\tphone\taddress\tstatus\tcreated_at\tupdated_at\n1\tS20240001\t东莞精工电子厂\t陈明\t13900139001\t东莞市长安镇工业区\t1\t2026-10-21 15:30:08\t2026-10-21 15:30:08\n2\tS20240002\t杭州润泽包装材料有限公司\t刘芳\t13900139002\t杭州市余杭区仁和街道\t1\t2026-10-21 15:30:08\t2026-10-21 15:30:08\n\n=== 采购/入库相关库存流水 (change_qty > 0) ===\nid\tproduct_id\tproduct_name\tchange_qty\tchange_type\tref_no\tremark\tcreated_at\n12\t6\t折叠办公桌 120cm\t1\tin\tSO202610210004\t订单取消回补\t2026-10-21 15:57:08\n7\t1\t无线蓝牙耳机 Air Pro\t3\tin\tSO202610210003\t订单取消回补\t2026-10-21 15:49:56\n8\t4\t牛皮纸包装盒(中号)\t20\tin\tSO202610210003\t订单取消回补\t2026-10-21 15:49:56\n6\t5\t气泡袋 20x30cm\t200\tin\t\t采购入库\t2026-10-21 15:31:47\n\n=== 商品与供应商关联说明 ===\n注意：当前数据库表结构中，products 表与 suppliers 表之间缺乏直接关联字段（如 supplier_id）或中间映射表（如 purchase_order_items）。\n因此，无法自动生成精确的商品-供应商对应关系。以下分别列出商品清单和供应商清单供人工比对或通过业务规则推断。\n\n--- 商品清单 ---\nid\tsku\tname\tcategory\tcost_price\tsale_price\tstock_qty\n1\tP1001\t无线蓝牙耳机 Air Pro\t数码配件\t98.00\t199.00\t115\n2\tP1002\t65W 氮化镓快充充电器\t数码配件\t45.00\t89.00\t190\n3\tP1003\tType-C 数据线 1.5m\t数码配件\t6.50\t19.90\t495\n4\tP2001\t牛皮纸包装盒(中号)\t包装耗材\t1.80\t3.50\t780\n5\tP2002\t气泡袋 20x30cm\t包装耗材\t0.35\t1.00\t250\n6\tP3001\t折叠办公桌 120cm\t办公家具\t210.00\t399.00\t35\n```\n\n### 步骤 6: 步骤6：查询库存变动流水数据，包括本期各商品的入库与出库明细记录\n**执行代码**:\n```python\nimport pandas as pd\n\nconn = get_connection()\ntry:\n    cursor = conn.cursor()\n    \n    sql_stock_logs = """\n        SELECT \n            sl.id,\n            sl.product_id,\n            p.name AS product_name,\n            p.sku,\n            sl.change_qty,\n            sl.change_type,\n            sl.ref_no,\n            sl.remark,\n            sl.created_at\n        FROM virtual_erp.stock_logs sl\n        LEFT JOIN virtual_erp.products p ON sl.product_id = p.id\n        ORDER BY sl.created_at DESC\n    """\n    cursor.execute(sql_stock_logs)\n    rows = cursor.fetchall()\n    cols = [desc[0] for desc in cursor.description]\n    df_stock_logs = pd.DataFrame(rows, columns=cols)\n    \n    print("=== 库存变动流水明细 ===")\n    if not df_stock_logs.empty:\n        print(df_stock_logs.to_string(index=False))\n    else:\n        print("无库存变动流水数据")\n        \n    # 统计入库和出库汇总\n    sql_summary_in = """\n        SELECT \n            p.name AS product_name,\n            SUM(sl.change_qty) AS total_in_qty\n        FROM virtual_erp.stock_logs sl\n        JOIN virtual_erp.products p ON sl.product_id = p.id\n        WHERE sl.change_type LIKE \'%in%\' OR sl.change_type LIKE \'%入%\' OR sl.change_type IN (\'purchase\', \'return\')\n        GROUP BY p.name\n    """\n    cursor.execute(sql_summary_in)\n    rows_in = cursor.fetchall()\n    cols_in = [desc[0] for desc in cursor.description]\n    df_summary_in = pd.DataFrame(rows_in, columns=cols_in)\n    \n    print("\\n=== 本期入库汇总(按商品) ===")\n    if not df_summary_in.empty:\n        print(df_summary_in.to_string(index=False))\n    else:\n        print("无入库汇总数据或需根据实际change_type枚举值调整查询条件")\n\n    sql_summary_out = """\n        SELECT \n            p.name AS product_name,\n            SUM(sl.change_qty) AS total_out_qty\n        FROM virtual_erp.stock_logs sl\n        JOIN virtual_erp.products p ON sl.product_id = p.id\n        WHERE sl.change_type LIKE \'%out%\' OR sl.change_type LIKE \'%出%\' OR sl.change_type IN (\'sale\', \'loss\')\n        GROUP BY p.name\n    """\n    cursor.execute(sql_summary_out)\n    rows_out = cursor.fetchall()\n    cols_out = [desc[0] for desc in cursor.description]\n    df_summary_out = pd.DataFrame(rows_out, columns=cols_out)\n    \n    print("\\n=== 本期出库汇总(按商品) ===")\n    if not df_summary_out.empty:\n        print(df_summary_out.to_string(index=False))\n    else:\n        print("无出库汇总数据或需根据实际change_type枚举值调整查询条件")\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n=== 库存变动流水明细 ===\n id  product_id    product_name   sku  change_qty change_type         ref_no   remark          created_at\n 12           6     折叠办公桌 120cm P3001           1          in SO202610210004   订单取消回补 2026-10-21 15:57:08\n 11           6     折叠办公桌 120cm P3001          -1         out SO202610210004     销售出库 2026-10-21 15:56:51\n  7           1  无线蓝牙耳机 Air Pro P1001           3          in SO202610210003   订单取消回补 2026-10-21 15:49:56\n  8           4      牛皮纸包装盒(中号) P2001          20          in SO202610210003   订单取消回补 2026-10-21 15:49:56\n  9           1  无线蓝牙耳机 Air Pro P1001          -3         out SO202610210003 订单恢复重新出库 2026-10-21 15:49:56\n 10           4      牛皮纸包装盒(中号) P2001         -20         out SO202610210003 订单恢复重新出库 2026-10-21 15:49:56\n  6           5     气泡袋 20x30cm P2002         200          in            NaN     采购入库 2026-10-21 15:31:47\n  4           1  无线蓝牙耳机 Air Pro P1001          -3         out SO202610210003     销售出库 2026-10-21 15:30:22\n  5           4      牛皮纸包装盒(中号) P2001         -20         out SO202610210003     销售出库 2026-10-21 15:30:22\n  1           1  无线蓝牙耳机 Air Pro P1001          -2         out SO202610210001     销售出库 2026-10-21 15:30:08\n  2           3 Type-C 数据线 1.5m P1003          -5         out SO202610210001     销售出库 2026-10-21 15:30:08\n  3           2    65W 氮化镓快充充电器 P1002         -10         out SO202610210002     销售出库 2026-10-21 15:30:08\n\n=== 本期入库汇总(按商品) ===\n  product_name total_in_qty\n   折叠办公桌 120cm            1\n无线蓝牙耳机 Air Pro            3\n   气泡袋 20x30cm          200\n    牛皮纸包装盒(中号)           20\n\n=== 本期出库汇总(按商品) ===\n   product_name total_out_qty\n   65W 氮化镓快充充电器           -10\nType-C 数据线 1.5m            -5\n  