d_at) AS min_created_at,\n            MAX(updated_at) AS max_updated_at\n        FROM virtual_erp.sales_orders\n        WHERE YEAR(order_date) = 2026\n        GROUP BY status\n        ORDER BY total_amount_sum DESC\n    """\n    cursor.execute(sql_order_status)\n    rows_status = cursor.fetchall()\n    cols_status = [desc[0] for desc in cursor.description]\n    df_status = pd.DataFrame(rows_status, columns=cols_status)\n\n    # 计算金额占比\n    if not df_status.empty and df_status[\'total_amount_sum\'].sum() > 0:\n        df_status[\'amount_ratio\'] = (df_status[\'total_amount_sum\'] / df_status[\'total_amount_sum\'].sum()) * 100\n    else:\n        df_status[\'amount_ratio\'] = 0.0\n\n    print("=== 2026年销售订单各状态统计 ===")\n    print(df_status.to_string(index=False))\n    print()\n\n    # 2. 查询取消订单的备注信息（作为原因近似值）\n    sql_cancelled_remarks = """\n        SELECT \n            so.order_no,\n            so.customer_id,\n            c.name AS customer_name,\n            so.total_amount,\n            so.remark,\n            so.created_at,\n            so.updated_at\n        FROM virtual_erp.sales_orders so\n        LEFT JOIN virtual_erp.customers c ON so.customer_id = c.id\n        WHERE YEAR(so.order_date) = 2026\n          AND so.status = \'cancelled\'\n        ORDER BY so.total_amount DESC\n    """\n    cursor.execute(sql_cancelled_remarks)\n    rows_cancelled = cursor.fetchall()\n    cols_cancelled = [desc[0] for desc in cursor.description]\n    df_cancelled = pd.DataFrame(rows_cancelled, columns=cols_cancelled)\n\n    print("=== 2026年取消订单明细及备注 ===")\n    if df_cancelled.empty:\n        print("无取消订单记录")\n    else:\n        print(df_cancelled.to_string(index=False))\n    print()\n\n    # 3. 关联客户与商品明细，分析单笔订单的品项数与件数关系\n    sql_order_items_analysis = """\n        SELECT \n            so.order_no,\n            so.customer_id,\n            c.name AS customer_name,\n            so.status,\n            so.total_amount,\n            COUNT(DISTINCT soi.product_id) AS item_count,\n            SUM(soi.qty) AS total_qty,\n            AVG(soi.unit_price) AS avg_unit_price\n        FROM virtual_erp.sales_orders so\n        INNER JOIN virtual_erp.sales_order_items soi ON so.id = soi.order_id\n        LEFT JOIN virtual_erp.customers c ON so.customer_id = c.id\n        WHERE YEAR(so.order_date) = 2026\n        GROUP BY so.order_no, so.customer_id, c.name, so.status, so.total_amount\n        ORDER BY so.total_amount DESC\n    """\n    cursor.execute(sql_order_items_analysis)\n    rows_items = cursor.fetchall()\n    cols_items = [desc[0] for desc in cursor.description]\n    df_items = pd.DataFrame(rows_items, columns=cols_items)\n\n    print("=== 2026年订单品项数与件数分析 ===")\n    if df_items.empty:\n        print("无有效订单明细数据")\n    else:\n        print(df_items.head(50).to_string(index=False))  # 展示前50条避免输出过长\n        print(f"... 共 {len(df_items)} 条订单明细聚合记录")\n    print()\n\n    # 4. 汇总关键指标供后续步骤使用\n    # 提取所有2026年订单ID列表（用于后续库存流水关联等）\n    sql_order_ids = """\n        SELECT id \n        FROM virtual_erp.sales_orders \n        WHERE YEAR(order_date) = 2026\n    """\n    cursor.execute(sql_order_ids)\n    order_id_rows = cursor.fetchall()\n    order_ids = [row[0] for row in order_id_rows]\n\n    # 提取取消订单的order_no列表（便于后续深入分析）\n    cancelled_order_nos = []\n    if not df_cancelled.empty:\n        cancelled_order_nos = df_cancelled[\'order_no\'].tolist()\n\n    # 准备handoff数据\n    handoff_data = {\n        "sales_order_ids_2026": order_ids,\n        "cancelled_order_nos_2026": cancelled_order_nos,\n        "total_orders_2026": len(order_ids),\n        "total_cancelled_orders_2026": len(cancelled_order_nos)\n    }\n\n    print("__HANDOFF__" + json.dumps(handoff_data))\n\nexcept Exception as e:\n    print(f"查询出错: {str(e)}")\n    raise\nfinally:\n    try:\n        if \'cursor\' in locals():\n            cursor.close()\n        if \'conn\' in locals():\n            conn.rollback()\n            conn.close()\n    except:\n        pass\n```\n【执行报错】:\nError: NotImplementedError