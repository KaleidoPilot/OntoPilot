turn float(val)\n    except (ValueError, TypeError):\n        return 0.0\n\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n    \n    sql_asset = """\n    SELECT \n        m.ID AS asset_id,\n        m.ASSET_NAME,\n        m.ASSET_TYPE,\n        cf.ASSET_KZ_AREA,\n        cf.ASSET_BKZ_AREA,\n        cf.ASSET_TOTAL_AREA\n    FROM zszx.ZC_ASSET_INFO_MAIN m\n    JOIN zszx.ZC_ASSET_INFO_CF cf ON m.ID = cf.MAIN_ID\n    WHERE m.ORG_CODE = %s\n      AND m.REMOVED = 0\n      AND m.ENABLED = 1\n      AND cf.REMOVED = 0\n      AND cf.ENABLED = 1\n    """\n    cursor.execute(sql_asset, (\'MHKFQ\',))\n    columns_asset = [desc[0] for desc in cursor.description]\n    rows_asset = cursor.fetchall()\n    df_assets = pd.DataFrame(rows_asset, columns=columns_asset)\n    \n    sql_contract = """\n    SELECT \n        c.ASSET_ID,\n        c.LEASE_AREA,\n        c.END_DATE,\n        c.CUSTOMER_NAME,\n        c.CONTRACT_NO,\n        c.START_DATE\n    FROM zszx.ZC_CONTRACT_INFO c\n    WHERE c.ORG_CODE = %s\n      AND c.CONTRACT_STATE = 1\n      AND c.REMOVED = 0\n      AND c.ENABLED = 1\n    """\n    cursor.execute(sql_contract, (\'MHKFQ\',))\n    columns_contract = [desc[0] for desc in cursor.description]\n    rows_contract = cursor.fetchall()\n    df_contracts = pd.DataFrame(rows_contract, columns=columns_contract)\n    \n    cursor.close()\n    conn.rollback()\n    conn.close()\n    \nexcept Exception as e:\n    print(f"Error fetching data: {e}")\n    raise e\n\nif not df_assets.empty:\n    df_assets[\'KZ_AREA_NUM\'] = df_assets[\'ASSET_KZ_AREA\'].apply(to_float)\n    df_assets[\'BKZ_AREA_NUM\'] = df_assets[\'ASSET_BKZ_AREA\'].apply(to_float)\n    df_assets[\'TOTAL_AREA_NUM\'] = df_assets[\'ASSET_TOTAL_AREA\'].apply(to_float)\n    \n    today_str = datetime.now().strftime(\'%Y-%m-%d\')\n    \n    df_contracts[\'LEASE_AREA_NUM\'] = df_contracts[\'LEASE_AREA\'].apply(to_float)\n    df_contracts[\'END_DATE_DT\'] = pd.to_datetime(df_contracts[\'END_DATE\'], errors=\'coerce\')\n    df_contracts[\'START_DATE_DT\'] = pd.to_datetime(df_contracts[\'START_DATE\'], errors=\'coerce\')\n    \n    active_contracts = df_contracts[df_contracts[\'END_DATE_DT\'] >= datetime.now()]\n    \n    leased_area_by_asset = active_contracts.groupby(\'ASSET_ID\')[\'LEASE_AREA_NUM\'].sum().reset_index()\n    leased_area_by_asset.rename(columns={\'LEASE_AREA_NUM\': \'CURRENT_LEASED_AREA\'}, inplace=True)\n    \n    df_analysis = df_assets.merge(leased_area_by_asset, left_on=\'asset_id\', right_on=\'ASSET_ID\', how=\'left\')\n    df_analysis[\'CURRENT_LEASED_AREA\'] = df_analysis[\'CURRENT_LEASED_AREA\'].fillna(0).astype(float)\n    \n    df_analysis[\'VACANT_AREA\'] = df_analysis[\'KZ_AREA_NUM\'] - df_analysis[\'CURRENT_LEASED_AREA\']\n    df_analysis[\'VACANT_AREA\'] = df_analysis[\'VACANT_AREA\'].clip(lower=0)\n    \n    df_analysis[\'VACANCY_RATE\'] = df_analysis.apply(\n        lambda row: (row[\'VACANT_AREA\'] / row[\'KZ_AREA_NUM\'] * 100) if row[\'KZ_AREA_NUM\'] > 0 else 0, \n        axis=1\n    )\n    \n    three_months_later = datetime.now() + timedelta(days=90)\n    expiring_soon_contracts = df_contracts[\n        (df_contracts[\'END_DATE_DT\'] >= datetime.now()) & \n        (df_contracts[\'END_DATE_DT\'] <= three_months_later)\n    ]\n    \n    expiring_asset_ids = set(expiring_soon_contracts[\'ASSET_ID\'].unique())\n    df_analysis[\'HAS_EXPIRING_SOON\'] = df_analysis[\'asset_id\'].isin(expiring_asset_ids).map({True: \'是\', False: \'否\'})\n    \n    report_cols = [\'ASSET_NAME\', \'ASSET_TYPE\', \'KZ_AREA_NUM\', \'CURRENT_LEASED_AREA\', \'VACANT_AREA\', \'VACANCY_RATE\', \'HAS_EXPIRING_SOON\']\n    df_report = df_analysis[report_cols].copy()\n    \n    df_report[\'ASSET_TYPE\'] = df_report[\'ASSET_TYPE\'].map({1: \'厂房\', 2: \'土地\', 3: \'楼宇\', 4: \'其他\'}).fillna(\'未知\')\n    df_report[\'KZ_AREA_NUM\'] = df_report[\'KZ_AREA_NUM\'].round(2)\n    df_report[\'CURRENT_LEASED_AREA\'] = df_report[\'CURRENT_LEASED_AREA\'].round(2)\n    df_report[\'VACANT_AREA\'] = df_report[\'VACANT_AREA\'].round(2)\n    df_report[\'VACANCY_RATE\'] = df_report[\'VACANCY_RATE\'].round(2)\n    \n    df_report.sort_values(by=\'VACANCY_RATE\', ascending=False, inplace=True)\n    \n    print("=== 闵开发(MHKFQ)资产空置情况分析报告 ===")\n    print("\\n--- 1. 资产空置明细表 ---")\n    print(df_report.to_string(index=False))\n    \n    print("\\n--- 2. 整体统计摘要 ---")\n    total_kz_area = float(df_analysis[\'KZ_AREA_NUM\'].sum())\n    total_vacant_area = float(df_analysis[\'VACANT_AREA\'].sum())\n    overall_vacancy_rate = (total_vacant_area / total_kz_area * 100) if total_kz_area > 0 else 0\n    count_assets = len(df_analysis)\n    count_vacant_assets = len(df_analysis[df_analysis[\'VACANT_AREA\'] > 0])\n    \n    print(f"资产总数: {count_assets}")\n    print(f"存在空置的资产数: {count_vacant_assets}")\n    print(f"总可租面积: {total_kz_area:.2f} 平方米")\n    print(f"总空置面积: {total_vacant_area:.2f} 平方米")\n    print(f"整体空置率: {overall_vacancy_rate:.2f}%")\n    \n    print("\\n--- 3. 即将到期合同详情 (未来3个月内) ---")\n    if not expiring_soon_contracts.empty:\n        exp_detail = expiring_soon_contracts.merge(df_assets[[\'asset_id\', \'ASSET_NAME\']], left_on=\'ASSET_ID\', right_on=\'asset_id\', how=\'left\')\n        exp_detail_cols = [\'ASSET_NAME\', \'CUSTOMER_NAME\', \'CONTRACT_NO\', \'LEASE_AREA_NUM\', \'START_DATE\', \'END_DATE\']\n        exp_detail_report = exp_detail[exp_detail_cols].copy()\n        exp_detail_report[\'LEASE_AREA_NUM\'] = exp_detail_report[\'LEASE_AREA_NUM\'].round(2)\n        exp_detail_report.sort_values(by=\'END_DATE\', inplace=True)\n        print(exp_detail_report.to_string(index=False))\n    else:\n        print("无即将到期合同。")\n\nelse:\n    print("未查询到闵开发(MHKFQ)的有效资产数据。")\n```\n**执行结果**:\n```text\n=== 闵开发(MHKFQ)资产空置情况分析报告 ===\n\n--- 1. 资产空置明细表 ---\n                    ASSET_NAME ASSET_TYPE  KZ_AREA_NUM  CURRENT_LEASED_AREA  VACANT_AREA  VACANCY_RATE HAS_EXPIRING_SOON\n                F-TA-9东-南沙路68号         厂房      5275.71                 0.00      5275.71        100.00 