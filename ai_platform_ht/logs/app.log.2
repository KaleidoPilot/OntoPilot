y * p.cost_price), 0) AS total_cost_amount\n        FROM virtual_erp.products p\n        LEFT JOIN virtual_erp.sales_order_items soi ON p.id = soi.product_id\n        LEFT JOIN virtual_erp.sales_orders so ON soi.order_id = so.id AND YEAR(so.order_date) = 2026\n        WHERE p.status = 1\n        GROUP BY p.id, p.sku, p.name, p.category\n        ORDER BY total_sales_amount DESC\n    """\n    cursor.execute(sql_product_sales)\n    columns = [desc[0] for desc in cursor.description]\n    rows = cursor.fetchall()\n\n    # 计算总销售额用于占比\n    total_all_sales = sum(float(r[\'total_sales_amount\']) for r in rows) if rows else 0\n    \n    product_analysis_data = []\n    for row in rows:\n        sales_amt = float(row[\'total_sales_amount\'])\n        cost_amt = float(row[\'total_cost_amount\'])\n        gross_profit = sales_amt - cost_amt\n        profit_rate = (gross_profit / sales_amt * 100) if sales_amt > 0 else 0\n        sales_share = (sales_amt / total_all_sales * 100) if total_all_sales > 0 else 0\n        \n        product_analysis_data.append({\n            \'product_id\': row[\'product_id\'],\n            \'sku\': row[\'sku\'],\n            \'product_name\': row[\'product_name\'],\n            \'category\': row[\'category\'],\n            \'total_qty\': int(row[\'total_qty\']),\n            \'total_sales_amount\': round(sales_amt, 2),\n            \'total_cost_amount\': round(cost_amt, 2),\n            \'gross_profit\': round(gross_profit, 2),\n            \'profit_rate_pct\': round(profit_rate, 2),\n            \'sales_share_pct\': round(sales_share, 2)\n        })\n\n    # 打印商品维度分析表格\n    print("=== 2026年商品维度销售与毛利分析 ===")\n    header = "SKU | 商品名称 | 分类 | 销量 | 销售额 | 成本额 | 毛利额 | 毛利率(%) | 销售额占比(%)"\n    print(header)\n    print("-" * len(header))\n    for item in product_analysis_data:\n        line = f"{item[\'sku\']} | {item[\'product_name\']} | {item[\'category\']} | {item[\'total_qty\']} | {item[\'total_sales_amount\']:.2f} | {item[\'total_cost_amount\']:.2f} | {item[\'gross_profit\']:.2f} | {item[\'profit_rate_pct\']:.2f} | {item[\'sales_share_pct\']:.2f}"\n        print(line)\n\n    # 2. 识别主力商品（销售额占比前3或累计占比超过50%的商品，这里简单取前3作为示例逻辑，实际可根据需求调整）\n    # 为了更准确，我们标记销售额占比最高的几个为“主力”，销量为0的为“滞销”\n    main_products = []\n    stagnant_products = []\n    \n    # 按销售额排序后，取前N个或者占比高的。这里定义：销售额占比 >= 10% 或 排名前三 视为主力\n    sorted_by_sales = sorted(product_analysis_data, key=lambda x: x[\'total_sales_amount\'], reverse=True)\n    top3_ids = set(p[\'product_id\'] for p in sorted_by_sales[:3])\n    \n    for p in product_analysis_data:\n        is_main = (p[\'sales_share_pct\'] >= 10) or (p[\'product_id\'] in top3_ids and p[\'total_sales_amount\'] > 0)\n        is_stagnant = (p[\'total_qty\'] == 0)\n        \n        if is_main:\n            main_products.append(p[\'product_id\'])\n        if is_stagnant:\n            stagnant_products.append(p[\'product_id\'])\n\n    print("\\n=== 主力商品ID列表 ===")\n    print(main_products)\n    print("\\n=== 滞销商品ID列表(2026无销售) ===")\n    print(stagnant_products)\n\n    # 3. 筛选2026年无销售记录但有库存的商品，计算资金占用\n    # 注意：上面的SQL已经包含了所有在售商品。我们需要找出那些在2026年没有出现在sales_order_items中的商品。\n    # 由于LEFT JOIN导致total_qty为0的就是无销售记录的。\n    no_sales_with_stock = []\n    for p in product_analysis_data:\n        if p[\'total_qty\'] == 0:\n            # 需要单独查询该商品的当前库存数量，因为上面的SQL没查stock_qty\n            pass\n            \n    # 重新查询：获取2026年无销售且库存>0的商品详情及资金占用\n    sql_no_sales_stock = """\n        SELECT \n            p.id AS product_id,\n            p.sku,\n            p.name AS product_name,\n            p.category,\n            p.stock_qty,\n            p.cost_price,\n            (p.stock_qty * p.cost_price) AS capital_occupation\n        FROM virtual_erp.products p\n        WHERE p.status = 1\n          AND p.stock_qty > 0\n          AND NOT EXISTS (\n              SELECT 1 \n              FROM virtual_erp.sales_order_items soi\n              JOIN virtual_erp.sales_orders so ON soi.order_id = so.id\n              WHERE soi.product_id = p.id \n                AND YEAR(so.order_date) = 2026\n          )\n        ORDER BY capital_occupation DESC\n    """\n    cursor.execute(sql_no_sales_stock)\n    columns_ns = [desc[0] for desc in cursor.description]\n    rows_ns = cursor.fetchall()\n\n    no_sales_stock_data = []\n    total_capital_occupation = 0\n    for row in rows_ns:\n        cap_occ = float(row[\'capital_occupation\'])\n        total_capital_occupation += cap_occ\n        no_sales_stock_data.append({\n            \'product_id\': row[\'product_id\'],\n            \'sku\': row[\'sku\'],\n            \'product_name\': row[\'product_name\'],\n            \'category\': row[\'category\'],\n            \'stock_qty\': int(row[\'stock_qty\']),\n            \'cost_price\': float(row[\'cost_price\']),\n            \'capital_occupation\': round(cap_occ, 2)\n        })\n\n    print("\\n=== 2026年无销售但有库存的商品(滞销库存) ===")\n    if not no_sales_stock_data:\n        print("无此类商品")\n    else:\n        header_ns = "SKU | 商品名称 | 分类 | 库存数量 | 成本单价 | 资金占用额"\n        print(header_ns)\n        print("-" * len(header_ns))\n        for item in no_sales_stock_data:\n            line = f"{item[\'sku\']} | {item[\'product_name\']} | {item[\'category\']} | {item[\'stock_qty\']} | {item[\'cost_price\']:.2f} | {item[\'capital_occupation\']:.2f}"\n            print(line)\n        print(f"\\n滞销库存总资金占用: {total_capital_occupation:.2f}")\n\n    # 准备交接数据给后续步骤\n    # 1. 主力商品ID\n    # 2. 滞销且有库存的商品ID\n    # 3. 所有参与分析的商品ID（可选，视后续步骤需求而定，这里提供关键子集）\n    \n    handoff_data = {\n        \'main_product_ids\': main_products,\n        \'stagnant_in_stock_product_ids\': [p[\'product_id\'] for p in no_sales_stock_data],\n        \'total_capital_occupation_stagnant\': round(total_capital_occupation, 2)\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nexcept Exception as e:\n    raise e\nfinally:\n    if cursor:\n        cursor.close()\n    if conn:\n        try:\n            conn.rollback()\n        except:\n            pass\n        conn.close()\n```\n【执行报错】:\nError: TypeError: tuple indices must be integers or slices, not str\n\n请仔细分析报错原因并修复代码。注意：\n1. 如果是 SQL 语法或字段找不到错误，请检查 JOIN 条件、表别名或使用的数据表字段名是否正确。\n2. 如果是 Pandas 数据处理报错，请检查 DataFrame 的类型或缺失值。\n3. 如果是 __HANDOFF__ 打印报错（如 json 序列化失败），请只放入可 JSON 序列化的简单参数（int/float/str/列表），并把 DataFrame 等对象排除在外。\n4. 如果报错涉及 decimal.Decimal 与 float 混算（unsupported operand type(s) for /: \'float\' and \'decimal.Decimal\'），说明 MySQL 的 DECIMAL 列或 SUM/AVG 聚合结果返回的是 Decimal，必须在参与除法、百分比等运算前显式 float() 转换；round() 之后也要 float() 才能被 json.dumps 序列化。\n5. 如果提示“无输出”，说明代码执行完没有 print 任何内容。请补上 print(...)，把本步结果（如 df.to_string(index=False) 或关键数值）以纯文本打印出来，否则后续步骤和最终总结拿不到数据。\n请输出修复后的纯 Python 代码内容，不要包含任何 Markdown 标记（如 ```python 等）。'}], 'model': 'qwen3.8-flash', 'temperature': 0.3}, 'extra_json': {'enable_thinking': False}}
