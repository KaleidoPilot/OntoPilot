or i, row in enumerate(stock_logs_data):\n        if i >= display_limit:\n            break\n        lid, pid, pname, cqty, ctype, refno, remark, created_at = row\n        print(f"{lid:<5} {pid:<8} {pname:<20} {cqty:<10} {ctype:<10} {refno:<20} {str(created_at):<20}")\n        \n    if len(stock_logs_data) > display_limit:\n        print(f"... 还有 {len(stock_logs_data) - display_limit} 条记录未显示 ...")\n\n    # 3. 计算库存资金占用情况用于后续分析\n    # 将产品数据转换为字典方便后续步骤或本步内部逻辑使用\n    product_stock_map = {}\n    for row in products_stock_data:\n        pid, pname, qty, cost, price, safety = row\n        stock_value = float(qty) * float(cost) if qty and cost else 0.0\n        product_stock_map[str(pid)] = {\n            "name": pname,\n            "stock_qty": int(qty),\n            "cost_price": float(cost),\n            "sale_price": float(price),\n            "safety_stock": int(safety),\n            "stock_value": stock_value\n        }\n        \n    # 准备传递给下一步的数据：主要是库存相关的汇总指标和异常项\n    # 例如：高库存低周转风险商品（库存远高于安全库存且无近期出库）\n    high_risk_items = []\n    for pid_str, info in product_stock_map.items():\n        if info[\'safety_stock\'] > 0 and info[\'stock_qty\'] > info[\'safety_stock\'] * 2:\n             # 简单判断：库存超过安全库存2倍视为潜在积压风险\n             high_risk_items.append({\n                 "product_id": int(pid_str),\n                 "name": info[\'name\'],\n                 "stock_qty": info[\'stock_qty\'],\n                 "safety_stock": info[\'safety_stock\'],\n                 "stock_value": info[\'stock_value\']\n             })\n             \n    total_stock_value = sum([info[\'stock_value\'] for info in product_stock_map.values()])\n    \n    handoff_data = {\n        "total_stock_value": round(total_stock_value, 2),\n        "high_risk_inventory_items": high_risk_items,\n        "product_stock_summary": product_stock_map # 传递完整映射供后续交叉分析\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_data))\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n【执行报错】:\nError: Type