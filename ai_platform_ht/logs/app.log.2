rp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "id", "columnType": "int(11)", "columnComment": "主键id"}], "relationIds": [], "derivation": "按 status 分组统计 COUNT(id)，区分有效与取消状态", "conditions": ["由用户确认哪些 status 值代表\'有效\'，哪些代表\'取消\'"], "note": "依赖 sales_orders.status 字段，具体状态枚举值需用户定义"}, {"dataNeed": "总销售额、总毛利、总成本", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "amount", "columnType": "decimal(14,2)", "columnComment": "行金额"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}], "relationIds": [{"projectGroupId": 38, "relationId": 27}, {"projectGroupId": 38, "relationId": 28}], "derivation": "总销售额=SUM(sales_order_items.amount)；总成本=SUM(sales_order_items.qty * products.cost_price)；总毛利=总销售额-总成本", "conditions": ["按用户需求确定统计期间及有效订单范围"], "note": "通过订单明细关联商品表获取成本价计算毛利"}, {"dataNeed": "总成交件数", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}], "relationIds": [{"projectGroupId": 38, "relationId": 27}], "derivation": "SUM(sales_order_items.qty)", "conditions": ["按用户需求确定统计期间及有效订单范围"], "note": "汇总所有有效订单明细的数量"}, {"dataNeed": "库存总金额（成本价与销售价）", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "stock_qty", "columnType": "int(11)", "columnComment": "库存数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "sale_price", "columnType": "decimal(12,2)", "columnComment": "销售价"}], "relationIds": [], "derivation": "库存成本总额=SUM(products.stock_qty * products.cost_price)；库存销售货值总额=SUM(products.stock_qty * products.sale_price)", "conditions": ["按用户需求确定是否包含下架商品或特定分类"], "note": "直接基于商品表当前库存快照计算"}], "dataInputs": [], "unmappedDataNeeds": ["单笔订单金额明细"]}, {"id": "sales_order_analysis", "heading": "三、销售订单分析", "instruction": "1. **规模与分布**：列表展示各订单金额及占比，分析金额极差与均值关系。2. **构成逻辑**：分析订单内的品项数与件数，揭示“件数与金额不成正比”的现象，指出低值易耗品对物流成本的潜在影响。3. **流转状态**：统计各状态（待处理、已付款、发货等）的订单数与金额占比，计算状态变更频率，定位流程停滞环节。4. **取消订单**：单独分析取消订单的原因及其对特定品类销售的连锁影响。", "format": "table", "formats": ["table", "prose"], "intent": "深入剖析订单的结构、构成逻辑及流转状态，识别履约瓶颈。", "analysis": ["对比订单金额分布与平均值", "关联订单件数与金额，评估拣货效率与价值密度", "追踪订单状态变化时间戳，计算推进率", "评估取消订单对品类完整性的冲击"], "dataNeeds": ["订单号、客户、金额、状态", "订单内商品明细（品项、件数、单价）", "订单创建时间与状态变更时间", "取消订单的具体原因或时间点"], "dataSources": [{"dataNeed": "订单号、客户、金额、状态", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "order_no", "columnType": "varchar(32)", "columnComment": "订单号"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "customer_id", "columnType": "int(11)", "columnComment": "关联客户id"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "total_amount", "columnType": "decimal(14,2)", "columnComment": "订单总额"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "status", "columnType": "varchar(16)", "columnComment": "订单状态"}], "relationIds": [{"projectGroupId": 38, "relationId": 26}], "derivation": "", "conditions": ["按用户需求确定统计期间"], "note": "客户名称需通过 customer_id 关联 customers.name 获取"}, {"dataNeed": "订单内商品明细（品项、件数、单价）", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "product_id", "columnType": "int(11)", "columnComment": "商品id"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "unit_price", "columnType": "decimal(12,2)", "columnComment": "成交单价"}], "relationIds": [{"projectGroupId": 38, "relationId": 27}, {"projectGroupId": 38, "relationId": 28}], "derivation": "", "conditions": ["按用户需求确定统计期间"], "note": "品项名称需通过 product_id 关联 products.name 获取"}, {"dataNeed": "订单创建时间与状态变更时间", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "created_at", "columnType": "datetime", "columnComment": "创建时间"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "updated_at", "columnType": "datetime", "columnComment": "更新时间"}], "relationIds": [], "derivation": "", "conditions": ["按用户需求确定统计期间"], "note": "updated_at 通常反映最近一次状态变更时间，非完整历史轨迹"}], "dataInputs": [{"dataNeed": "取消订单的具体原因或时间点", "kind": "user_input", "sectionIds": [], "reason": "数据库中仅有 remark 文本字段，无结构化的取消原因代码，且 updated_at 仅为最后修改时间，无法精确还原取消动作发生的时间点，需用户补充或接受近似值"}], "unmappedDataNeeds": []}, {"id": "product_analysis", "heading": "四、商品分析", "instruction": "1. **销量与销售额**：列表对比各商品的销量占比与销售额占比，揭示“走量不创收”或“高价低频”的商品类型。2. **毛利贡献**：计算各商品毛利额及占比，分析高毛利率是否转化为高毛利额。3. **分级管理**：按销售额累计占比将商品分为主力、重点、补充、滞销四档。4. **滞销专项**：重点分析零销售商品的库存资金占用比例，量化其沉淀成本。", "format": "table", "formats": ["table", "prose"], "intent": "评估商品的销售表现、盈利贡献及生命周期阶段，识别主力与滞销品。", "analysis": ["计算销量与销售额的错位系数", "分解毛利来源，区分定价策略与销量驱动", "应用帕累托原则（80/20法则）进行商品分级", "计算滞销商品的资金占用率"], "dataNeeds": ["各商品销量、销售额、成本、毛利", "商品分类信息", "无销售记录的商品清单及其库存量"], "dataSources": [{"dataNeed": "各商品销量、销售额、成本、毛利", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "amount", "columnType": "decimal(14,2)", "columnComment": "行金额"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}], "relationIds": [{"projectGroupId": 38, "relationId": 28}], "derivation": "按 product_id 分组：销量=SUM(qty)；销售额=SUM(amount)；成本=SUM(qty * cost_price)；毛利=销售额-成本", "conditions": ["按用户需求确定统计期间及有效订单范围"], "note": "需关联订单明细与商品表计算单品贡献"}, {"dataNeed": "商品分类信息", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "category", "columnType": "varchar(64)", "columnComment": "分类"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接取自商品表 category 字段"}, {"dataNeed": "无销售记录的商品清单及其库存量", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "id", "columnType": "int(11)", "columnComment": ""}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "stock_qty", "columnType": "int(11)", "columnComment": "库存数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "product_id", "columnType": "int(11)", "columnComment": "商品id"}], "relationIds": [{"projectGroupId": 38, "relationId": 28}], "derivation": "筛选在指定统计期间内未出现在 sales_order_items.product_id 中的商品，返回其 id, name, stock_qty", "conditions": ["按用户需求确定统计期间"], "note": "需排除有销售记录的商品，识别滞销或新品"}], "dataInputs": [], "unmappedDataNeeds": []}, {"id": "customer_analysis", "heading": "五、客户分析", "instruction": "1. **贡献度**：列表展示各客户的订单数、销售额、客单价及占比。对比高频低额与低频高额客户的行为差异。2. **集中度**：计算第一大客户占比、前两大客户累计占比及赫芬达尔指数（HHI）或类似集中度指标，对照参考标准评估风险。3. **活跃与转化**：统计有成交客户占比，分析未成交客户的状态（建档未下单、首单取消等），评估复购潜力。", "format": "table", "formats": ["table", "prose"], "intent": "评估客户贡献度、集中度风险及活跃度，判断市场依赖程度。", "analysis": ["排序客户销售额并计算累计占比", "评估单一客户流失对营收的影响幅度", "区分新客、老客、沉睡客的行为特征"], "dataNeeds": ["客户名称、订单数、总销售额", "客户建档时间与首次/最近交易时间", "客户状态（正常、停用等）"], "dataSources": [{"dataNeed": "客户名称、订单数、总销售额", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "name", "columnType": "varchar(128)", "columnComment": "客户名称"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "id", "columnType": "int(11)", "columnComment": "主键id"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "total_amount", "columnType": "decimal(14,2)", "columnComment": "订单总额"}], "relationIds": [{"projectGroupId": 38, "relationId": 26}], "derivation": "按 customer_id 分组：订单数=COUNT(sales_orders.id)；总销售额=SUM(sales_orders.total_amount)", "conditions": ["按用户需求确定统计期间及有效订单范围"], "note": "关联客户表与销售订单表"}, {"dataNeed": "客户建档时间与首次/最近交易时间", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "created_at", "columnType": "datetime", "columnComment": "创建时间"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "order_date", "columnType": "date", "columnComment": "下单日期"}], "relationIds": [{"projectGroupId": 38, "relationId": 26}], "derivation": "建档时间=customers.created_at；首次交易=MIN(sales_orders.order_date)；最近交易=MAX(sales_orders.order_date)", "conditions": ["按用户需求确定统计期间"], "note": "需聚合订单日期获取首末交易时间"}, {"dataNeed": "客户状态（正常、停用等）", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "status", "columnType": "int(11)", "columnComment": "1正常 0停用"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接取自客户表 status 字段 (1正常 0停用)"}], "dataInputs": [], "unmappedDataNeeds": []}, {"id": "supplier_analysis", "heading": "六、供应商分析", "instruction": "1. **资源现状**：列出供应商基本信息及状态，注明是否为初始化录入。2. **业务衔接**：检查系统中是否存在商品与供应商的对应关系（如采购单据、入库批次归属）。若无直接关联，明确指出“采购来源不可追溯”及由此导致的成本核算盲区。3. **品类推测**：基于供应商名称或主营方向，合理推断其可能对应的商品品类，但需标注此为推测而非实证。4. **小结**：总结供应商在当期业务中的实际贡献（通常为0或极低）。", "format": "table", "formats": ["table", "prose"], "intent": "审查供应商资源现状及其与实际业务的关联度，识别采购溯源断点。", "analysis": ["验证供应商ID与商品/订单数据的关联性", "评估采购成本分摊的可行性", "识别供应链管理的空白环节"], "dataNeeds": ["供应商档案信息", "采购入库记录（若有）", "商品成本构成明细"], "dataSources": [{"dataNeed": "供应商档案信息", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "code", "columnType": "varchar(32)", "columnComment": "供应商编码"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "name", "columnType": "varchar(128)", "columnComment": "供应商名称"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "contact", "columnType": "varchar(64)", "columnComment": "联系人"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "phone", "columnType": "varchar(32)", "columnComment": "电话"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "address", "columnType": "varchar(255)", "columnComment": "地址"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "status", "columnType": "int(11)", "columnComment": "1正常 0停用"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接读取供应商表基础字段"}], "dataInputs": [{"dataNeed": "采购入库记录（若有）", "kind": "user_input", "sectionIds": [], "reason": "当前提供的表结构中无独立的采购单表或入库单表，stock_logs 可能包含入库流水但缺乏供应商ID关联，需用户确认是否有其他数据来源或接受\'不可追溯\'的结论"}], "unmappedDataNeeds": ["商品成本构成明细"]}, {"id": "inventory_analysis", "heading": "七、库存分析", "instruction": "1. **结构与资金**：按品类统计库存数量、成本金额、销售货值及占比。对比不同品类的资金占用效率（如高值低频 vs 低值高频）。2. **预警检查**：列出低于安全库存的商品数（通常为0时，需解释为库存过剩而非缺货）。计算当前库存与安全库存的倍数关系，评估预警阈值设定的合理性。3. **进销存动态**：统计入库、出库次数及净变动，区分真实采购入库与退货回补。4. **动销效率**：计算各商品及整体的动销率（销量/(销量+库存)）和库销比，识别周转缓慢的商品。", "format": "table", "formats": ["table", "prose"], "intent": "分析库存结构、资金占用效率及预警机制的有效性。", "analysis": ["计算库存资金占用率与变现潜力差额", "评估安全库存设置与实际销售节奏的匹配度", "通过库销比预测去库存所需周期"], "dataNeeds": ["各商品当前库存数量、成本价、售价", "安全库存设定值", "本期入库、出库流水记录", "本期销量数据"], "dataSources": [{"dataNeed": "各商品当前库存数量、成本价、售价", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "stock_qty", "columnType": "int(11)", "columnComment": "库存数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "sale_price", "columnType": "decimal(12,2)", "columnComment": "销售价"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接取自商品表当前快照数据"}, {"dataNeed": "安全库存设定值", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "safety_stock", "columnType": "int(11)", "columnComment": "安全库存"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接取自商品表 safety_stock 字段"}, {"dataNeed": "本期入库、出库流水记录", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "change_type", "columnType": "varchar(16)", "columnComment": "变动类型"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "change_qty", "columnType": "int(11)", "columnComment": "变动数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "created_at", "columnType": "datetime", "columnComment": "创建时间"}], "relationIds": [{"projectGroupId": 38, "relationId": 29}], "derivation": "", "conditions": ["按用户需求确定统计期间"], "note": "需根据 change_type 区分入库/出库，具体类型值需用户确认"}, {"dataNeed": "本期销量数据", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}], "relationIds": [{"projectGroupId": 38, "relationId": 27}, {"projectGroupId": 38, "relationId": 28}], "derivation": "SUM(sales_order_items.qty) 按商品分组", "conditions": ["按用户需求确定统计期间及有效订单范围"], "note": "用于计算动销率，需关联订单明细"}], "dataInputs": [], "unmappedDataNeeds": []}, {"id": "diagnosis", "heading": "八、经营诊断", "instruction": "1. **核心发现**：以表格形式列出7-9项关键发现，每项附带具体数据依据（如“营收集中：2款商品贡献91%销售额”）。2. **轻重缓急**：将发现分为三类：直接影响现金流/利润的（如滞销资金占用、订单停滞）、结构性缺陷（如供应商空转、预警失效）、阶段性特征（如客户集中）。优先处理确定性高且金额大的问题。", "format": "table", "formats": ["table", "prose"], "intent": "综合前述分析，提炼核心问题并按轻重缓急排序。", "analysis": ["交叉验证各环节数据的一致性", "根据金额大小和数据确凿程度对问题进行优先级排序", "区分短期战术问题与长期战略隐患"], "dataNeeds": ["前文所有章节的关键异常数据点"], "dataSources": [], "dataInputs": [{"dataNeed": "前文所有章节的关键异常数据点", "kind": "section_result", "sectionIds": ["business_overview", "sales_order_analysis", "product_analysis", "customer_analysis", "supplier_analysis", "inventory_analysis"], "reason": "诊断章节依赖于前序分析章节得出的具体数值和结论，非原始数据库字段"}], "unmappedDataNeeds": []}, {"id": "conclusion", "heading": "九、结论", "instruction": "回顾核心财务数据，定性评价盈利能力与规模结构的关系。分别简述商品、客户、供应商、库存四个维度的最终状态。指出当前业务闭环的完整性与存在的断点。最后，基于紧迫程度，点名最需要立即解决的两个具体问题（如处置某滞销品、推进某批订单）。", "format": "prose", "formats": ["prose"], "intent": "总结全文，重申核心观点，提出明确的行动指向。", "analysis": ["综合评估业务健康度", "提炼最具操作性的改进建议"], "dataNeeds": ["全文核心结论摘要"], "dataSources": [], "dataInputs": [{"dataNeed": "全文核心结论摘要", "kind": "section_result", "sectionIds": ["diagnosis"], "reason": "结论章节是对诊断章节结果的总结，依赖前序输出"}], "unmappedDataNeeds": []}], "rules": ["所有数值必须源自提供的业务数据，严禁虚构。", "若样本量过小导致无法进行同比/环比分析，需在报告中明确声明侧重结构分析。", "对于系统中缺失的数据关联（如供应商与商品无绑定），应如实指出“不可追溯”或“数据断层”，不得强行建立虚假联系。", "表格中的数据列顺序应与模板保持一致（如：指标、数值、说明；或 商品、销量、销售额...）。", "分析时需区分“事实陈述”与“合理推测”，推测内容需加注说明（如供应商品类对应关系）。", "语气保持客观、专业，避免情绪化词汇，聚焦于数据背后的业务逻辑。", "核心摘要部分应独立于正文，便于管理层快速阅读。", "保留模板明确的排名数量、筛选范围和表格列顺序；例如前三名不能自行改成前五名。本次用户明确调整时才按新要求执行。", "原模板没有图表且用户未要求时不主动新增图表。构成图只使用互斥的明细项，禁止把合计、小计、总计作为一个类别重复计算。", "库存缺口数量=max(安全库存-当前库存,0)，不能出现负数；模板要求库存风险清单时，仅列正缺口商品，不把正常库存混入风险清单。", "数据需求区分数据库字段、用户需确认的业务口径、前序章节结果及真正缺项；已有前文结果不要求用户重复提供。"], "presentation": {"version": 1, "outline": ["一、报告概要\\t1", "二、经营总览\\t1", "三、销售订单分析\\t1", "四、商品分析\\t1", "五、客户分析\\t1", "六、供应商分析\\t1", "七、库存分析\\t1", "八、经营诊断\\t1", "九、结论\\t1", "一、报告概要", "二、经营总览", "三、销售订单分析", "四、商品分析", "五、客户分析", "六、供应商分析", "七、库存分析", "八、经营诊断", "九、结论"], "roles": {"title": {"fontFamily": "Microsoft YaHei", "fontSize": 11.0, "bold": false, "alignment": "center", "firstLineIndent": 0, "leftIndent": 0, "rightIndent": 0, "spaceBefore": 150.0, "spaceAfter": 18.0, "lineMultiple": 1.75}, "body": {"fontFamily": "SimSun", "fontSize": 12.0, "bold": false, "alignment": "justify", "firstLineIndent": 24.0, "leftIndent": 0, "rightIndent": 0, "spaceBefore": 0, "spaceAfter": 8.0, "lineMultiple": 1.75}, "section": {"fontFamily": "SimSun", "fontSize": 12.0, "bold": false, "alignment": "left", "firstLineIndent": 0, "leftIndent": 0.0, "rightIndent": 0, "spaceBefore": 6.0, "spaceAfter": 6.0, "lineMultiple": 1.5}}, "page": {"width": 595.3, "height": 841.9, "left": 90.0, "right": 90.0, "top": 72.0, "bottom": 72.0}, "signatureCount": 0, "maxHeadingLevel": 2}, "projectGroupIds": [38], "dataContext": {"groups": [{"id": 38, "groupName": "erp测试商品", "databaseName": "virtual_erp", "tables": [{"id": 109, "tableName": "virtual_erp.customers", "tableCnName": "客户表", "comment": "客户表", "columns": [{"name": "id", "type": "int(11)", "comment": "", "remark": ""}, {"name": "code", "type": "varchar(32)", "comm