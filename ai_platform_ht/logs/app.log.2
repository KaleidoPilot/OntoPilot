FROM SKILL s
JOIN PROJECT_GROUP g ON g.ID = s.PROJECT_GROUP_ID AND g.ORG_ID = s.ORG_ID
JOIN PROJECT_GROUP root ON root.ID = COALESCE(g.PARENT_ID, g.ID) AND root.ORG_ID = s.ORG_ID
