未到期”。\n    \n    sql = """\n    SELECT \n        b.ID as bill_id,\n        c.CONTRACT_NO,\n        c.ORG_CODE,\n        c.LESSOR,\n        b.BILL_TYPE,\n        b.START_DATE,\n        b.END_DATE,\n        b.DUE_PRICE,\n        b.SETTLE_STATE,\n        COALESCE(SUM(p.PAYABLE_MONEY), 0) as total_paid\n    FROM zszx.ZC_CONTRACT_BILL b\n    JOIN zszx.ZC_CONTRACT_INFO c ON b.CONTRACT_ID = c.ID\n    LEFT JOIN zszx.ZC_CONTRACT_PAYABLE_LOG p ON b.ID = p.BILL_ID AND p.REMOVED = 0 AND p.ENABLED = 1\n    WHERE b.REMOVED = 0 \n      AND b.ENABLED = 1\n      AND c.REMOVED = 0 \n      AND c.ENABLED = 1\n      AND YEAR(b.START_DATE) <= %s\n      AND YEAR(b.END_DATE) >= %s\n    GROUP BY b.ID, c.CONTRACT_NO, c.ORG_CODE, c.LESSOR, b.BILL_TYPE, b.START_DATE, b.END_DATE, b.DUE_PRICE, b.SETTLE_STATE\n    HAVING b.DUE_PRICE > total_paid OR b.SETTLE_STATE != 1\n    """\n    \n    cursor.execute(sql, (report_year, report_year))\n    rows = cursor.fetchall()\n    \n    # 定义账龄区间统计\n    aging_buckets = {\n        "未到期": {"count": 0, "amount": 0.0},\n        "逾期1-30天": {"count": 0, "amount": 0.0},\n        "逾期31-90天": {"count": 0, "amount": 0.0},\n        "逾期91-180天": {"count": 0, "amount": 0.0},\n        "逾期180天以上": {"count": 0, "amount": 0.0}\n    }\n    \n    # 存储严重逾期（如90天以上）的合同ID，供后续步骤使用\n    severe_overdue_contract_ids = set()\n    \n    for row in rows:\n        bill_id, contract_no, org_code, lessor, bill_type, start_date_str, end_date_str, due_price, settle_state, total_paid = row\n        \n        if due_price is None or due_price == 0:\n            continue\n            \n        # 计算剩余待收金额\n        remaining_due = float(due_price) - float(total_paid)\n        \n        # 如果剩余待收金额小于等于0，说明已结清或超额支付，跳过\n        if remaining_due <= 0.001: # 浮点数容差\n            continue\n            \n        # 解析日期\n        try:\n            end_date = datetime.strptime(end_date_str, \'%Y-%m-%d\') if end_date_str else None\n        except:\n            end_date = None\n            \n        # 确定账龄区间\n        bucket_key = None\n        overdue_days = 0\n        \n        if end_date is None:\n            # 如果没有结束日期，无法计算逾期，归为未到期或特殊处理，这里暂归为未到期\n            bucket_key = "未到期"\n        elif current_date <= end_date:\n            # 当前时间在账单周期内或之前，未到期\n            bucket_key = "未到期"\n        else:\n            # 已过期，计算逾期天数\n            overdue_days = (current_date - end_date).days\n            \n            if overdue_days <= 30:\n                bucket_key = "逾期1-30天"\n            elif overdue_days <= 90:\n                bucket_key = "逾期31-90天"\n            elif overdue_days <= 180:\n                bucket_key = "逾期91-180天"\n            else:\n                bucket_key = "逾期180天以上"\n                \n            # 记录严重逾期（>90天）的合同ID\n            if overdue_days > 90:\n                # 需要获取 CONTRACT_ID，上面SQL没选，但可以通过bill_id反推或者重新查？\n                # 为了效率，我们在SQL里最好带上 CONTRACT_ID。\n                pass \n\n    # 由于上面的循环中没有CONTRACT_ID，我们需要调整SQL或在Python中处理。\n    # 让我们重新执行一个包含CONTRACT_ID的查询，或者在第一次查询时就带上。\n    # 修正：重新查询以包含 CONTRACT_ID\n    \n    sql_corrected = """\n    SELECT \n        b.ID as bill_id,\n        b.CONTRACT_ID,\n        c.CONTRACT_NO,\n        c.ORG_CODE,\n        b.BILL_TYPE,\n        b.START_DATE,\n        b.END_DATE,\n        b.DUE_PRICE,\n        b.SETTLE_STATE,\n        COALESCE(SUM(p.PAYABLE_MONEY), 0) as total_paid\n    FROM zszx.ZC_CONTRACT_BILL b\n    JOIN zszx.ZC_CONTRACT_INFO c ON b.CONTRACT_ID = c.ID\n    LEFT JOIN zszx.ZC_CONTRACT_PAYABLE_LOG p ON b.ID = p.BILL_ID AND p.REMOVED = 0 AND p.ENABLED = 1\n    WHERE b.REMOVED = 0 \n      AND b.ENABLED = 1\n      AND c.REMOVED = 0 \n      AND c.ENABLED = 1\n      AND YEAR(b.START_DATE) <= %s\n      AND YEAR(b.END_DATE) >= %s\n    GROUP BY b.ID, b.CONTRACT_ID, c.CONTRACT_NO, c.ORG_CODE, b.BILL_TYPE, b.START_DATE, b.END_DATE, b.DUE_PRICE, b.SETTLE_STATE\n    HAVING b.DUE_PRICE > total_paid OR b.SETTLE_STATE != 1\n    """\n    \n    cursor.execute(sql_corrected, (report_year, report_year))\n    rows = cursor.fetchall()\n    \n    # 重置统计变量\n    aging_stats = {\n        "未到期": {"count": 0, "amount": 0.0},\n        "逾期1-30天": {"count": 0, "amount": 0.0},\n        "逾期31-90天": {"count": 0, "amount": 0.0},\n        "逾期91-180天": {"count": 0, "amount": 0.0},\n        "逾期180天以上": {"count": 0, "amount": 0.0}\n    }\n    severe_overdue_contract_ids = set()\n    \n    for row in rows:\n        bill_id, contract_id, contract_no, org_code, bill_type, start_date_str, end_date_str, due_price, settle_state, total_paid = row\n        \n        if due_price is None:\n            continue\n            \n        remaining_due = float(due_price) - float(total_paid)\n        \n        if remaining_due <= 0.001:\n            continue\n            \n        try:\n            end_date = datetime.strptime(end_date_str, \'%Y-%m-%d\') if end_date_str else None\n        except:\n            end_date = None\n            \n        if end_date is None or current_date <= end_date:\n            bucket = "未到期"\n        else:\n            overdue_days = (current_date - end_date).days\n            if overdue_days <= 30:\n                bucket = "逾期1-30天"\n            elif overdue_days <= 90:\n                bucket = "逾期31-90天"\n            elif overdue_days <= 180:\n                bucket = "逾期91-180天"\n            else:\n                bucket = "逾期180天以上"\n            \n            if overdue_days > 90:\n                severe_overdue_contract_ids.add(int(contract_id))\n\n        aging_stats[bucket]["count"] += 1\n        aging_stats[bucket]["amount"] += remaining_due\n\n    # 输出结果表格\n    print("=== 2026年闵开发租金账单账龄结构分析 ===")\n    print(f"{\'账龄区间\':<15} | {\'账单笔数\':<10} | {\'待收金额(元)\':<15}")\n    print("-" * 45)\n    \n    total_count = 0\n    total_amount = 0.0\n    \n    order = ["未到期", "逾期1-30天", "逾期31-90天", "逾期91-180天", "逾期180天以上"]\n    for key in order:\n        stats = aging_stats[key]\n        count = stats["count"]\n        amount = stats["amount"]\n        total_count += count\n        total_amount += amount\n        print(f"{key:<15} | {count:<10} | {amount:>15,.2f}")\n    \n    print("-" * 45)\n    print(f"{\'合计\':<15} | {total_count:<10} | {total_amount:>15,.2f}")\n    \n    # 准备传递给下一步的参数\n    # 将集合转换为列表以便JSON序列化\n    handoff_payload = {\n        "aging_summary": {k: v for k, v in aging_stats.items()},\n        "severe_overdue_contract_ids": list(severe_overdue_contract_ids)\n    }\n    \n    print(\'__HANDOFF__\' + json.dumps(handoff_payload))\n\nfinally:\n    conn.rollback()\n    conn.close()\n```\n**执行结果**:\n```text\n=== 2026年闵开发租金账单账龄结构分析 ===\n账龄区间            | 账单笔数       | 待收金额(元)        \n---------------------------------------------\n未到期             | 272        |  118,518,724.65\n逾期1-30天         | 69         |   14,770,092.46\n逾期31-90天        | 11         |    4,974,983.45\n逾期91-180天       | 27         |    2,828,218.49\n逾期180天以上        | 10         |   13,257,682.81\n---------------------------------------------\n合计              | 389        |  154,349,701.86\n```\n\n### 步骤 5: 步骤5：进行数据一致性校验，检查是否存在状态为已结清但收款金额不等于应收金额的异常账单，或状态未结清但收款金额大于等于应收金额的异常记录，列出差异项。\n**执行代码**:\n```python\nimport pandas as pd\n\n# 从衔接参数中获取严重逾期合同ID列表（本步主要做一致性校验，不依赖此列表，但保留读取以防需要）\nhandoff = _HANDOFF_eae46f24ed\n\nconn = None\ntry:\n    conn = get_connection()\n    cursor = conn.cursor()\n\n    # 查询今年所有账单及其收款记录，用于一致性校验\n    # 结清状态 SETTLE_STATE: 通常 1=已结清, 0=未结清 (根据业务常识推断，需结合数据验证)\n    # 这里我们拉取全量相关字段进行逻辑判断\n    sql = """\n        SELECT \n            b.ID AS bill_id,\n            b.CONTRACT_ID,\n            c.CONTRACT_NO,\n            c.CUSTOMER_NAME,\n            c.ASSET_NAME,\n            b.SETTLE_STATE,\n            b.BILL_TYPE,\n            b.DUE_PRICE,\n            b.TOTAL_PRICE,\n            b.START_DATE,\n            b.END_DATE,\n            COALESCE(SUM(p.PAYABLE_MONEY), 0) AS total_paid_amount\n        FROM zszx.ZC_CONTRACT_BILL b\n        JOIN zszx.ZC_CONTRACT_INFO c ON b.CONTRACT_ID = c.ID\n        LEFT JOIN zszx.ZC_CONTRACT_PAYABLE_LOG p ON b.ID = p.BILL_ID AND p.ENABLED = 1 AND p.REMOVED = 0\n        WHERE b.ENABLED = 1 \n          AND b.REMOVED = 0\n          AND c.ENABLED = 1 \n          AND c.REMOVED = 0\n          AND YEAR(b.START_DATE) = %s\n        GROUP BY \n            b.ID, b.CONTRACT_ID, c.CONTRACT_NO, c.CUSTOMER_NAME, c.ASSET_NAME,\n            b.SETTLE_STATE, b.BILL_TYPE, b.DUE_PRICE, b.TOTAL_PRICE, b.START_DATE, b.END_DATE\n    """\n    \n    report_year = handoff.get(\'report_year\', 2026)\n    cursor.execute(sql, (report_year,))\n    rows = cursor.fetchall()\n    \n    if not rows:\n        print("未找到今年的账单数据。")\n    else:\n        columns = [desc[0] for desc in cursor.description]\n        df = pd.DataFrame(rows, columns=columns)\n        \n        # 确保数值类型为 float 以便比较\n        df[\'DUE_PRICE\'] = pd.to_numeric(df[\'DUE_PRICE\'], errors=\'coerce\').fillna(0)\n        df[\'total_paid_amount\'] = pd.to_numeric(df[\'total_paid_amount\'], errors=\'coerce\').fillna(0)\n        \n        # 定义异常规则：\n        # 1. 状态为已结清 (假设 SETTLE_STATE == 1 表示已结清)，但收款金额 != 应收金额 (允许微小误差，如0.01)\n        # 2. 状态未结清 (假设 SETTLE_STATE == 0 或其他值表示未结清)，但收款金额 >= 应收金额\n        \n        # 注意：由于不确定 SETTLE_STATE 的具体枚举值含义，我们先查看分布\n        settle_states = df[\'SETTLE_STATE\'].unique()\n        print(f"结算状态分布: {settle_states}")\n        \n        # 通常 1 代表已结清/完成，0 或 null 代表未结清。如果存在其他值，需根据实际业务调整。\n        # 这里假设 1 为已结清，非1为未结清。\n        \n        # 计算差异\n        df[\'diff\'] = df[\'total_paid_amount\'] - df[\'DUE_PRICE\']\n        \n        # 异常类型1: 已结清但金额不符\n        cond_settled_mismatch = (df[\'SETTLE_STATE\'] == 1) & (abs(df[\'diff\']) > 0.01)\n        \n        # 异常类型2: 未结清但收款已满或超额\n        cond_unsettled_overpaid = (df[\'SETTLE_STATE\'] != 1) & (df[\'total_paid_amount\'] >= df[\'DUE_PRICE\'] - 0.01)\n        \n        anomalies = df[cond_settled_mismatch | cond_unsettled_overpaid].copy()\n        \n        if anomalies.empty:\n            print("数据一致性校验通过：未发现状态与金额不匹配的异常账单。")\n        else:\n            print(f"发现 {len(anomalies)} 条异常账单记录：\\n")\n            \n            # 格式化输出关键信息\n            output_cols = [\'bill_id\', \'CONTRACT_NO\', \'CUSTOMER_NAME\', \'ASSET_NAME\', \'BILL_TYPE\', \n                           \'SETTLE_STATE\', \'DUE_PRICE\', \'total_paid_amount\', \'diff\', \'START_DATE\', \'END_DATE\']\n            \n            # 添加异常原因标记\n            def get_reason(row):\n                reasons = []\n                if row[\'SETTLE_STATE\'] == 1 and abs(row[\'diff\']) > 0.01:\n                    reasons.append("已结清但金额不符")\n                if row[\'SETTLE_STATE\'] != 1 and row[\'total_paid_amount\'] >= row[\'DUE_PRICE\'] - 0.01:\n                    reasons.append("未结清但收款已满/超额")\n                return "; ".join(reasons) if reasons else "未知"\n                \n            anomalies[\'anomaly_reason\'] = anomalies.apply(get_reason, axis=1)\n            \n            result_df = anomalies[output_cols + [\'anomaly_reason\']]\n            print(result_df.to_string(index=False))\n            \n            # 汇总统计\n            print("\\n--- 异常汇总 ---")\n            summary = anomalies.groupby(\'anomaly_reason\').agg({\n                \'bill_id\': \'count\',\n                \'DUE_PRICE\': \'sum\',\n                \'total_paid_amount\': \'sum\'\n            }).rename(columns={\'bill_id\': \'异常数量\'})\n            print(summary.to_string())\n\nexcept Exception as e:\n    print(f"执行出错: {str(e)}")\nfinally:\n    if conn:\n        try:\n            conn.rollback()\n        except:\n            pass\n        conn.close()\n```\n**执行结果**:\n```text\n结算状态分布: [3 1 2]\n发现 1485 条异常账单记录：\n\n bill_id        CONTRACT_NO       CUSTOMER_NAME                         ASSET_NAME  BILL_TYPE  SETTLE_STATE  DUE_PRICE  total_paid_amount        diff START_DATE   END_DATE anomaly_reason\n     104       SMC2022AM181        上海新弘生态农业有限公司                    F-TH-11-文井路188号          9             3 4401600.21         4401600.21        0.00 2026-01-01 2026-05-31    未结清但收款已满/超额\n     642       SMC2023AM148        上海茵赫餐饮管理有限公司               