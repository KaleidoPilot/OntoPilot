abel": "乙方逾期完成里程碑违约金条款", "type": "concept", "description": "规定乙方每逾期一日按合同总价款万分之五支付违约金，累计不超过合同总价款10%；逾期超60日甲方可解除合同并要求退款赔偿。", "sourceIds": ["S8"]}, {"id": "擅自分包转包违约金条款", "label": "擅自分包转包违约金条款", "type": "concept", "description": "乙方擅自将主要开发工作分包或转包的，甲方有权解除合同，乙方需支付合同总价款15%的违约金。", "sourceIds": ["S8"]}, {"id": "人员不符合约定违约金条款", "label": "人员不符合约定违约金条款", "type": "concept", "description": "乙方项目人员不符合约定且拒不更换的，每发现一人次支付违约金50,000.00元。", "sourceIds": ["S8"]}, {"id": "甲方解除权情形", "label": "甲方解除权情形", "type": "concept", "description": "包括乙方逾期超60日、整改不合格、擅自转包、违反廉洁条款、破产清算、严重违反保密义务等六种情形。", "sourceIds": ["S8"]}, {"id": "诉讼文书送达地址", "label": "诉讼文书送达地址", "type": "location", "description": "双方指定的联系人地址同时作为诉讼文书的送达地址。", "sourceIds": ["S8"]}, {"id": "保密协议", "label": "保密协议", "type": "content", "description": "附件六，规定保密期限(合同终止后5年，技术秘密无限期)、禁止用途及违约金50万元。", "sourceIds": ["S8"]}, {"id": "智能制造执行系统建设合同", "label": "智能制造执行系统建设合同", "type": "content", "description": "合同编号XH-ZB-2026-RJ-001，简称C1合同，涉及MES系统建设，要求本合同设备控制系统与其实现数据对接。", "sourceIds": []}, {"id": "准时送达率", "label": "准时送达率", "type": "data", "description": "服务考核指标之一，目标值为不低于98%，按批次统计。", "sourceIds": ["S2"]}, {"id": "货损率", "label": "货损率", "type": "data", "description": "服务考核指标之一，目标值为不高于0.3%，按货值统计。", "sourceIds": ["S2"]}, {"id": "库存准确率", "label": "库存准确率", "type": "data", "description": "服务考核指标之一，目标值为不低于99.5%，通过月度盘点统计。", "sourceIds": ["S2"]}, {"id": "单据及时率", "label": "单据及时率", "type": "data", "description": "服务考核指标之一，目标值为不低于98%，按单据提交时间统计。", "sourceIds": ["S2"]}, {"id": "投诉响应时间", "label": "投诉响应时间", "type": "data", "description": "服务考核指标之一，要求不超过2小时，按投诉记录统计。", "sourceIds": ["S2"]}, {"id": "事故报告及时率", "label": "事故报告及时率", "type": "data", "description": "服务考核指标之一，要求达到100%，按事故记录统计。", "sourceIds": ["S2"]}, {"id": "中华人民共和国法律", "label": "中华人民共和国法律", "type": "concept", "description": "本合同适用的法律依据，争议解决时优先适用。<SEP>本合同订立、效力、解释、履行及争议解决适用的法律体系。<SEP>本合同适用的法律依据。", "sourceIds": ["S2", "S3", "S8"]}, {"id": "陈立国", "label": "陈立国", "type": "person", "description": "星海智能装备制造有限公司的法定代表人。<SEP>星海智能科技集团有限公司的法定代表人。<SEP>星海智能装备制造有限公司法定代表人。", "sourceIds": ["S5", "S6"]}, {"id": "星海智能产业园二期生产设备", "label": "星海智能产业园二期生产设备", "type": "artifact", "description": "由星海智能装备制造有限公司承担组织与运行管理的设备，需建设覆盖其生产计划、工艺执行等的MES系统。", "sourceIds": ["S6"]}, {"id": "XH-ZB-2026-001", "label": "XH-ZB-2026-001", "type": "data", "description": "甲方就本项目必要性、技术方案与预算完成内部审批的审批文号。", "sourceIds": ["S6"]}, {"id": "年度运维服务协议", "label": "年度运维服务协议", "type": "content", "description": "质保期届满后可选择签订，服务费不高于合同总价款的12%。<SEP>质保期届满后甲方可选择与乙方签订的协议，服务费不高于本合同总价款的12%(即1,041,600.00元/年)。", "sourceIds": ["S7", "S8"]}, {"id": "质量不合格解除权", "label": "质量不合格解除权", "type": "concept", "description": "交付成果经两次整改仍不合格的，甲方有权解除合同，乙方需支付合同总价款20%的质量违约金。", "sourceIds": ["S8"]}, {"id": "甲方逾期支付违约金条款", "label": "甲方逾期支付违约金条款", "type": "concept", "description": "甲方每逾期一日按逾期金额万分之五向乙方支付违约金，累计不超过逾期金额10%；逾期超90日乙方可解除合同。", "sourceIds": ["S8"]}, {"id": "拒绝验收违约金条款", "label": "拒绝验收违约金条款", "type": "concept", "description": "甲方无正当理由拒绝验收的，按第8.5条处理，并按合同总价款5%向乙方支付违约金。", "sourceIds": ["S8"]}, {"id": "乙方解除权情形", "label": "乙方解除权情形", "type": "concept", "description": "包括甲方逾期支付超90日、无正当理由拒绝验收超60日、甲方破产清算等三种情形。", "sourceIds": ["S8"]}, {"id": "复合材料自动化生产线采购合同", "label": "复合材料自动化生产线采购合同", "type": "content", "description": "合同编号为RZ-SB-2026-009，由瑞泽新材料有限公司与星海智能装备制造有限公司签订，郑国强提供担保，约定设备总价680万元及分期支付、验收标准等条款。", "sourceIds": []}, {"id": "设备采购合同", "label": "设备采购合同", "type": "content", "description": "由瑞泽新材料有限公司、星海智能装备制造有限公司和郑国强签署的合同，约定了设备交付、质保、知识产权、违约责任及争议解决等条款。", "sourceIds": []}, {"id": "第三方软件管理", "label": "第三方软件管理", "type": "method", "description": "开源软件需符合许可证要求并提供清单，商业软件由甲方采购或委托乙方代采，费用不含在合同价款内。", "sourceIds": ["S7"]}, {"id": "B1厂房洁净车间机电安装工程", "label": "B1厂房洁净车间机电安装工程", "type": "event", "description": "甲方另行委托的工程，合同编号XH-ZB-2026-AZ-003，简称“C5合同”，其建设的设备自控系统需与MES系统实现数据对接。", "sourceIds": ["S6"]}, {"id": "复合材料自动化生产线", "label": "复合材料自动化生产线", "type": "artifact", "description": "甲方采购的生产线，合同编号RZ-SB-2026-009，简称“C4合同”，需与MES系统实现设备层数据采集。", "sourceIds": ["S6"]}, {"id": "中华人民共和国民法典", "label": "中华人民共和国民法典", "type": "content", "description": "双方签订合同所依据的法律法规之一。", "sourceIds": ["S6"]}, {"id": "企业资源计划系统(ERP)", "label": "企业资源计划系统(ERP)", "type": "artifact", "description": "甲方现有的信息系统，MES系统需与其进行主数据同步、生产订单下传及完工回报的数据集成。", "sourceIds": ["S6"]}, {"id": "仓储管理系统(WMS)", "label": "仓储管理系统(WMS)", "type": "artifact", "description": "甲方现有的信息系统，MES系统需与其进行出入库指令交互的数据集成。", "sourceIds": ["S6"]}, {"id": "基础数据管理模块", "label": "基础数据管理模块", "type": "method", "description": "MES系统开发范围的一部分，包括物料主数据、工艺路线、工序定义、设备台账、人员权限、班次班组的建立与维护。", "sourceIds": ["S6"]}, {"id": "计划管理模块", "label": "计划管理模块", "type": "method", "description": "MES系统开发范围的一部分，包括生产订单接收、工单拆分与派发、生产排程、产能负荷分析、齐套性检查。", "sourceIds": ["S6"]}, {"id": "生产执行模块", "label": "生产执行模块", "type": "method", "description": "MES系统开发范围的一部分，包括工单开工报工、工序流转、在制品管理、生产异常上报与处置、生产看板。", "sourceIds": ["S6"]}, {"id": "设备互联模块", "label": "设备互联模块", "type": "method", "description": "MES系统开发范围的一部分，包括设备数据采集网关、协议适配(OPC UA, Modbus TCP, Profinet)、设备状态监控、故障报警、OEE计算。", "sourceIds": ["S6"]}, {"id": "质量管理模块", "label": "质量管理模块", "type": "method", "description": "MES系统开发范围的一部分，包括检验标准配置、来料/过程/成品检验、不良品处理、质量追溯、SPC统计过程控制。", "sourceIds": ["S6"]}, {"id": "仓储协同模块", "label": "仓储协同模块", "type": "method", "description": "MES系统开发范围的一部分，包括线边仓管理、物料拉动、批次管理、先进先出控制。", "sourceIds": ["S6"]}, {"id": "报表分析模块", "label": "报表分析模块", "type": "method", "description": "MES系统开发范围的一部分，包括生产日报、设备利用率、质量分析、能耗分析报表及自定义报表配置。", "sourceIds": ["S6"]}, {"id": "系统集成模块", "label": "系统集成模块", "type": "method", "description": "MES系统开发范围的一部分，包括与甲方ERP系统和WMS系统的数据集成。", "sourceIds": ["S6"]}, {"id": "硬件资源配置清单", "label": "硬件资源配置清单", "type": "content", "description": "合同附件二，列明了现有硬件条件，用于评估系统并发用户数及响应时间等性能指标。<SEP>附件二，列明硬件资源，是合同不可分割组成部分。", "sourceIds": ["S6", "S8"]}, {"id": "缺陷分级与响应时限表", "label": "缺陷分级与响应时限表", "type": "content", "description": "合同附件三，定义了致命、严重、一般、轻微四级缺陷的具体分级标准。<SEP>附件三，定义致命、严重、一般、轻微缺陷的响应和修复时限及升级机制。", "sourceIds": ["S6", "S8"]}, {"id": "第二期付款计划", "label": "第二期付款计划", "type": "data", "description": "合同付款条款中的第二期，金额为2,604,000.00元(占30%)，在M4里程碑(开发完成)确认后15个工作日内支付。", "sourceIds": ["S7"]}, {"id": "第三期付款计划", "label": "第三期付款计划", "type": "data", "description": "合同付款条款中的第三期，金额为2,604,000.00元(占30%)，在M8里程碑(正式上线)确认后15个工作日内支付。", "sourceIds": ["S7"]}, {"id": "第四期付款计划", "label": "第四期付款计划", "type": "data", "description": "合同付款条款中的第四期，金额为868,000.00元(占10%)，在终验合格且质保期届满后30个工作日内支付。", "sourceIds": ["S7"]}, {"id": "付款前提条件", "label": "付款前提条件", "type": "concept", "description": "乙方请款需提交的文件清单及甲方付款时限规定，包括付款申请书、确认文件、增值税专用发票等。", "sourceIds": ["S7"]}, {"id": "履约保函", "label": "履约保函", "type": "artifact", "description": "乙方需在合同签订后10个工作日内提交的银行或专业担保机构出具的保函，金额为合同总价款10%(868,000.00元)，有效期至终验合格之日止。<SEP>乙方需在合同签订后10个工作日内提交，金额为合同总价的10%(1,245,000.00元)，有效期至质量保证期届满。<SEP>乙方需在合同签订后10个工作日内提交金额为合同价10%(452,000.00元)的保函，有效期至竣工验收合格之日。", "sourceIds": ["S5", "S7"]}, {"id": "发票与税务条款", "label": "发票与税务条款", "type": "content", "description": "规定乙方开具税率6%的增值税专用发票，合同为含税价，税率调整时不含税价不变。", "sourceIds": ["S7"]}, {"id": "价款调整机制", "label": "价款调整机制", "type": "method", "description": "固定总价合同的例外情形，包括甲方书面确认的范围变更、法律政策变化导致成本重大变化、双方书面确认的其他情形。", "sourceIds": ["S7"]}, {"id": "范围变更计价原则", "label": "范围变更计价原则", "type": "method", "description": "新增工作量按乙方报价单中的人工单价计算，经双方书面确认后作为合同价款增减依据。", "sourceIds": ["S7"]}, {"id": "甲方权利", "label": "甲方权利", "type": "concept", "description": "甲方拥有的监督权、要求返工权、系统使用权及追究违约责任的权利。", "sourceIds": ["S7"]}, {"id": "甲方义务", "label": "甲方义务", "type": "concept", "description": "甲方需履行的付款、提供资料、指定联系人、提供工作条件、协调接口、组织验收及保密义务。", "sourceIds": ["S7"]}, {"id": "需求调研业务资料", "label": "需求调研业务资料", "type": "data", "description": "甲方需在2026年4月15日前向乙方提供的现有生产流程文件、工艺路线、质量检验标准、设备台账、组织架构与岗位职责。", "sourceIds": ["S7"]}, {"id": "C5合同自控系统数据点表", "label": "C5合同自控系统数据点表", "type": "data", "description": "甲方需在2026年8月31日前向乙方提供的C5合同项下自控系统的数据点表，并协调配合接口调试。", "sourceIds": ["S7"]}, {"id": "C4合同设备数据接口", "label": "C4合同设备数据接口", "type": "other", "description": "甲方需协调C4合同乙方按期开放的设备数据接口，并提供符合OPC UA标准的接口规范文件。", "sourceIds": ["S7"]}, {"id": "甲方配合义务边界", "label": "甲方配合义务边界", "type": "concept", "description": "界定甲方对提供资料真实性负责，因资料错误导致返工由甲方承担费用并顺延工期；逾期未回复视为确认(除重大缺陷外)。", "sourceIds": ["S7"]}, {"id": "乙方权利", "label": "乙方权利", "type": "concept", "description": "乙方拥有的收款权、要求配合权、变更协议签订权及案例展示权(需甲方同意且不泄露保密信息)。", "sourceIds": ["S7"]}, {"id": "乙方义务", "label": "乙方义务", "type": "concept", "description": "乙方需履行的开发交付、人员配置、月度报告、遵守管理制度、质保服务、禁止擅自分包、知识产权保证及移交成果义务。", "sourceIds": ["S7"]}, {"id": "项目进展报告", "label": "项目进展报告", "type": "content", "description": "乙方每月5日前向甲方提交的包含进度、问题、风险预警及下月计划的报告。", "sourceIds": ["S7"]}, {"id": "廉洁与合规条款", "label": "廉洁与合规条款", "type": "content", "description": "禁止乙方行贿，违反者甲方可解除合同并要求支付合同总价款20%违约金及赔偿损失；乙方需遵守数据安全法等法规。", "sourceIds": ["S7"]}, {"id": "交付内容", "label": "交付内容", "type": "data", "description": "乙方需交付的系统软件、源代码、技术文档、数据库脚本及培训服务(管理员3场、用户6场、总时长40学时)。", "sourceIds": ["S7"]}, {"id": "初验流程", "label": "初验流程", "type": "method", "description": "M6里程碑后乙方申请，甲方10个工作日内组织，内容包括功能、性能、接口及安全测试；不合格需15个工作日内整改。", "sourceIds": ["S7"]}, {"id": "试运行阶段", "label": "试运行阶段", "type": "event", "description": "初验合格后进入，为期45日(2026年12月1日至2027年1月14日)，要求连续稳定运行，非计划停机不超过8小时，乙方派2名工程师常驻。", "sourceIds": ["S7"]}, {"id": "终验流程", "label": "终验流程", "type": "method", "description": "试运行结束后乙方申请，甲方15个工作日内组织，标准包括稳定性、缺陷数、文档、培训考核、渗透测试及源码编译；不合格需20个工作日内整改。", "sourceIds": ["S7"]}, {"id": "逾期验收处理", "label": "逾期验收处理", "type": "concept", "description": "甲方无正当理由逾期验收超过30日视为验收合格，但不免除乙方质量保证责任。", "sourceIds": ["S7"]}, {"id": "定制开发成果归属", "label": "定制开发成果归属", "type": "concept", "description": "本项目专门开发的软件著作权归甲方所有，乙方需配合登记，费用由甲方承担。", "sourceIds": ["S7"]}, {"id": "乙方既有知识产权", "label": "乙方既有知识产权", "type": "concept", "description": "乙方独立于本项目的通用组件、框架等归乙方所有，嵌入系统时需授予甲方永久免费使用许可，未列明视为已授权。", "sourceIds": ["S7"]}, {"id": "侵权责任处理", "label": "侵权责任处理", "type": "method", "description": "乙方保证不侵权，若发生索赔由乙方应诉并承担费用；若导致无法使用，乙方需取得授权、替换方案或退款。", "sourceIds": ["S7"]}, {"id": "保密范围定义", "label": "保密范围定义", "type": "concept", "description": "明确甲方保密信息(工艺、设计、客户信息等)和乙方保密信息(源码、架构等)，以及不属于保密信息的例外情形。", "sourceIds": ["S7"]}, {"id": "保密义务", "label": "保密义务", "type": "concept", "description": "接收方仅限本合同目的使用，限制知悉范围，采取不低于合理标准的保护措施。", "sourceIds": ["S7"]}, {"id": "保密期限", "label": "保密期限", "type": "data", "description": "自合同签订起至终止后5年止；涉及生产工艺参数等技术秘密不受此限，直至进入公有领域。", "sourceIds": ["S7"]}, {"id": "保密违约后果", "label": "保密违约后果", "type": "data", "description": "违反保密义务需支付违约金人民币500,000.00元，不足部分需赔偿差额。", "sourceIds": ["S7"]}, {"id": "质保期定义", "label": "质保期定义", "type": "data", "description": "本系统质保期为12个月，自终验合格之日起算。", "sourceIds": ["S7"]}, {"id": "质保范围", "label": "质保范围", "type": "concept", "description": "包括功能缺陷、性能不达标、数据错误、安全漏洞修复；排除擅自修改、环境变更、误操作、不可抗力及新增需求。", "sourceIds": ["S7"]}, {"id": "响应时限标准", "label": "响应时限标准", "type": "data", "description": "致命缺陷1小时/8小时，严重缺陷4小时/24小时，一般缺陷8小时/5工作日，轻微缺陷24小时/下一版本。", "sourceIds": ["S7"]}, {"id": "功能性升级", "label": "功能性升级", "type": "method", "description": "新增功能类的系统升级，不属于质保范围，需双方另行协商。", "sourceIds": ["S8"]}, {"id": "责任限额条款", "label": "责任限额条款", "type": "concept", "description": "除故意、重大过失、侵权、违反保密或人身伤害外，赔偿责任总额不超过合同总价款，且不赔偿间接损失。", "sourceIds": ["S8"]}, {"id": "不可抗力", "label": "不可抗力", "type": "concept", "description": "指不能预见、避免且克服的客观情况，包括自然灾害、战争、疫情等，持续超90日任一方可解除合同并互不承担违约责任。<SEP>不能预见、避免且克服的客观情况，导致工期顺延，持续超过60日任何一方可解除合同。", "sourceIds": ["S3", "S8"]}, {"id": "书面变更协议", "label": "书面变更协议", "type": "content", "description": "合同变更必须签署的文件，口头、邮件或会议纪要未经书面确认不构成变更。", "sourceIds": ["S8"]}, {"id": "已完成工作量认定规则", "label": "已完成工作量认定规则", "type": "method", "description": "以已确认里程碑为基础，未到部分按实际比例协商或委托第三方评估，用于合同解除后的结算。", "sourceIds": ["S8"]}, {"id": "友好协商", "label": "友好协商", "type": "method", "description": "争议解决的首选方式，协商不成可向甲方所在地法院起诉。", "sourceIds": ["S8"]}, {"id": "项目开发范围清单", "label": "项目开发范围清单", "type": "content", "description": "附件一，列明功能点清单，是合同不可分割组成部分。", "sourceIds": ["S8"]}, {"id": "人力单价表", "label": "人力单价表", "type": "content", "description": "附件四，列明人力成本单价，是合同不可分割组成部分。", "sourceIds": ["S8"]}, {"id": "项目里程碑计划甘特图", "label": "项目里程碑计划甘特图", "type": "content", "description": "附件五，展示项目进度计划，是合同不可分割组成部分。", "sourceIds": ["S8"]}, {"id": "M4里程碑", "label": "M4里程碑", "type": "UNKNOWN", "description": "第二期付款计划在M4里程碑(开发完成)确认后15个工作日内执行。", "sourceIds": ["S7"]}, {"id": "M8里程碑", "label": "M8里程碑", "type": "UNKNOWN", "description": "第三期付款计划在M8里程碑(正式上线)确认后15个工作日内执行。", "sourceIds": ["S7"]}, {"id": "终验合格", "label": "终验合格", "type": "UNKNOWN", "description": "第四期付款计划在终验合格且质保期届满后30个工作日内执行。", "sourceIds": ["S7"]}, {"id": "接收方", "label": "接收方", "type": "UNKNOWN", "description": "接收方仅可为履行合同目的使用保密信息，并采取不低于合理标准的保护措施。", "sourceIds": ["S7"]}, {"id": "违约方", "label": "违约方", "type": "UNKNOWN", "description": "违反保密义务的一方需向守约方支付违约金500,000.00元，并赔偿不足部分的损失。", "sourceIds": ["S7"]}, {"id": "合同解除后的处理", "label": "合同解除后的处理", "type": "UNKNOWN", "description": "合同解除后，依据该规则认定已完成工作量，甲方据此支付相应价款。", "sourceIds": ["S8"]}, {"id": "星海智能产业园二期B1、B2厂房建设总承包合同", "label": "星海智能产业园二期B1、B2厂房建设总承包合同", "type": "content", "description": "合同编号为XH-JS-2026-SG-002，由星海智能科技集团有限公司与恒通建筑工程有限公司于2026年4月8日在江苏省苏州工业园区签订。<SEP>合同编号XH-JS-2026-SG-002，简称\\"C2合同”，由星海集团与恒通建筑工程有限公司于2026年4月8日签订。", "sourceIds": ["S5"]}, {"id": "郑国强", "label": "郑国强", "type": "person", "description": "恒通建筑工程有限公司的法定代表人。<SEP>恒通建筑工程有限公司的法定代表人，同时担任瑞泽新材料有限公司的监事，构成双方关联关系的核心人物。<SEP>恒通建筑工程有限公司的法定代表人，同时担任瑞泽新材料有限公司的监事职务。因其在甲乙双方的双重任职身份，导致本合同构成关联交易。<SEP>本合同保证人(丙方)，身份证号3301**2517，住所地杭州市西湖区文二路391号，系瑞泽新材料有限公司监事，自愿为甲方付款义务提供连带责任保证。<SEP>本合同中的丙方(保证人)，自愿为甲方对乙方的全部付款义务提供连带责任保证，声明具有完全民事行为能力且未受欺诈胁迫。", "sourceIds": ["S5"]}, {"id": "星海智能产业园二期项目", "label": "星海智能产业园二期项目", "type": "event", "description": "位于江苏省苏州工业园区星湖街以东、星海路以南地块的建设工程项目，总建筑面积35,000平方米，包含B1、B2厂房及配套工程。", "sourceIds": []}, {"id": "苏州建元工程管理有限公司", "label": "苏州建元工程管理有限公司", "type": "organization", "description": "本工程的监理单位，监理合同另行签订。", "sourceIds": []}, {"id": "苏州工业园区建设工程质量安全监督站", "label": "苏州工业园区建设工程质量安全监督站", "type": "organization", "description": "对本工程实施政府监督的主管部门。", "sourceIds": []}, {"id": "中标通知书XH-JS-2026-ZB-002", "label": "中标通知书XH-JS-2026-ZB-002", "type": "artifact", "description": "确定恒通建筑工程有限公司为本工程中标单位的文件，中标价为人民币32,600,000.00元。", "sourceIds": []}, {"id": "建设用地规划许可证地字第32059420260018号", "label": "建设用地规划许可证地字第32059420260018号", "type": "artifact", "description": "本工程取得的批准文件之一，作为合同附件。", "sourceIds": []}, {"id": "建设工程规划许可证建字第32059420260042号", "label": "建设工程规划许可证建字第32059420260042号", "type": "artifact", "description": "本工程取得的批准文件之一，作为合同附件。", "sourceIds": []}], "relationships": [{"id": "中信商业保理有限公司-何志远", "source": "中信商业保理有限公司", "target": "何志远", "keywords": "代表,联系", "description": "何志远是中信商业保理有限公司在本合同中的指定联系人。", "sourceIds": ["S2"], "refId": "R1"}, {"id": "何志远-设备运输及仓储配送服务合同", "source": "何志远", "target": "设备运输及仓储配送服务合同", "keywords": "授权代表,法定代表人", "description": "何志远是丙方中信商业保理有限公司的法定代表人及授权代表。", "sourceIds": ["S1"], "refId": "R2"}, {"id": "中信商业保理有限公司-设备运输及仓储配送服务合同", "source": "中信商业保理有限公司", "target": "设备运输及仓储配送服务合同", "keywords": "丙方,保理人", "description": "中信商业保理有限公司作为丙方(保理人)参与签订《设备运输及仓储配送服务合同》，负责提供保理融资服务。", "sourceIds": ["S1"], "refId": "R3"}, {"id": "中信商业保理有限公司-云启数据服务有限公司", "source": "中信商业保理有限公司", "target": "云启数据服务有限公司", "keywords": "关联关系披露,合同主体,甲方与丙方,知情,违约赔偿,逾期放款", "description": "若丙方无正当理由未按约定放款，需向甲方支付违约金；违反保密义务则按《应收账款转让协议》承担责任。<SEP>中信商业保理有限公司在审批保理业务时已知悉甲方与乙方的关联关系，并履行了内部审查程序。<SEP>双方参与同一合同体系，丙方作为保理人介入，涉及应收账款转让及保理业务审批。", "sourceIds": ["S2"], "refId": "R4"}, {"id": "中信商业保理有限公司-联达物流有限公司", "source": "中信商业保理有限公司", "target": "联达物流有限公司", "keywords": "乙方与丙方,合同主体", "description": "双方参与同一合同体系，丙方在审批保理业务时需知悉并审查乙方与甲方的关联关系。", "sourceIds": ["S2"], "refId": "R5"}, {"id": "云启数据服务有限公司-设备运输及仓储配送服务合同", "source": "云启数据服务有限公司", "target": "设备运输及仓储配送服务合同", "keywords": "托运人,甲方", "description": "云启数据服务有限公司作为甲方(托运人)参与签订《设备运输及仓储配送服务合同》，负责委托运输并支付费用。", "sourceIds": ["S1"], "refId": "R6"}, {"id": "联达物流有限公司-设备运输及仓储配送服务合同", "source": "联达物流有限公司", "target": "设备运输及仓储配送服务合同", "keywords": "乙方,承运人", "description": "联达物流有限公司作为乙方(承运人)参与签订《设备运输及仓储配送服务合同》，负责提供运输、仓储及配送服务。", "sourceIds": ["S1"], "refId": "R7"}, {"id": "李伟东-设备运输及仓储配送服务合同", "source": "李伟东", "target": "设备运输及仓储配送服务合同", "keywords": "法定代表人", "description": "李伟东是甲方云启数据服务有限公司的法定代表人，同时担任乙方联达物流有限公司的监事，构成关联关系。", "sourceIds": ["S1"], "refId": "R8"}, {"id": "吴倩-设备运输及仓储配送服务合同", "source": "吴倩", "target": "设备运输及仓储配送服务合同", "keywords": "授权代表,法定代表人", "description": "吴倩是乙方联达物流有限公司的法定代表人及授权代表。", "sourceIds": ["S1"], "refId": "R9"}, {"id": "林小满-设备运输及仓储配送服务合同", "source": "林小满", "target": "设备运输及仓储配送服务合同", "keywords": "授权代表", "description": "林小满是甲方云启数据服务有限公司的授权代表。", "sourceIds": ["S1"], "refId": "R10"}, {"id": "星海智能装备制造有限公司-设备运输及仓储配送服务合同", "source": "星海智能装备制造有限公司", "target": "设备运输及仓储配送服务合同", "keywords": "债务人,关联方", "description": "星海智能装备制造有限公司是C1合同的相对方，也是甲方应收账款的债务人，其出具的确认函是保理融资的前提条件之一。", "sourceIds": ["S1"], "refId": "R11"}, {"id": "智能制造执行系统(MES)开发及实施合同-设备运输及仓储配送服务合同", "source": "智能制造执行系统(MES)开发及实施合同", "target": "设备运输及仓储配送服务合同", "keywords": "C1合同,基础合同", "description": "本合同中的保理融资业务基于甲方与星海智能装备制造有限公司签订的《智能制造执行系统(MES)开发及实施合同》(C1合同)项下的应收账款。", "sourceIds": ["S1"], "refId": "R12"}, {"id": "苏州工业园区星湖街218号星海智能产业园二期B1厂房-设备运输及仓储配送服务合同", "source": "苏州工业园区星湖街218号星海智能产业园二期B1厂房", "target": "设备运输及仓储配送服务合同", "keywords": "项目实施地", "description": "该地点被定义为“项目实施地”，是货物运输的最终目的地及园区内配送的目标区域。", "sourceIds": ["S1"], "refId": "R13"}, {"id": "云启数据服务有限公司-货物运输一切险", "source": "云启数据服务有限公司", "target": "货物运输一切险", "keywords": "可选投保,权益归属", "description": "甲方可选择投保货物运输一切险，被保险人和保险利益均归属于甲方。", "sourceIds": ["S2"], "refId": "R14"}, {"id": "云启数据服务有限公司-廉洁承诺书", "source": "云启数据服务有限公司", "target": "廉洁承诺书", "keywords": "义务承担方", "description": "乙方承诺不进行商业贿赂、串通报价，违者将被列入黑名单三年并支付20%违约金。", "sourceIds": ["S8"], "refId": "R15"}, {"id": "承运人责任险-联达物流有限公司", "source": "承运人责任险", "target": "联达物流有限公司", "keywords": "强制保险,投保义务", "description": "乙方有义务为其承运的货物投保承运人责任险，保额不低于500万元。", "sourceIds": ["S2"], "refId": "R16"}, {"id": "廉洁承诺书-星海智能装备制造有限公司", "source": "廉洁承诺书", "target": "星海智能装备制造有限公司", "keywords": "权利享有方", "description": "甲方有权在乙方违反廉洁承诺时解除合同、收取违约金并将乙方列入供应商黑名单。", "sourceIds": ["S8"], "refId": "R17"}, {"id": "廉洁承诺书-本合同", "source": "廉洁承诺书", "target": "本合同", "keywords": "包含附件", "description": "附件七是合同不可分割的部分，规定廉洁义务及20%违约金和解约权。", "sourceIds": ["S8"], "refId": "R18"}, {"id": "恒通建筑工程有限公司-星海智能科技集团有限公司", "source": "恒通建筑工程有限公司", "target": "星海智能科技集团有限公司", "keywords": "不可抗力分担,争议解决,保险投保,信息披露,修复费用,发包与承包,合同关系,合同备案,廉政约束,总承包合同关系,生效日期,禁止行为,管辖法院,费用承担", "description": "恒通建筑工程有限公司与星海智能科技集团有限公司于2026年4月8日签署《星海智能产业园二期B1、B2厂房建设总承包合同》（简称C2合同），该合同自双方签字盖章之日起生效，并约定在签订后30日内办理备案手续。在此关系中，恒通建筑工程有限公司作为乙方，向甲方发包方星海智能科技集团有限公司书面披露了其与瑞泽新材料有限公司的关联交易。\\n\\n在合同履行义务方面，乙方须投保建筑工程一切险与第三者责任险，保险金额不低于合同价款，保险费由乙方承担。依据附件七规定，乙方不得向甲方工作人员及其近亲属提供不正当利益，同时禁止甲方工作人员索要财物或指定分包。针对不可抗力情形，若造成工程损坏由甲方承担修复费用；若不可抗力持续超过90日，任一方有权解除合同并按已完成工程量进行结算。\\n\\n关于争议解决机制，双方约定发生争议时先协商或提请苏州工业园区建设行政主管部门调解，若调解不成则向工程所在地有管辖权的人民法院提起诉讼。此外，合同还明确了安全生产及违约责任等相关条款。", "sourceIds": ["S4", "S5"], "refId": "R19"}, {"id": "云启数据服务有限公司-联达物流有限公司", "source": "云启数据服务有限公司", "target": "联达物流有限公司", "keywords": "人员交叉任职,保密义务,信息保护,关联关系,合同主体,擅自转委托,泄露信息,甲方与乙方,监督,考核,考核未达标,违约赔偿,逾期付款", "description": "云启数据服务有限公司与联达物流有限公司之间存在物流服务合同关系及人员关联关系。在合同关系中，甲方为托运人（云启数据服务有限公司），乙方为承运人（联达物流有限公司）。双方约定了服务义务、考核机制及违约责任。甲方每月对乙方进行一次服务考核，依据准时送达率、货损率等指标评估乙方表现。若乙方在服务考核中连续三个月未达标，甲方有权解除合同并要求乙方支付150,000.00元违约金；若乙方擅自将服务转委托给第三方，甲方有权解除合同并要求乙方支付100,000.00元违约金。此外，乙方对甲方的货物信息和项目信息承担保密义务，未经同意不得转委托或用于宣传；若乙方泄露甲方商业信息，需支付200,000.00元违约金并赔偿实际损失。在付款方面，若甲方逾期支付服务费用，需向乙方支付违约金；逾期超过30日，乙方有权暂停服务。\\n\\n除合同关系外，两家公司还存在人员关联关系。因李伟东同时在云启数据服务有限公司和联达物流有限公司任职关键职位，双方存在关联关系，需履行披露和审查程序。", "sourceIds": ["S2"], "refId": "R20"}, {"id": "云启数据服务有限公司-李伟东", "source": "云启数据服务有限公司", "target": "李伟东", "keywords": "任职,法定代表人", "description": "李伟东担任云启数据服务有限公司的法定代表人。", "sourceIds": ["S2", "S6"], "refId": "R21"}, {"id": "YQ-WL-2026-004-GL01-云启数据服务有限公司", "source": "YQ-WL-2026-004-GL01", "target": "云启数据服务有限公司", "keywords": "合同组成部分,审批文件,生成,附件", "description": "云启数据服务有限公司就关联交易履行内部审批，生成了编号为YQ-WL-2026-004-GL01的文件。<SEP>该审批文件作为本合同的附件五，证明甲方已履行内部审批程序。", "sourceIds": ["S2"], "refId": "R22"}, {"id": "XH-ZB-2026-RJ-001-AR01-云启数据服务有限公司", "source": "XH-ZB-2026-RJ-001-AR01", "target": "云启数据服务有限公司", "keywords": "合同组成部分,附件", "description": "该应收账款确认函作为本合同的附件六，涉及甲方与丙方之间的应收账款业务。", "sourceIds": ["S2"], "refId": "R23"}, {"id": "上海市道路运输行业协会-云启数据服务有限公司", "source": "上海市道路