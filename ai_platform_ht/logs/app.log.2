SELECT root.ID AS rootProjectGroupId, root.SANDBOX_CONFIG_ID AS sandboxConfigId
FROM SKILL s
JOIN PROJECT_GROUP g ON g.ID = s.PROJECT_GROUP_ID AND g.ORG_ID = s.ORG_ID
JOIN PROJECT_GROUP root ON root.ID = COALESCE(g.PARENT_ID, g.ID) AND root.ORG_ID = s.ORG_ID
WHERE s.ID = :skillId AND s.ORG_ID = :orgId AND s.SKILL_TYPE = 2
  AND s.ENABLED = 1 AND s.REMOVED = 0
  AND g.ENABLED = 1 AND g.REMOVED = 0 AND g.LEVEL IN (0, 1)
  AND root.LEVEL = 0 AND root.PARENT_ID IS NULL AND root.ENABLED = 1 AND root.REMOVED = 0

