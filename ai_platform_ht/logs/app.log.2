品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "name", "columnType": "varchar(128)", "columnComment": "商品名称"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "category", "columnType": "varchar(64)", "columnComment": "分类"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "sale_price", "columnType": "decimal(12,2)", "columnComment": "销售价"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接读取商品表字段。"}, {"dataNeed": "商品销售明细（销量、销售额、毛利）", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "qty", "columnType": "int(11)", "columnComment": "数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 112, "tableName": "virtual_erp.sales_order_items", "columnName": "amount", "columnType": "decimal(14,2)", "columnComment": "行金额"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}], "relationIds": [{"projectGroupId": 38, "relationId": 28}], "derivation": "按product_id分组：销量=SUM(qty)，销售额=SUM(amount)，毛利=SUM(amount - qty*cost_price)。", "conditions": ["关联订单主表过滤有效订单及统计期间"], "note": "聚合订单明细数据得到单品表现。"}], "dataInputs": [], "unmappedDataNeeds": ["商品库存余额"]}, {"id": "customer-analysis", "heading": "五、客户分析", "instruction": "1. **客户贡献**：列出有成交客户的订单数、销售额及客单价，对比不同客户的下单频次与单笔金额特征。2. **集中度**：计算第一大客户及前两大客户的销售占比，引入客户集中度指数（HHI）或类似指标，评估对单一大客户的依赖风险。3. **活跃与转化**：统计建档客户中有成交的比例，分析未成交客户的原因（如首单取消、长期无动作），评估复购率和客户黏性。", "format": "table", "formats": ["table", "prose"], "intent": "评估客户贡献度、集中度风险及活跃度，判断客户结构的稳定性。", "analysis": ["聚合客户维度的销售数据", "计算头部客户占比及集中度指标", "分析客户转化率与复购行为", "区分活跃客户与沉睡/流失客户"], "dataNeeds": ["客户档案信息", "客户订单历史", "客户销售总额及占比"], "dataSources": [{"dataNeed": "客户档案信息", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "code", "columnType": "varchar(32)", "columnComment": "客户编码"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "name", "columnType": "varchar(128)", "columnComment": "客户名称"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "contact", "columnType": "varchar(64)", "columnComment": "联系人"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "phone", "columnType": "varchar(32)", "columnComment": "电话"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 109, "tableName": "virtual_erp.customers", "columnName": "address", "columnType": "varchar(255)", "columnComment": "地址"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接读取客户表基本信息。"}, {"dataNeed": "客户订单历史", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "customer_id", "columnType": "int(11)", "columnComment": "关联客户id"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "order_no", "columnType": "varchar(32)", "columnComment": "订单号"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "order_date", "columnType": "date", "columnComment": "下单日期"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 111, "tableName": "virtual_erp.sales_orders", "columnName": "total_amount", "columnType": "decimal(14,2)", "columnComment": "订单总额"}], "relationIds": [{"projectGroupId": 38, "relationId": 26}], "derivation": "", "conditions": ["按用户需求确定统计期间"], "note": "通过客户ID关联订单表获取交易记录。"}], "dataInputs": [], "unmappedDataNeeds": ["客户销售总额及占比"]}, {"id": "supplier-analysis", "heading": "六、供应商分析", "instruction": "1. **资源现状**：列出供应商基本信息及状态，判断是否为初始化数据还是业务积累。2. **业务衔接**：重点检查商品成本记录、出入库单据中是否有供应商标识。若无法追溯，需明确指出“采购来源不可追溯”这一管理漏洞及其后果（如无法核算真实成本、无法评估交期）。3. **品类对应**：基于推测或现有数据，尝试建立供应商与商品品类的映射关系，评估各供应商背后的潜在业务规模。4. **小结**：总结供应商体系的实际贡献度（如为零）及主要缺失环节。", "format": "prose", "formats": ["table", "prose", "list"], "intent": "审查供应商资源的有效性及其与实际业务的关联度，识别供应链管理的断点。", "analysis": ["验证供应商数据与交易数据的关联性", "评估采购流程的可追溯性", "推断供应商对应的业务体量", "识别供应链管理的空白点"], "dataNeeds": ["供应商档案", "采购入库单据（如有）", "商品成本来源标记", "供应商与商品的理论对应关系"], "dataSources": [{"dataNeed": "供应商档案", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "code", "columnType": "varchar(32)", "columnComment": "供应商编码"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "name", "columnType": "varchar(128)", "columnComment": "供应商名称"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "contact", "columnType": "varchar(64)", "columnComment": "联系人"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "phone", "columnType": "varchar(32)", "columnComment": "电话"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 114, "tableName": "virtual_erp.suppliers", "columnName": "address", "columnType": "varchar(255)", "columnComment": "地址"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接读取供应商表基本信息。"}], "dataInputs": [], "unmappedDataNeeds": ["采购入库单据（如有）", "商品成本来源标记", "供应商与商品的理论对应关系"]}, {"id": "inventory-analysis", "heading": "七、库存分析", "instruction": "1. **结构与资金**：按品类统计库存数量、成本价资金占用及销售价货值，分析资金在不同品类间的分布合理性（如高值低效品类）。2. **预警检查**：对比当前库存与安全库存线，指出预警失效的情况（如全线超储导致预警值为0），强调安全库存设定与实际销售节奏的脱节。3. **进销存动态**：列出本期入库、出库及净变动数据，区分正常销售出库与退货回补，识别真正的采购行为。4. **动销效率**：计算各商品的动销率（销量/(销量+库存)）和库销比，找出周转最慢的商品，评估库存变现能力。", "format": "table", "formats": ["table", "prose"], "intent": "分析库存结构、资金占用效率及预警机制的有效性，揭示库存积压风险。", "analysis": ["计算库存资金占用及货值结构", "评估库存水平与安全线的偏离度", "追踪库存变动来源（采购vs销售vs退货）", "计算动销率与库销比以衡量周转效率"], "dataNeeds": ["实时库存数量与金额", "安全库存设定值", "本期出入库流水明细", "本期销售数量"], "dataSources": [{"dataNeed": "实时库存数量与金额", "kind": "derived", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "stock_qty", "columnType": "int(11)", "columnComment": "库存数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "cost_price", "columnType": "decimal(12,2)", "columnComment": "成本价"}], "relationIds": [], "derivation": "库存金额 = stock_qty * cost_price。", "conditions": ["取当前最新快照数据"], "note": "基于商品表中的静态库存字段计算价值。"}, {"dataNeed": "安全库存设定值", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 110, "tableName": "virtual_erp.products", "columnName": "safety_stock", "columnType": "int(11)", "columnComment": "安全库存"}], "relationIds": [], "derivation": "", "conditions": [], "note": "直接读取商品表的安全库存字段。"}, {"dataNeed": "本期出入库流水明细", "kind": "direct", "sources": [{"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "product_id", "columnType": "int(11)", "columnComment": "商品id"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "change_qty", "columnType": "int(11)", "columnComment": "变动数量"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "change_type", "columnType": "varchar(16)", "columnComment": "变动类型"}, {"projectGroupId": 38, "projectGroupName": "erp测试商品", "databaseName": "virtual_erp", "tableId": 113, "tableName": "virtual_erp.stock_logs", "columnName": "created_at", "columnType": "datetime", "columnComment": "创建时间"}], "relationIds": [{"projectGroupId": 38, "relationId": 29}], "derivation": "", "conditions": ["按用户需求确定统计期间过滤 created_at"], "note": "直接读取库存流水表记录。"}], "dataInputs": [], "unmappedDataNeeds": ["本期销售数量"]}, {"id": "diagnosis", "heading": "八、经营诊断", "instruction": "1. **核心发现**：以表格形式列出5-7项关键问题，每项必须附带具体的数据依据（如“营收集中度高：2款商品贡献90%销售额”）。2. **轻重缓急**：将发现的问题分为三类进行阐述：\\n   - **最直接的资金/收入影响**：如滞销品资金占用、未确认收入的停滞订单。\\n   - **结构性/基础性缺陷**：如供应商断链、预警失效，虽暂无直接金额损失但阻碍未来增长。\\n   - **阶段性特征**：如小样本下的客户/商品集中，属于正常现象但需持续监控。", "format": "table", "formats": ["table", "prose", "list"], "intent": "综合前述分析，提炼核心发现并按轻重缓急排序，为决策提供依据。", "analysis": ["汇总各章节异常点", "按影响金额和数据确定性对问题进行优先级排序", "区分紧急处置事项与长期优化事项"], "dataNeeds": ["各章节得出的关键负面指标或异常现象", "相关问题的量化影响（金额、比例）"], "dataSources": [], "dataInputs": [{"dataNeed": "各章节得出的关键负面指标或异常现象", "kind": "section_result", "sectionIds": ["sales-order-analysis", "product-analysis", "customer-analysis", "supplier-analysis", "inventory-analysis"], "reason": "诊断章节依赖前序所有分析章节中识别出的具体问题点（如高集中度、滞销、预警失效等）。"}], "unmappedDataNeeds": ["相关问题的量化影响（金额、比例）"]}, {"id": "conclusion", "heading": "九、结论", "instruction": "用一段话总结本期核心数据（订单、销售额、毛利等）。随后分别从商品、客户、供应商、库存四个维度简述现状与问题。最后指出当前业务闭环的完整性（账实相符与否），并明确下一步最紧迫的两个着力点（通常对应最大的资金沉淀或收入阻塞点）。", "format": "prose", "formats": ["prose"], "intent": "回顾整体经营状况，重申核心矛盾，提出最终的行动导向。", "analysis": ["整合全文观点", "提炼最终的管理建议方向", "确认数据一致性结论"], "dataNeeds": ["全文核心结论摘要", "优先解决事项清单"], "dataSources": [], "dataInputs": [{"dataNeed": "全文核心结论摘要", "kind": "section_result", "sectionIds": ["diagnosis"], "reason": "结论章节是对经营诊断章节最终发现的总结与升华。"}], "unmappedDataNeeds": ["优先解决事项清单"]}], "rules": ["所有金额、比率、数量均需保留两位小数（除非特别说明），确保数据精度一致。", "分析时必须遵循“数据呈现 -> 现象描述 -> 原因推导 -> 管理含义”的逻辑链条，避免只罗列数字而无解读。", "对于无法从现有数据直接推导的因果关系（如供应商归属），应明确标注为“推测”或“无法验证”，不得作为既定事实陈述。", "表格中的合计行应与分项之和严格核对，确保账实相符。", "语气保持客观、中立，聚焦于业务事实与管理效率，避免情绪化表达。", "若某环节数据缺失或完全空转（如供应商无关联记录），应在该章节显著位置指出这是“管理盲区”而非简单的“数据不足”。", "保留模板明确的排名数量、筛选范围和表格列顺序；例如前三名不能自行改成前五名。本次用户明确调整时才按新要求执行。", "原模板没有图表且用户未要求时不主动新增图表。构成图只使用互斥的明细项，禁止把合计、小计、总计作为一个类别重复计算。", "库存缺口数量=max(安全库存-当前库存,0)，不能出现负数；模板要求库存风险清单时，仅列正缺口商品，不把正常库存混入风险清单。", "数据需求区分数据库字段、用户需确认的业务口径、前序章节结果及真正缺项；已有前文结果不要求用户重复提供。"], "presentation": {"version": 1, "outline": ["一、报告概要\\t1", "二、经营总览\\t1", "三、销售订单分析\\t1", "四、商品分析\\t1", "五、客户分析\\t1", "六、供应商分析\\t1", "七、库存分析\\t1", "八、经营诊断\\t1", "九、结论\\t1", "一、报告概要", "二、经营总览", "三、销售订单分析", "四、商品分析", "五、客户分析", "六、供应商分析", "七、库存分析", "八、经营诊断", "九、闵开发空置资产分析", "十、结论"], "roles": {"title": {"fontFamily": "微软雅黑", "fontSize": 11.0, "bold": false, "alignment": "center", "firstLineIndent": 0, "leftIndent": 0, "rightIndent": 0, "spaceBefore": 150.0, "spaceAfter": 18.0, "lineMultiple": 1.75}, "body": {"fontFamily": "宋体", "fontSize": 12.0, "bold": false, "alignment": "justify", "firstLineIndent": 24.0, "leftIndent": 0, "rightIndent": 0, "spaceBefore": 0, "spaceAfter": 8.0, "lineMultiple": 1.75}, "section": {"fontFamily": "宋体", "fontSize": 12.0, "bold": false, "alignment"